model CompanyEvent {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  status    WorkforceStuffStatus @default(ACTIVE)

  // Core Content
  title       String
  theme       String?
  description String?

  // Standardized CompanyX Fields
  eventDate DateTime? // Date field (standardized)
  startTime String? // Time field (standardized)
  endTime   String? // Time field (standardized)
  location  String? // Location field (standardized) - ADDED

  // Event-specific fields
  eventCategory EventCategory?

  registrationRequired String?
  registrationLink     String?

  audience      EventAudience?
  vibe          String?
  eventItems    String[]       @default([]) // Highlights, agenda items, key moments (replaces perks)
  participation String[]       @default([])

  foodProvided String?
  foodTypes    String?

  speakers String[] @default([])
  pocEmail String?
  pocPhone String?

  // Ingestion
  ingestRawText String?
  summary       String?

  // Standardized Relations
  companyId String? // Company ID (standardized)
  company   Company? @relation("CompanyEventCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid // Owner ID / Author ID (standardized)
  workMe    WorkMe   @relation("CompanyEventWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  // Relations
  // NOTE: EventItem is deprecated - products now link via CompanyWorkLink
  emailDigestItems               EmailDigestItem[]                  @relation("EmailDigestItemEvent")
  productSeniorLeaderEmails      ProductSeniorLeaderEmail[]        @relation("ProductSeniorLeaderEmailEvent")
  companyWork                    CompanyWork[]                      @relation
  myContributions                MyContribution[]
  digitalSigns                   ProductDigitalSignWorkforceStuff[] @relation
  ProductDigitalSignCompanyEvent ProductDigitalSignCompanyEvent[]

  @@index([companyId])
  @@index([workMeId])
  @@index([eventDate])
  @@index([status])
}

model CompanyLeaderEngagement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?

  // Standardized CompanyX Fields
  engagementDate DateTime? // Date field (standardized)
  startTime      String? // Time field (standardized)
  endTime        String? // Time field (standardized)
  location       String? // Location field (standardized)

  // Leadership engagement specific fields
  topicAreas         String[] @default([]) // Topics that will be covered (e.g., "State of the Org", "Q4 Results", "Strategic Priorities")
  potentialQuestions String[] @default([]) // Anticipated questions from the audience
  keyMessages        String[] @default([]) // Key messages the leader wants to convey
  talkingPoints      String? // Detailed talking points or script

  // Leader information
  leaderName  String? // Name of the principal speaker/leader
  leaderTitle String? // Title/role of the leader
  leaderId    String? // Optional FK to CompanyEmployee if they exist in the system

  // Audience
  audience             EventAudience?
  registrationRequired String?
  registrationLink     String?

  // Format details
  format       String? // "Town Hall", "All-Hands", "Leadership Briefing", etc.
  qAndAEnabled Boolean @default(false) // Whether Q&A is enabled

  // Contact
  pocEmail String?
  pocPhone String?

  // Ingestion
  ingestRawText String?
  summary       String?

  // Standardized Relations
  companyId String? // Company ID (standardized)
  company   Company? @relation("CompanyLeaderEngagementCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid // Owner ID / Author ID (standardized)
  workMe    WorkMe   @relation("CompanyLeaderEngagementWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  emailDigestItems                 EmailDigestItem[]                  @relation("EmailDigestItemLeaderEngagement")
  productSeniorLeaderEmails        ProductSeniorLeaderEmail[]        @relation("ProductSeniorLeaderEmailLeaderEngagement")
  companyWork                      CompanyWork[]                      @relation
  myContributions                  MyContribution[]
  ProductDigitalSignWorkforceStuff ProductDigitalSignWorkforceStuff[]

  @@index([companyId])
  @@index([workMeId])
  @@index([engagementDate])
  @@index([leaderId])
}

// ============================================
// EventItem Model - DROPPED
// ============================================
// ⚠️ REMOVED: EventItem table has been dropped.
// Products now link to CompanyEvent via CompanyWorkLink (foreign key capability).
//
// Migration path:
// - Old EventItem data should be migrated to WorkCommsProduct with CompanyWorkLink
// - Event-specific items should be stored as products, not EventItems
//

model CompanyCommunity {
  id          String               @id @default(cuid())
  createdAt   DateTime             @default(now())
  status      WorkforceStuffStatus @default(ACTIVE)
  title       String
  description String?
  partnerOrg  String?

  // Standardized CompanyX Fields
  date      DateTime? // Date field (standardized)
  startTime String? // Time field (standardized) - ADDED
  endTime   String? // Time field (standardized) - ADDED
  location  String? // Location field (standardized)

  signUpLink   String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  ingestRawText String?
  summary       String?

  // Standardized Relations
  companyId String?
  company   Company? @relation("CompanyCommunityCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid
  workMe    WorkMe   @relation("CompanyCommunityWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  emailDigestItems                 EmailDigestItem[]                  @relation("EmailDigestItemCommunity")
  productSeniorLeaderEmails        ProductSeniorLeaderEmail[]        @relation("ProductSeniorLeaderEmailCommunity")
  companyWork                      CompanyWork[]                      @relation
  myContributions                  MyContribution[]
  ProductDigitalSignWorkforceStuff ProductDigitalSignWorkforceStuff[]

  @@index([companyId])
  @@index([workMeId])
  @@index([status])
}

model CompanyBenefits {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  status    WorkforceStuffStatus @default(ACTIVE)

  title                  String
  description            String?
  employeeBenefitSummary String?

  // Standardized CompanyX Fields
  windowStart DateTime? // Date field (standardized - window start)
  windowEnd   DateTime? // Date field (standardized - window end)
  location    String? // Location field (standardized) - ADDED

  deadlines Json?

  actionLink String?
  resources  Json?

  pocList           Json?
  extraInstructions Json?

  summary String?

  ingestRawText String?

  // Standardized Relations
  companyId String?
  company   Company? @relation("CompanyBenefitsCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid
  workMe    WorkMe   @relation("CompanyBenefitsWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)


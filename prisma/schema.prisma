generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER MODEL (Pure Identity + Simple Public Profile)
// ============================================
// WorkMe = Core Identity (Personhood)
// Contains ONLY stable identity fields + simple public-facing profile fields
model WorkMe {
  id         String   @id @default(uuid()) @db.Uuid
  firebaseId String?  @unique
  email      String   @unique
  createdAt  DateTime @default(now())

  // Simple public-facing profile fields (NOT work fields)
  headline    String?
  handle      String? @unique
  title       String?
  linkedinUrl String?

  // WorkMeCompany - silent background tag for tenant partitioning
  workMeCompanyId String?
  workMeCompany   WorkMeCompany? @relation(fields: [workMeCompanyId], references: [id])

  // Organizational context (MVP1 - string labels only)
  companyId   String? // Authoritative organizational FK
  companyUnit String? // Optional string label ("SEA 05", "NAVSEA HQ")
  division    String? // Optional string label

  // Bolt-on modules (all via foreign keys)
  workProfile        WorkProfile?
  workSkills         WorkSkills?
  workEntries        WorkEntry[]
  workGoals          WorkGoal[]
  ecosystemCompanies WorkMeEcosystemCompany[]
  ecosystemContacts  MyEcosystemContact[]

  // WorkWorld Architecture Relations
  workplaces Workplace[]

  // Minimal reverse relations (required by Prisma, but NOT to be queried)
  // WorkMe is pure identity - work outputs reference WorkMe via createdByWorkMeId
  // These relations exist only for Prisma schema validation
  originatedCommsOutputs       CommsOutput[]                      @relation("CommsOutputOriginator")
  originatedObjectives         Objective[]                        @relation("ObjectiveOriginator")
  originatedAchievements       Achievement[]                      @relation("AchievementOriginator")
  createdEmailDigestProducts   WorkForceEnduringProdEmailDigest[] @relation("EmailDigestProductCreator")
  createdCompanyCampaigns      CompanyCampaign[]                  @relation("CompanyCampaignCreator")
  createdCompanyImpactEvents   CompanyImpactEvent[]               @relation("CompanyImpactEventCreator")
  createdCompanyTrainings      CompanyTraining[]                  @relation("CompanyTrainingCreator")
  createdCompanyEvents         CompanyEvent[]                     @relation("CompanyEventCreator")
  createdCompanyCommunities    CompanyCommunity[]                 @relation("CompanyCommunityCreator")
  createdCompanyCareers        CompanyCareer[]                    @relation("CompanyCareerCreator")
  createdCompanyBenefits       CompanyBenefits[]                  @relation("CompanyBenefitsCreator")
  createdCompanyEmployeeCauses CompanyEmployeeCause[]             @relation("CompanyEmployeeCauseCreator")
  createdDigitalSignProducts   ProductDigitalSign[]               @relation("ProductDigitalSignCreator")
  createdEmployeeHighlights    CompanyEmployeeHighlight[]         @relation("CompanyEmployeeHighlightCreator")
  createdCompanyEmployees      CompanyEmployee[]                  @relation("CompanyEmployeeCreator")
  engageMessages               EngageMessage[]

  // Design Work Package Relations
  createdDesignWorkPackages  DesignWorkPackage[] @relation("DesignWorkPackageCreator")
  assignedDesignWorkPackages DesignWorkPackage[] @relation("DesignWorkPackageAssigned")

  // WorkOps Relations
  workOpsOutlook WorkOpsOutlook?

  // Company Products Relations
  companyProducts          CompanyProduct[]
  externalCompanyPressures ExternalCompanyPressure[]
  Company                  Company?                  @relation(fields: [companyId], references: [id])

  @@index([handle])
  @@index([companyId])
  @@index([companyUnit])
}

// ============================================
// WORK PROFILE MODEL (Professional Identity - "What I Do")
// ============================================
model WorkProfile {
  id       String @id @default(uuid())
  workMeId String @unique @db.Uuid

  jobRole               String?
  industry              String?
  salaryRange           String?
  responsibilitySummary String?
  seniority             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// ENUMS
// ============================================
enum EventAudience {
  ALL_WORKFORCE
  LEADERS
  WORKFORCE_AND_FAMILIES
  COMMUNITY
}

enum EventCategory {
  CELEBRATION
  HERITAGE
  COMMUNITY
  RECOGNITION
  APPRECIATION
  FAMILY
}

enum DigitalSignType {
  WORKFORCE
  COMPANY_NEWS
  WORKFORCE_ACHIEVEMENT
  COMPANY_EVENT
}

enum DesignWorkPackageStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  REVISION_REQUESTED
  COMPLETE
}

// ============================================
// WORKME COMPANY MODEL (Silent Background Tag)
// ============================================
// WorkMeCompany exists ONLY as a silent tag for tenant partitioning.
// It does NOT affect routing, hydration, API shape, permissions, or component logic.
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees WorkMe[]

  @@map("workme_company")
}

// ============================================
// COMPANY MODEL (Independent Entity)
// ============================================
model Company {
  id           String        @id @default(uuid())
  name         String        @unique
  industry     String?
  website      String?
  city         String?
  state        String?
  description  String?
  headcount    Int?
  companyType  CompanyType?
  revenueRange RevenueRange?
  createdAt    DateTime      @default(now())

  // Identity (Apollo Enrichment)
  missionStatement    String?
  vision              String?
  values              String?
  brandTagline        String?
  brandLogoUrl        String?
  brandColorPrimary   String?
  brandColorSecondary String?

  // Leadership (Apollo Enrichment)
  ceoName      String?
  ceoTitle     String?
  deputyName   String?
  deputyTitle  String?
  chiefOfStaff String?

  // Organization (Apollo Enrichment)
  directorates String[] @default([])

  // Social / Public (Apollo Enrichment)
  linkedinUrl String?
  twitterUrl  String?
  facebookUrl String?
  phone       String?

  // Address (Apollo Enrichment)
  country String?

  // Relations
  members    WorkMe[]
  workplaces Workplace[]
  employees  CompanyEmployee[]
  highlights CompanyEmployeeHighlight[]

  @@index([name])
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// WORK ENTRY MODEL (Work History)
// ============================================
model WorkEntry {
  id          String    @id @default(uuid())
  workMeId    String    @db.Uuid
  companyName String?
  title       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([startDate])
  @@index([endDate])
}

// ============================================
// WORK SKILLS MODEL
// ============================================
model WorkSkills {
  id             String  @id @default(uuid())
  workMeId       String  @unique @db.Uuid
  skillsRaw      String?
  strengthsRaw   String?
  specialties    String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// WORKPLACE MODEL
// ============================================
model Workplace {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe  WorkMe  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workMeId, companyId])
  @@index([workMeId])
  @@index([companyId])
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("CommsOutputOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Objective {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("ObjectiveOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title       String
  description String?
  howMeasured String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Achievement {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("AchievementOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title    String
  category AchievementCategory

  audienceName String?
  audienceSize Int?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  commsOutputId String?
  commsOutput   CommsOutput? @relation(fields: [commsOutputId], references: [id], onDelete: SetNull)

  whatYouDid String
  frequency  String?
  volume     Int?

  processSteps Json?
  impact       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyUnit])
  @@index([originatorId])
  @@index([category])
}

// ============================================
// COMPANY MODELS (CompanyX)
// ============================================

model CompanyCampaign {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  windowStart  DateTime?
  windowEnd    DateTime?
  ctaLink      String?
  sponsor      String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyCampaignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyImpactEvent {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  title              String
  description        String?
  effectiveDate      DateTime?
  impactedPopulation String?
  urgency            String?
  pocFirstName       String?
  pocLastName        String?
  pocEmail           String?
  pocPhone           String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyImpactEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyTraining {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title            String?
  topic            String?
  description      String?
  mandatory        Boolean @default(false)
  sponsoringOffice String?

  trainingDate DateTime?
  startTime    String?
  endTime      String?

  location String?
  format   String?
  link     String?

  pocFirstName   String?
  pocLastName    String?
  pocEmail       String?
  pocPhone       String?
  pocRankOrTitle String?

  ingestRawText   String?
  ingestType      String?
  ingestStatus    String?   @default("pending")
  ingestCreatedAt DateTime? @default(now())

  summary String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyTrainingCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  theme       String?
  description String?

  eventDate DateTime?
  startTime String?
  endTime   String?

  eventCategory EventCategory?

  registrationRequired String?
  registrationLink     String?

  audience      EventAudience?
  vibe          String?
  perks         String[]       @default([])
  participation String[]       @default([])

  foodProvided String?
  foodTypes    String?

  speakers String[] @default([])
  pocEmail String?
  pocPhone String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  eventItems EventItem[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model EventItem {
  id      String       @id @default(cuid())
  eventId String
  event   CompanyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model CompanyCommunity {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  partnerOrg   String?
  date         DateTime?
  location     String?
  signUpLink   String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyCommunityCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyBenefits {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title                  String
  description            String?
  employeeBenefitSummary String?

  windowStart DateTime?
  windowEnd   DateTime?

  deadlines Json?

  actionLink String?
  resources  Json?

  pocList           Json?
  extraInstructions Json?

  summary String?

  ingestRawText String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyBenefitsCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

enum CareerLevel {
  NAVSEA
  NAVY
  DOD
}

enum CareerType {
  Leadership
  Fellowship
  Other
}

model CompanyCareer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title       String
  description String?

  level CareerLevel?
  type  CareerType?

  eligibility Json?

  application Json?

  extras Json?

  ingestRawText String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyCareerCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyEmployeeCause {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title         String
  description   String?
  impactSummary String?

  partnerOrg           String?
  sponsoringDepartment String?

  windowStart DateTime?
  windowEnd   DateTime?
  deadlines   Json?

  locations String[] @default([])
  link      String?

  pocList           Json?
  extraInstructions Json?

  summary String?

  ingestRawText String?

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("CompanyEmployeeCauseCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

// ====================================================
// COMPANY EMPLOYEE (Employee-First Architecture)
// ====================================================
model CompanyEmployee {
  id       String  @id @default(cuid())
  fullName String
  title    String?
  email    String?
  phone    String?
  photoUrl String?

  // Organizational context (employee-first architecture)
  companyId       String // Authoritative organizational FK (required)
  workMeCompanyId String // Silent background tag for tenant partitioning
  companyUnit     String? // Optional string label ("SEA 05", "NAVSEA HQ")
  division        String? // Optional string label (ignored by app logic)

  // Audit trail
  createdByWorkMeId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  highlights CompanyEmployeeHighlight[]
  company    Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  WorkMe                         @relation("CompanyEmployeeCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workMeCompanyId])
  @@index([companyUnit])
  @@index([fullName])
  @@index([email])
}

// ====================================================
// COMPANY EMPLOYEE HIGHLIGHT
// ====================================================
enum HighlightClassification {
  EXCELLENCE
  LEADERSHIP
  INNOVATION
  SERVICE
  IMPACT
}

model CompanyEmployeeHighlight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citationText   String
  achievement    String?
  narrative      String?
  classification HighlightClassification?

  awardName      String?
  categoryOfAward String? // e.g., "NAVSEA Excellence Awards - Technical Innovation Category"
  awardingAgency String?
  awardYear      Int?

  supervisorQuote String?

  companyUnitLabel String?
  companyId        String? // Direct company reference for cleaner hydration (always set by route, but nullable for flexibility)

  createdByWorkMeId String @db.Uuid
  createdBy         WorkMe @relation("CompanyEmployeeHighlightCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  company           Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId      String? // Direct employee reference (one employee per highlight, always set on create but nullable for flexibility)
  employee        CompanyEmployee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  engageMessages EngageMessage[]

  @@index([createdByWorkMeId])
  @@index([companyUnitLabel])
  @@index([companyId])
  @@index([employeeId])
}

// ============================================
// WORKFORCE ENDURING PRODUCTS
// ============================================

model WorkForceEnduringProdEmailDigest {
  id                String   @id @default(uuid())
  title             String
  description       String?
  companyUnit       String
  createdByWorkMeId String   @db.Uuid
  createdAt         DateTime @default(now())

  createdBy WorkMe               @relation("EmailDigestProductCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  editions  EmailDigestEdition[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([createdAt])
}

model EmailDigestEdition {
  id            String                           @id @default(uuid())
  emailDigestId String
  product       WorkForceEnduringProdEmailDigest @relation(fields: [emailDigestId], references: [id], onDelete: Cascade)

  contentJson  Json
  generatedAt  DateTime @default(now())
  originatorId String
  companyUnit  String

  @@index([emailDigestId])
  @@index([companyUnit])
  @@index([generatedAt])
}

// ============================================
// DIGITAL SIGNAGE PRODUCT MODELS
// ============================================

model ProductDigitalSign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signType DigitalSignType

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("ProductDigitalSignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  workforce            ProductDigitalSignWorkforce?
  companyNews          ProductDigitalSignCompanyNews?
  workforceAchievement ProductDigitalSignWorkforceAchievement?
  companyEvent         ProductDigitalSignCompanyEvent?

  // Asset attachments (Blob-backed system)
  assetAttachments DigitalSignAsset[]

  // Design work packages linked to this digital sign
  designPackages DesignWorkPackage[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([signType])
}

model ProductDigitalSignWorkforce {
  id        String @id @default(cuid())
  signageId String @unique

  title      String
  summary    String?
  bullets    String[] @default([])
  icon       String?
  background String?
  footerNote String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

model ProductDigitalSignCompanyNews {
  id        String @id @default(cuid())
  signageId String @unique

  headline    String
  subheadline String?
  body        String?
  link        String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

model ProductDigitalSignWorkforceAchievement {
  id        String @id @default(cuid())
  signageId String @unique

  personName  String
  unit        String?
  achievement String
  details     String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

model ProductDigitalSignCompanyEvent {
  id        String @id @default(cuid())
  signageId String @unique

  eventName        String
  eventDate        DateTime?
  startTime        String?
  endTime          String?
  location         String?
  description      String?
  perks            String[]  @default([])
  registrationLink String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

// ============================================
// HOLIDAY BUILDER SYSTEM MODELS
// ============================================
model Holiday {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ============================================
// ASSET SYSTEM (Blob-backed)
// ============================================
model Asset {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  url         String
  filename    String?
  size        Int?
  contentType String?
  type        String? // "image", "ppt", "pdf" etc.
  tags        String[] @default([])

  // metadata / future fields
  title       String?
  description String?

  // Relations
  digitalSignAttachments DigitalSignAsset[]
  workPackageAttachments DesignWorkPackageAsset[]
}

model DigitalSignAsset {
  id        String @id @default(cuid())
  assetId   String
  signageId String

  asset   Asset              @relation(fields: [assetId], references: [id])
  signage ProductDigitalSign @relation(fields: [signageId], references: [id])

  @@unique([assetId, signageId])
}

// ============================================
// DESIGN WORK PACKAGE MODEL (MVP1 Creative Workflow)
// ============================================
model DesignWorkPackage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByWorkMeId  String                  @db.Uuid
  assignedToWorkMeId String?                 @db.Uuid
  status             DesignWorkPackageStatus @default(PENDING)

  // Tie this work package to the originating digital sign product (optional)
  signageId String?
  signage   ProductDigitalSign? @relation(fields: [signageId], references: [id], onDelete: SetNull)

  title       String?
  description String?

  // Asset attachments (Blob-backed system)
  assetAttachments DesignWorkPackageAsset[]

  // Relations
  createdBy  WorkMe  @relation("DesignWorkPackageCreator", fields: [createdByWorkMeId], references: [id])
  assignedTo WorkMe? @relation("DesignWorkPackageAssigned", fields: [assignedToWorkMeId], references: [id])

  @@index([createdAt])
  @@index([createdByWorkMeId])
  @@index([assignedToWorkMeId])
  @@index([status])
  @@index([signageId])
}

model DesignWorkPackageAsset {
  id        String @id @default(cuid())
  assetId   String
  packageId String

  asset       Asset             @relation(fields: [assetId], references: [id])
  workPackage DesignWorkPackage @relation(fields: [packageId], references: [id])

  @@unique([assetId, packageId])
}

// ============================================
// WORKOPS MODELS
// ============================================

enum WorkOpsItemType {
  task
  capture
  meeting
  signal
  fire
  boss_request
  tech_work
  admin
  workforce_comms
  external_pressure
  personal
}

enum WorkOpsUrgency {
  low
  medium
  high
  critical
}

enum WorkOpsStatus {
  open
  in_progress
  blocked
  done
}

enum WorkOpsSource {
  manual
  ai
  boss
  system
}

model WorkOpsOutlook {
  id        String   @id @default(cuid())
  workMeId  String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe           WorkMe                   @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  items            WorkOpsItem[]
  dailyAssignments WorkOpsDailyAssignment[]

  @@index([workMeId])
}

model WorkOpsItem {
  id        String   @id @default(cuid())
  outlookId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title String
  body  String?

  itemType WorkOpsItemType
  urgency  WorkOpsUrgency?
  status   WorkOpsStatus   @default(open)
  source   WorkOpsSource?

  priority   Int?
  dueDate    DateTime?
  assignedBy String?

  outlook          WorkOpsOutlook           @relation(fields: [outlookId], references: [id], onDelete: Cascade)
  dailyAssignments WorkOpsDailyAssignment[]

  @@index([outlookId])
  @@index([status])
  @@index([itemType])
}

model WorkOpsDailyAssignment {
  id        String   @id @default(cuid())
  outlookId String
  itemId    String
  day       DateTime
  dayIndex  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlook WorkOpsOutlook @relation(fields: [outlookId], references: [id], onDelete: Cascade)
  item    WorkOpsItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, day])
  @@index([outlookId])
  @@index([itemId])
  @@index([day])
}

// ============================================
// WORK GOAL MODEL
// ============================================
model WorkGoal {
  id         String    @id @default(uuid())
  workMeId   String    @db.Uuid
  goal       String
  targetDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([targetDate])
}

// ============================================
// DEFENSE ECOSYSTEM INTELLIGENCE MODELS
// ============================================

model Platform {
  id           String   @id @default(cuid())
  name         String
  platformType String
  category     String
  isNextGen    Boolean  @default(false)
  status       String?
  description  String?
  latestSignal String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  capabilities       PlatformCapability[]
  communications     PlatformCommNode[]
  contractors        PlatformContract[]
  signals            PlatformSignal[]
  ecosystemCompanies EcosystemDefenseCompany[] @relation("EcosystemCompanyPlatforms")

  @@index([platformType])
  @@index([category])
}

model PlatformCapability {
  id         String   @id @default(cuid())
  platformId String
  capability String
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([capability])
}

model PlatformCommNode {
  id         String   @id @default(cuid())
  platformId String
  nodeType   String
  nodeName   String?
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([nodeType])
}

model EcosystemDefenseCompany {
  id          String  @id @default(cuid())
  name        String
  description String?
  website     String?
  hqCity      String?
  hqState     String?
  hqCountry   String?

  role String?

  specialties    String[] @default([])
  marketTier     String?
  influenceScore Int?

  platforms       Platform[]               @relation("EcosystemCompanyPlatforms")
  contracts       PlatformContract[]
  workMeFollowers WorkMeEcosystemCompany[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([role])
}

model PlatformContract {
  id            String   @id @default(cuid())
  platformId    String
  companyId     String
  prime         Boolean  @default(false)
  onContract    Boolean  @default(false)
  contractNotes String?
  createdAt     DateTime @default(now())

  platform Platform                @relation(fields: [platformId], references: [id], onDelete: Cascade)
  company  EcosystemDefenseCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([companyId])
}

model PlatformSignal {
  id         String   @id @default(cuid())
  platformId String
  sourceUrl  String?
  sourceType String?
  signalType String
  headline   String?
  rawSnippet String?
  aiSummary  String?
  confidence Float?
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([signalType])
  @@index([createdAt])
}

model WorkMeEcosystemCompany {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  companyId String
  createdAt DateTime @default(now())

  workMe  WorkMe                  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company EcosystemDefenseCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workMeId, companyId])
  @@index([workMeId])
  @@index([companyId])
}

model EcosystemPerson {
  id        String  @id @default(cuid())
  fullName  String
  xHandle   String? @unique
  xUserId   String? @unique
  title     String?
  seniority String?
  domain    String?
  beat      String?

  companyName String?
  companyId   String?
  yearsAt     Int?
  influence   Int?

  profileImage String?
  bio          String?
  followers    Int?

  topics              String[] @default([])
  affinityIndustry    String?
  affinityToMyOrg     String?
  latestSignalSummary String?

  updatedSummary String?
  lastHydratedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  workMeContacts MyEcosystemContact[]
  company        EcosystemCompany?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([xHandle])
  @@index([xUserId])
  @@index([domain])
  @@index([companyId])
}

model EcosystemCompany {
  id      String  @id @default(cuid())
  name    String
  domain  String? @unique
  type    String?
  summary String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  people EcosystemPerson[]

  @@index([name])
  @@index([type])
}

model MyEcosystemContact {
  id       String @id @default(cuid())
  workMeId String @db.Uuid
  personId String

  notes String?
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe          @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  person EcosystemPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([workMeId, personId])
  @@index([workMeId])
  @@index([personId])
}

// ============================================
// COMPANY PRODUCTS MODELS
// ============================================

model CompanyProduct {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  category    String?
  description String?

  missionRole      String?
  keyCapabilities  String[] @default([])
  limitations      String[] @default([])
  publicSources    Json?
  productionStatus String?

  leadershipFraming String?
  talkingPoints     Json?

  highlights ProductHighlight[]
  pressures  ProductPressure[]
  updates    ProductUpdate[]

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([category])
}

model ProductPressure {
  id        String   @id @default(cuid())
  productId String
  source    String
  summary   String
  riskLevel String?
  createdAt DateTime @default(now())

  product CompanyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductHighlight {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String?
  createdAt   DateTime @default(now())

  product CompanyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductUpdate {
  id         String   @id @default(cuid())
  productId  String
  updateText String
  createdAt  DateTime @default(now())

  product CompanyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================
// EXTERNAL COMPANY PRESSURE MODEL
// ============================================
model ExternalCompanyPressure {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  source    String
  category  String?
  summary   String
  impact    String?
  createdAt DateTime @default(now())

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([category])
}

// ============================================
// COMPANY PLATFORM PRODUCT MODELS
// ============================================
model CompanyPlatformProduct {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String // "Virginia-class"
  category    String? // "Submarine", "Surface Ship"
  programCode String? // "SSN", "SSBN", etc.
  description String?
  whySpecial  String?

  nextDeliveryExpected DateTime?
  lastDeliveryDate     DateTime?

  units CompanyPlatformUnit[]

  @@index([name])
  @@index([category])
  @@index([programCode])
}

model CompanyPlatformUnit {
  id                String @id @default(uuid())
  platformProductId String

  hullNumber      String // "SSN 804"
  name            String?
  shipyard        String?
  lifecycleStatus String?
  description     String?

  nextMilestoneExpected DateTime?

  // reverse relation
  milestones CompanyMilestone[]

  platformProduct CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  @@index([platformProductId])
  @@index([hullNumber])
}

// ============================================
// COMPANY MILESTONE MODEL
// ============================================
model CompanyMilestone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  date        DateTime?

  sourceUrl String?

  // Milestone type support: PRODUCT, WORKFORCE, INNOVATION
  milestoneType String? // "PRODUCT", "WORKFORCE", "INNOVATION"

  // Optional link to platform unit (for PRODUCT milestones)
  platformUnitId String?
  platformUnit   CompanyPlatformUnit? @relation(fields: [platformUnitId], references: [id], onDelete: SetNull)

  companyUnit       String?
  createdByWorkMeId String? @db.Uuid

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([milestoneType])
  @@index([platformUnitId])
  @@index([date])
}

// ============================================
// WORKENGAGE MODELS
// ============================================

model EngageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())

  messages EngageMessage[]

  @@index([name])
}

model EngageMessage {
  id          String   @id @default(cuid())
  ownerId     String   @db.Uuid
  templateId  String?
  highlightId String?
  message     String
  createdAt   DateTime @default(now())

  owner     WorkMe                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template  EngageTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  highlight CompanyEmployeeHighlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([templateId])
  @@index([highlightId])
  @@index([createdAt])
}

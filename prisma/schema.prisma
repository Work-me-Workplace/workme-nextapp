// ============================================
// WORKFORCE ENDURING PRODUCTS
// ============================================

enum EmailDigestEditionStatus {
  DRAFT // Being curated, items being selected
  GENERATING // OpenAI generation in progress
  GENERATED // Content generated, ready for review
  SENT // Finalized and sent
}


model WorkForceEnduringProdEmailDigest {
  id                String   @id @default(uuid())
  title             String
  description       String?
  companyId         String
  createdByWorkMeId String   @db.Uuid
  createdAt         DateTime @default(now())

  createdBy WorkMe               @relation("EmailDigestProductCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  editions  EmailDigestEdition[]

  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([createdAt])
}

model EmailDigestEdition {
  id            String                           @id @default(uuid())
  emailDigestId String
  product       WorkForceEnduringProdEmailDigest @relation(fields: [emailDigestId], references: [id], onDelete: Cascade)

  status       EmailDigestEditionStatus @default(DRAFT)
  contentJson  Json? // Generated content (null until GENERATED)
  generatedAt  DateTime                 @default(now())
  originatorId String
  companyId    String

  editionItems EmailDigestEditionItem[] // Many-to-many with items via junction table

  @@index([emailDigestId])
  @@index([companyId])
  @@index([status])
  @@index([generatedAt])
}

model EmailDigestItem {
  id String @id @default(cuid())

  // The morphed, formatted content (what matters!)
  formattedContent Json // { title, body, cta, ctaUrl, imageUrl, ... }

  // Link to workforcestuff (one of these will be set, or null if manual entry)
  companyEventId            String?
  companyCampaignId         String?
  companyTrainingId         String?
  companyBenefitsId         String?
  companyImpactEventId      String?
  companyCommunityId        String?
  companyCareerId           String?
  companyEmployeeCauseId    String?
  companyLeaderEngagementId String?

  // Relations to workforcestuff (nullable)
  companyEvent            CompanyEvent?            @relation("EmailDigestItemEvent", fields: [companyEventId], references: [id], onDelete: SetNull)
  companyCampaign         CompanyCampaign?         @relation("EmailDigestItemCampaign", fields: [companyCampaignId], references: [id], onDelete: SetNull)
  companyTraining         CompanyTraining?         @relation("EmailDigestItemTraining", fields: [companyTrainingId], references: [id], onDelete: SetNull)
  companyBenefits         CompanyBenefits?         @relation("EmailDigestItemBenefits", fields: [companyBenefitsId], references: [id], onDelete: SetNull)
  companyImpactEvent      CompanyImpactEvent?      @relation("EmailDigestItemImpactEvent", fields: [companyImpactEventId], references: [id], onDelete: SetNull)
  companyCommunity        CompanyCommunity?        @relation("EmailDigestItemCommunity", fields: [companyCommunityId], references: [id], onDelete: SetNull)
  companyCareer           CompanyCareer?           @relation("EmailDigestItemCareer", fields: [companyCareerId], references: [id], onDelete: SetNull)
  companyEmployeeCause    CompanyEmployeeCause?    @relation("EmailDigestItemEmployeeCause", fields: [companyEmployeeCauseId], references: [id], onDelete: SetNull)
  companyLeaderEngagement CompanyLeaderEngagement? @relation("EmailDigestItemLeaderEngagement", fields: [companyLeaderEngagementId], references: [id], onDelete: SetNull)

  // Status lifecycle
  status String @default("DRAFT") // DRAFT | READY | ARCHIVED

  // Ownership
  companyId         String
  createdByWorkMeId String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Many-to-many with editions via junction table
  editionItems EmailDigestEditionItem[]

  @@index([companyId])
  @@index([status])
  @@index([createdByWorkMeId])
  @@index([companyEventId])
  @@index([companyCampaignId])
  @@index([companyTrainingId])
  @@index([companyBenefitsId])
  @@index([companyImpactEventId])
  @@index([companyCommunityId])
  @@index([companyCareerId])
  @@index([companyEmployeeCauseId])
  @@index([companyLeaderEngagementId])
}

// Junction table for many-to-many relationship between editions and items
model EmailDigestEditionItem {
  id        String @id @default(cuid())
  editionId String
  itemId    String
  order     Int // Display order in this edition

  edition EmailDigestEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  item    EmailDigestItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([editionId, itemId]) // Can't add same item twice to one edition
  @@index([editionId])
  @@index([itemId])
  @@index([order])
}


// ============================================
// DIGITAL SIGNAGE PRODUCT MODELS
// ============================================

model ProductDigitalSign {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When archived, null if active

  signType DigitalSignType

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("ProductDigitalSignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  workforce            ProductDigitalSignWorkforce?
  companyNews          ProductDigitalSignCompanyNews?
  workforceAchievement ProductDigitalSignWorkforceAchievement?
  workforceStuff       ProductDigitalSignWorkforceStuff? // Unified model for all CompanyX types
  companyEvent         ProductDigitalSignCompanyEvent? // Legacy - use workforceStuff instead

  // Asset attachments (Blob-backed system)
  assetAttachments DigitalSignAsset[]

  // Design work packages linked to this digital sign
  designPackages DesignWorkPackage[]

  // Gamma deck generation (presentation/PPT from signage content)
  gammaBlob         String?
  gammaDeckUrl      String?
  gammaError        String?
  gammaPptxUrl      String?
  gammaStatus       String?
  gammaGenerationId String?

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([signType])
  @@index([archivedAt])
}

model ProductDigitalSignWorkforce {

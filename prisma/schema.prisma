// ============================================
// DESIGN WORK PACKAGE MODEL (Workflow-Ops Architecture)
// ============================================
// DesignWorkPackage represents assigned human work on a digital product.
// A work package is "assigned" to a digital product by setting digitalSignId.
// Products are outcomes; work packages are effort.
// Assets attach to the product (ProductDigitalSign), not the work package.
model DesignWorkPackage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByWorkMeId  String                  @db.Uuid
  assignedToWorkMeId String?                 @db.Uuid
  status             DesignWorkPackageStatus @default(PENDING)

  // Work assignment: link to the digital product this work is for
  // A product may have zero, one, or many work packages over time
  digitalSignId String?
  signage       ProductDigitalSign? @relation(fields: [digitalSignId], references: [id], onDelete: SetNull)

  title       String?
  description String?

  // Relations
  createdBy  WorkMe  @relation("DesignWorkPackageCreator", fields: [createdByWorkMeId], references: [id])
  assignedTo WorkMe? @relation("DesignWorkPackageAssigned", fields: [assignedToWorkMeId], references: [id])

  @@index([createdAt])
  @@index([createdByWorkMeId])
  @@index([assignedToWorkMeId])
  @@index([status])
  @@index([digitalSignId])
}


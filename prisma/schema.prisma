  myTeamDeputies     MyTeamDeputyProfile[]
  myTeamPeers        MyTeamPeerProfile[]
  myTeamSubordinates MyTeamSubordinateProfile[]
  company            Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          WorkMe                            @relation("CompanyEmployeeCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workMeCompanyId])
  @@index([companyUnit])
  @@index([fullName])
  @@index([email])
}


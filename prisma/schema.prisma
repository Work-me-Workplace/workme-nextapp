model WorkContextEmployeeCause {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  title                String
  description          String?
  partnerOrg           String?
  windowStart          DateTime?
  windowEnd            DateTime?
  location             String?
  neededItems          String[]
  collectionPoints     String[]
  signUpLink           String?
  pocFirstName         String?
  pocLastName          String?
  pocEmail             String?
  pocPhone             String?
  sponsoringDepartment String?

  companyId    String?
  company      Company? @relation("WorkContextEmployeeCauseCompany", fields: [companyId], references: [id], onDelete: Cascade)
  originatorId    String?

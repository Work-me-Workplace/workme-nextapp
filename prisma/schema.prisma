generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER MODEL (Pure Identity + Simple Public Profile)
// ============================================
// WorkMe = Core Identity (Personhood)
// Contains ONLY stable identity fields + simple public-facing profile fields
model WorkMe {
  id         String   @id @default(uuid()) @db.Uuid
  firebaseId String?  @unique
  email      String   @unique
  createdAt  DateTime @default(now())

  // Simple public-facing profile fields (NOT work fields)
  headline    String?
  handle      String? @unique
  title       String?
  linkedinUrl String?

  // WorkMeCompany - silent background tag for tenant partitioning
  workMeCompanyId String?
  workMeCompany   WorkMeCompany? @relation(fields: [workMeCompanyId], references: [id])

  // Organizational context (MVP1 - string labels only)
  companyId   String? // Authoritative organizational FK
  companyUnit String? // Optional string label ("SEA 05", "NAVSEA HQ")
  division    String? // Optional string label

  // Bolt-on modules (all via foreign keys)
  workProfile        WorkProfile?
  workSkills         WorkSkills?
  workEntries        WorkEntry[]
  workGoals          WorkGoal[]
  ecosystemCompanies WorkMeEcosystemCompany[]
  ecosystemContacts  MyEcosystemContact[]

  // WorkWorld Architecture Relations
  workplaces Workplace[]

  // Minimal reverse relations (required by Prisma, but NOT to be queried)
  // WorkMe is pure identity - work outputs reference WorkMe via createdByWorkMeId
  // These relations exist only for Prisma schema validation
  originatedCommsOutputs       CommsOutput[]                      @relation("CommsOutputOriginator")
  originatedObjectives         Objective[]                        @relation("ObjectiveOriginator")
  originatedAchievements       Achievement[]                      @relation("AchievementOriginator")
  createdEmailDigestProducts   WorkForceEnduringProdEmailDigest[] @relation("EmailDigestProductCreator")
  createdCompanyCampaigns      CompanyCampaign[]                  @relation("CompanyCampaignCreator")
  createdCompanyImpactEvents   CompanyImpactEvent[]               @relation("CompanyImpactEventCreator")
  createdCompanyTrainings      CompanyTraining[]                  @relation("CompanyTrainingCreator")
  createdCompanyEvents         CompanyEvent[]                     @relation("CompanyEventCreator")
  createdCompanyCommunities    CompanyCommunity[]                 @relation("CompanyCommunityCreator")
  createdCompanyCareers        CompanyCareer[]                    @relation("CompanyCareerCreator")
  createdCompanyBenefits       CompanyBenefits[]                  @relation("CompanyBenefitsCreator")
  createdCompanyEmployeeCauses CompanyEmployeeCause[]             @relation("CompanyEmployeeCauseCreator")
  createdDigitalSignProducts   ProductDigitalSign[]               @relation("ProductDigitalSignCreator")
  createdEmployeeHighlights    CompanyEmployeeHighlight[]         @relation("CompanyEmployeeHighlightCreator")
  createdCompanyEmployees      CompanyEmployee[]                  @relation("CompanyEmployeeCreator")
  engageMessages               EngageMessage[]

  // Design Work Package Relations
  createdDesignWorkPackages  DesignWorkPackage[] @relation("DesignWorkPackageCreator")
  assignedDesignWorkPackages DesignWorkPackage[] @relation("DesignWorkPackageAssigned")

  // WorkOps Relations
  workOpsOutlook WorkOpsOutlook?

  // MyTeam Relations (Personal Intelligence)
  myTeamContainer MyTeamContainer?

  // Company Products Relations
  externalCompanyPressures ExternalCompanyPressure[]
  Company                  Company?                  @relation(fields: [companyId], references: [id])

  // Product Relations
  createdSeniorLeaderEmailProducts ProductSeniorLeaderEmail[] @relation("ProductSeniorLeaderEmailCreator")

  // News Artifact Relations
  createdCompanyNewsArtifacts CompanyNewsArtifact[] @relation("CompanyNewsArtifactCreator")

  // Memo & LinkedIn Relations
  memos         Memo[]         @relation("WorkMeMemos")
  linkedInPosts LinkedInPost[] @relation("WorkMeLinkedInPosts")

  @@index([handle])
  @@index([companyId])
  @@index([companyUnit])
}

// ============================================
// WORK PROFILE MODEL (Professional Identity - "What I Do")
// ============================================
model WorkProfile {
  id       String @id @default(uuid())
  workMeId String @unique @db.Uuid

  jobRole               String?
  industry              String?
  salaryRange           String?
  responsibilitySummary String?
  seniority             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// ENUMS
// ============================================
enum EventAudience {
  ALL_WORKFORCE
  LEADERS
  WORKFORCE_AND_FAMILIES
  COMMUNITY
}

enum EventCategory {
  CELEBRATION
  HERITAGE
  COMMUNITY
  RECOGNITION
  APPRECIATION
  FAMILY
}

enum DigitalSignType {
  WORKFORCE
  COMPANY_NEWS
  WORKFORCE_ACHIEVEMENT
  COMPANY_EVENT
}

enum DesignWorkPackageStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  REVISION_REQUESTED
  COMPLETE
}

enum PlatformMilestoneType {
  CONTRACT_AWARDED
  KEEL_LAYING
  HULL_COMPLETION
  LAUNCH
  SEA_TRIALS
  DELIVERY
  COMMISSIONING
}

enum SeniorLeaderRole {
  SES
  DIRECTOR
  DEPUTY_DIRECTOR
  EXECUTIVE_DIRECTOR
  CHIEF
  DEPUTY_CHIEF
  COMMANDER
  DEPUTY_COMMANDER
  OTHER
}

// ============================================
// WORKME COMPANY MODEL (Silent Background Tag)
// ============================================
// WorkMeCompany exists ONLY as a silent tag for tenant partitioning.
// It does NOT affect routing, hydration, API shape, permissions, or component logic.
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees WorkMe[]

  @@map("workme_company")
}

// ============================================
// COMPANY MODEL (Independent Entity)
// ============================================
model Company {
  id           String        @id @default(uuid())
  name         String        @unique
  industry     String?
  website      String?
  city         String?
  state        String?
  description  String?
  headcount    Int?
  companyType  CompanyType?
  revenueRange RevenueRange?
  createdAt    DateTime      @default(now())

  // Identity (Apollo Enrichment)
  missionStatement    String?
  vision              String?
  values              String?
  brandTagline        String?
  brandLogoUrl        String?
  brandColorPrimary   String?
  brandColorSecondary String?

  // Leadership (Apollo Enrichment)
  ceoName      String?
  ceoTitle     String?
  deputyName   String?
  deputyTitle  String?
  chiefOfStaff String?

  // Organization (Apollo Enrichment)
  directorates String[] @default([])

  // Social / Public (Apollo Enrichment)
  linkedinUrl String?
  twitterUrl  String?
  facebookUrl String?
  phone       String?

  // Address (Apollo Enrichment)
  country String?

  // Relations
  members         WorkMe[]
  workplaces      Workplace[]
  employees       CompanyEmployee[]
  highlights      CompanyEmployeeHighlight[]
  milestones      CompanyMilestone[]
  campaigns       CompanyCampaign[]          @relation("CompanyCampaignCompany")
  impactEvents    CompanyImpactEvent[]       @relation("CompanyImpactEventCompany")
  trainings       CompanyTraining[]          @relation("CompanyTrainingCompany")
  events          CompanyEvent[]             @relation("CompanyEventCompany")
  communities     CompanyCommunity[]         @relation("CompanyCommunityCompany")
  benefits        CompanyBenefits[]          @relation("CompanyBenefitsCompany")
  careers         CompanyCareer[]            @relation("CompanyCareerCompany")
  employeeCauses  CompanyEmployeeCause[]     @relation("CompanyEmployeeCauseCompany")
  productFamilies ProductFamily[]
  newsArtifacts   CompanyNewsArtifact[]

  @@index([name])
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// WORK ENTRY MODEL (Work History)
// ============================================
model WorkEntry {
  id          String    @id @default(uuid())
  workMeId    String    @db.Uuid
  companyName String?
  title       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([startDate])
  @@index([endDate])
}

// ============================================
// WORK SKILLS MODEL
// ============================================
model WorkSkills {
  id             String  @id @default(uuid())
  workMeId       String  @unique @db.Uuid
  skillsRaw      String?
  strengthsRaw   String?
  specialties    String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// WORKPLACE MODEL
// ============================================
model Workplace {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe  WorkMe  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workMeId, companyId])
  @@index([workMeId])
  @@index([companyId])
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("CommsOutputOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Objective {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("ObjectiveOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title       String
  description String?
  howMeasured String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Achievement {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("AchievementOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title    String
  category AchievementCategory

  audienceName String?
  audienceSize Int?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  commsOutputId String?
  commsOutput   CommsOutput? @relation(fields: [commsOutputId], references: [id], onDelete: SetNull)

  whatYouDid String
  frequency  String?
  volume     Int?

  processSteps Json?
  impact       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyUnit])
  @@index([originatorId])
  @@index([category])
}

// ============================================
// COMPANY MODELS (CompanyX)
// ============================================

model CompanyCampaign {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  windowStart  DateTime?
  windowEnd    DateTime?
  ctaLink      String?
  sponsor      String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  ingestRawText String?

  summary String?

  companyId         String?
  company           Company? @relation("CompanyCampaignCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyCampaignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemCampaign")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model CompanyImpactEvent {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  title              String
  description        String?
  effectiveDate      DateTime?
  impactedPopulation String?
  urgency            String?
  pocFirstName       String?
  pocLastName        String?
  pocEmail           String?
  pocPhone           String?

  ingestRawText String?

  summary String?

  companyId         String?
  company           Company? @relation("CompanyImpactEventCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyImpactEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemImpactEvent")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model CompanyTraining {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title            String?
  topic            String?
  description      String?
  mandatory        Boolean @default(false)
  sponsoringOffice String?

  trainingDate DateTime?
  startTime    String?
  endTime      String?

  location String?
  format   String?
  link     String?

  pocFirstName   String?
  pocLastName    String?
  pocEmail       String?
  pocPhone       String?
  pocRankOrTitle String?

  ingestRawText   String?
  ingestType      String?
  ingestStatus    String?   @default("pending")
  ingestCreatedAt DateTime? @default(now())

  summary String?

  companyId         String?
  company           Company? @relation("CompanyTrainingCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyTrainingCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemTraining")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model CompanyEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  theme       String?
  description String?

  eventDate DateTime?
  startTime String?
  endTime   String?

  eventCategory EventCategory?

  registrationRequired String?
  registrationLink     String?

  audience      EventAudience?
  vibe          String?
  perks         String[]       @default([])
  participation String[]       @default([])

  foodProvided String?
  foodTypes    String?

  speakers String[] @default([])
  pocEmail String?
  pocPhone String?

  ingestRawText String?

  summary String?

  companyId         String?
  company           Company? @relation("CompanyEventCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  eventItems       EventItem[]       @relation
  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemEvent")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model EventItem {
  id      String       @id @default(cuid())
  eventId String
  event   CompanyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model CompanyCommunity {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  partnerOrg   String?
  date         DateTime?
  location     String?
  signUpLink   String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  ingestRawText String?

  summary String?

  companyId         String?
  company           Company? @relation("CompanyCommunityCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyCommunityCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemCommunity")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model CompanyBenefits {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title                  String
  description            String?
  employeeBenefitSummary String?

  windowStart DateTime?
  windowEnd   DateTime?

  deadlines Json?

  actionLink String?
  resources  Json?

  pocList           Json?
  extraInstructions Json?

  summary String?

  ingestRawText String?

  companyId         String?
  company           Company? @relation("CompanyBenefitsCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyBenefitsCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemBenefits")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

enum CareerLevel {
  NAVSEA
  NAVY
  DOD
}

enum CareerType {
  Leadership
  Fellowship
  Other
}

model CompanyCareer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title       String
  description String?

  level CareerLevel?
  type  CareerType?

  eligibility Json?

  application Json?

  extras Json?

  ingestRawText String?

  summary String?

  companyId         String?
  company           Company? @relation("CompanyCareerCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyCareerCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemCareer")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model CompanyEmployeeCause {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title         String
  description   String?
  impactSummary String?

  partnerOrg           String?
  sponsoringDepartment String?

  windowStart DateTime?
  windowEnd   DateTime?
  deadlines   Json?

  locations String[] @default([])
  link      String?

  pocList           Json?
  extraInstructions Json?

  summary String?

  ingestRawText String?

  companyId         String?
  company           Company? @relation("CompanyEmployeeCauseCompany", fields: [companyId], references: [id], onDelete: SetNull)
  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyEmployeeCauseCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[] @relation("EmailDigestItemEmployeeCause")

  @@index([companyId])
  @@index([createdByWorkMeId])
}

// ====================================================
// COMPANY EMPLOYEE (Employee-First Architecture)
// ====================================================
model CompanyEmployee {
  id       String  @id @default(cuid())
  fullName String
  title    String?
  email    String?
  phone    String?
  photoUrl String?

  // Organizational context (employee-first architecture)
  companyId       String // Authoritative organizational FK (required)
  workMeCompanyId String // Silent background tag for tenant partitioning
  companyUnit     String? // Optional string label ("SEA 05", "NAVSEA HQ")
  division        String? // Optional string label (ignored by app logic)

  // Audit trail
  createdByWorkMeId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  highlights         CompanyEmployeeHighlight[]
  seniorLeaderEmails ProductSeniorLeaderEmailContent[]
  myTeamDirectors    MyTeamDirectorProfile[]
  myTeamDeputies     MyTeamDeputyProfile[]
  myTeamPeers        MyTeamPeerProfile[]
  myTeamSubordinates MyTeamSubordinateProfile[]
  company            Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          WorkMe                            @relation("CompanyEmployeeCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workMeCompanyId])
  @@index([companyUnit])
  @@index([fullName])
  @@index([email])
}

// ====================================================
// COMPANY EMPLOYEE HIGHLIGHT
// ====================================================
enum HighlightClassification {
  EXCELLENCE
  LEADERSHIP
  INNOVATION
  SERVICE
  IMPACT
}

model CompanyEmployeeHighlight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citationText   String
  achievement    String?
  narrative      String?
  classification HighlightClassification?

  awardName       String?
  categoryOfAward String? // e.g., "NAVSEA Excellence Awards - Technical Innovation Category"
  awardingAgency  String?
  awardYear       Int?

  supervisorQuote String?

  companyUnitLabel String?
  companyId        String? // Direct company reference for cleaner hydration (set by route context via upsert)

  createdByWorkMeId String   @db.Uuid
  createdBy         WorkMe   @relation("CompanyEmployeeHighlightCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  company           Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String // Direct employee reference (required - user selects employee in step 1)
  employee   CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  engageMessages EngageMessage[]

  @@index([createdByWorkMeId])
  @@index([companyUnitLabel])
  @@index([companyId])
  @@index([employeeId])
}

// ============================================
// WORKFORCE ENDURING PRODUCTS
// ============================================

enum EmailDigestEditionStatus {
  DRAFT // Being curated, items being selected
  GENERATING // OpenAI generation in progress
  GENERATED // Content generated, ready for review
  SENT // Finalized and sent
}

model WorkForceEnduringProdEmailDigest {
  id                String   @id @default(uuid())
  title             String
  description       String?
  companyId         String
  createdByWorkMeId String   @db.Uuid
  createdAt         DateTime @default(now())

  createdBy WorkMe               @relation("EmailDigestProductCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  editions  EmailDigestEdition[]

  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([createdAt])
}

model EmailDigestEdition {
  id            String                           @id @default(uuid())
  emailDigestId String
  product       WorkForceEnduringProdEmailDigest @relation(fields: [emailDigestId], references: [id], onDelete: Cascade)

  status       EmailDigestEditionStatus @default(DRAFT)
  contentJson  Json? // Generated content (null until GENERATED)
  generatedAt  DateTime                 @default(now())
  originatorId String
  companyId    String

  items EmailDigestItem[] // Items selected for this edition

  @@index([emailDigestId])
  @@index([companyId])
  @@index([status])
  @@index([generatedAt])
}

model EmailDigestItem {
  id        String             @id @default(cuid())
  editionId String
  edition   EmailDigestEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  // Link to one CompanyX model (one of these will be set)
  companyEventId         String?
  companyCampaignId      String?
  companyTrainingId      String?
  companyBenefitsId      String?
  companyImpactEventId   String?
  companyCommunityId     String?
  companyCareerId        String?
  companyEmployeeCauseId String?

  // Relations (nullable)
  companyEvent         CompanyEvent?         @relation("EmailDigestItemEvent", fields: [companyEventId], references: [id], onDelete: Cascade)
  companyCampaign      CompanyCampaign?      @relation("EmailDigestItemCampaign", fields: [companyCampaignId], references: [id], onDelete: Cascade)
  companyTraining      CompanyTraining?      @relation("EmailDigestItemTraining", fields: [companyTrainingId], references: [id], onDelete: Cascade)
  companyBenefits      CompanyBenefits?      @relation("EmailDigestItemBenefits", fields: [companyBenefitsId], references: [id], onDelete: Cascade)
  companyImpactEvent   CompanyImpactEvent?   @relation("EmailDigestItemImpactEvent", fields: [companyImpactEventId], references: [id], onDelete: Cascade)
  companyCommunity     CompanyCommunity?     @relation("EmailDigestItemCommunity", fields: [companyCommunityId], references: [id], onDelete: Cascade)
  companyCareer        CompanyCareer?        @relation("EmailDigestItemCareer", fields: [companyCareerId], references: [id], onDelete: Cascade)
  companyEmployeeCause CompanyEmployeeCause? @relation("EmailDigestItemEmployeeCause", fields: [companyEmployeeCauseId], references: [id], onDelete: Cascade)

  order     Int // Display order in digest
  notes     String? // User notes for this item
  createdAt DateTime @default(now())

  @@index([editionId])
  @@index([companyEventId])
  @@index([companyCampaignId])
  @@index([companyTrainingId])
  @@index([companyBenefitsId])
  @@index([companyImpactEventId])
  @@index([companyCommunityId])
  @@index([companyCareerId])
  @@index([companyEmployeeCauseId])
  @@index([order])
}

// ============================================
// DIGITAL SIGNAGE PRODUCT MODELS
// ============================================

model ProductDigitalSign {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When archived, null if active

  signType DigitalSignType

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("ProductDigitalSignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  workforce            ProductDigitalSignWorkforce?
  companyNews          ProductDigitalSignCompanyNews?
  workforceAchievement ProductDigitalSignWorkforceAchievement?
  companyEvent         ProductDigitalSignCompanyEvent?


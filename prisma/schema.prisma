// ============================================
// COMPANY PLATFORM PRODUCT MODELS
// ============================================
model CompanyPlatformProduct {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name             String // "Virginia-class"
  alternativeNames String[] @default([]) // "SSN", "Attack Submarine", "VCS"
  category         String? // "Submarine", "Surface Combatant"
  description      String?

  platformSeries String? // SSN, SSBN, CVN, DDG
  whySpecial     String? // High-level: stealth, payload, mission role
  payloadNotes   String? // e.g., VPM adds 28 missiles

  intendedTotalUnits Int? // e.g., 12 Columbia-class subs
  productionNotes    String? // yard performance, challenges, etc.

  // Optional "other ships in this class" strings (not unit models)
  knownShipsInClass String[] @default([])

  // AI or reporting derived signals
  currentProgressEstimate Int? // 0–100 for overall program maturity
  programStatus           String? // "On Track", "Delayed", "Rebaseline Expected"

  // Legacy fields (keeping for backward compatibility)
  nextDeliveryExpected DateTime?
  lastDeliveryDate     DateTime?

  // Expanded physical and program attributes
  totalLength                String? // e.g., "377 ft (115 m)"
  totalBeam                  String? // optional beam
  totalDisplacementSubmerged String? // e.g., "8,700 tons"
  totalManpowerNeeds         String? // e.g., "132 crew"
  totalTimeToBuild           String? // e.g., "66–84 months"
  totalEstimatedCostPerUnit  String? // e.g., "$3.2–3.8 billion"

  // Sensors and technology arrays
  sensors String[] @default([])

  // Industrial base / builders
  defenseBuilders String[] @default([])

  // All units (names only — not the CompanyPlatformUnit models)
  unitsInSeries String[] @default([])

  // When the platform class began (lead ship laid down)
  classStartDate DateTime?

  units      CompanyPlatformUnit[]
  statements CompanyPlatformStatement[]
  updates    CompanyPlatformUpdate[]
  evidence   ExternalEvidence[]

  @@index([name])
  @@index([platformSeries])
  @@index([category])
}

model CompanyPlatformUnit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformProductId String
  platformProduct   CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  // Identity & Ordinal Context
  hullNumber    String // "SSN 804"
  name          String? // "Barb"
  numberInClass Int? // ordinal position in class (replaces "block")
  platformClass String? // optional denormalized label (e.g., "Virginia-class")

  // Industrial / Build Context
  defenseContractor String? // e.g., "General Dynamics Electric Boat"
  shipyard          String? // HII Newport News, Electric Boat
  whereBuilt        String? // e.g., "Newport News, VA"
  unitCost          String? // free-text cost range for now

  // Lifecycle Dates (authoritative state, not events)
  constructionStartDate    DateTime?
  constructionCompleteDate DateTime?
  deliveryToFleetDate      DateTime?
  deliveryExpected         DateTime? // legacy field - kept for backward compatibility
  commissioningDate        DateTime?

  // Operational Context
  homeport        String?
  currentStatus   String? // keep loose (enum later)
  status          String? // legacy field - "Under Construction", "Keel Laid", "Sea Trials", etc.
  percentComplete Int?

  // System / Creation Metadata
  createdVia String? // "MANUAL" | "AI_INGEST"

  description String?

  // Raw signals & updates
  statements CompanyPlatformUnitStatement[]
  updates    CompanyPlatformUnitUpdate[]
  milestones CompanyMilestone[]

  // Stakeholders with meaning (not employees, not org chart)
  namesake     CompanyPlatformUnitNamesake?
  livingHomage CompanyPlatformUnitLivingHomage?

  @@index([platformProductId])
  @@index([hullNumber])
  @@index([name])
  @@index([numberInClass])
  @@index([platformClass])
  @@index([currentStatus])
}

// ============================================
// COMPANY PLATFORM STATEMENT MODEL
// ============================================
model CompanyPlatformStatement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platformProductId String
  platformProduct   CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  // Optional: Link to news artifact if created from one
  newsArtifactId String?
  newsArtifact   CompanyNewsArtifact? @relation(fields: [newsArtifactId], references: [id], onDelete: SetNull)

  sourceName String? // "USNI News", "DoD Release", "GD CEO Earnings Call"
  sourceUrl  String?
  headline   String?
  rawText    String // Full pasted article/content

  aiSummary String? // GPT-generated summary
  aiTags    String[] @default([]) // e.g. ["schedule", "industrial base", "cost"]

  // Linking to updates we derive from this statement
  updates CompanyPlatformUpdate[]

  @@index([platformProductId])
  @@index([newsArtifactId])
  @@index([sourceName])
}

// ============================================
// COMPANY PLATFORM UPDATE MODEL
// ============================================
model CompanyPlatformUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformProductId String
  platformProduct   CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  statementId String?
  statement   CompanyPlatformStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  // What changed or was reported
  scheduleStatus          String? // "Behind", "Ahead", "Critical Path Issue"
  costStatus              String? // "Cost Growth", "Stable", "Rebaseline"
  industrialBaseNote      String? // "Labor shortage", "supplier delays"
  leadershipQuote         String? // Parsed relevant quote
  percentCompleteEstimate Int? // If article says "60% complete" (program level)

  // Overwriteable fields for the platform record
  override_intendedTotalUnits      Int?
  override_programStatus           String?
  override_currentProgressEstimate Int?

  narrativeSummary String? // AI structured meaning
  tags             String[] @default([])

  @@index([platformProductId])
  @@index([statementId])
  @@index([scheduleStatus])
}

// ============================================
// COMPANY PLATFORM UNIT STATEMENT MODEL
// ============================================
model CompanyPlatformUnitStatement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platformUnitId String
  platformUnit   CompanyPlatformUnit @relation(fields: [platformUnitId], references: [id], onDelete: Cascade)

  // Optional: Link to news artifact if created from one
  newsArtifactId String?
  newsArtifact   CompanyNewsArtifact? @relation(fields: [newsArtifactId], references: [id], onDelete: SetNull)

  sourceName String? // "USNI News", "HII Release"
  sourceUrl  String?
  headline   String?
  rawText    String // full text of the release or article

  aiSummary String?
  aiTags    String[] @default([])

  updates CompanyPlatformUnitUpdate[]

  @@index([platformUnitId])
  @@index([newsArtifactId])
}

// ============================================
// COMPANY PLATFORM UNIT UPDATE MODEL
// ============================================
model CompanyPlatformUnitUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformUnitId String
  platformUnit   CompanyPlatformUnit @relation(fields: [platformUnitId], references: [id], onDelete: Cascade)

  statementId String?
  statement   CompanyPlatformUnitStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  // Extracted signals
  percentComplete    Int?
  statusUpdate       String? // "Keel Laid", "Construction 60% complete"
  scheduleNote       String?
  industrialBaseNote String?
  leadershipQuote    String?

  // Dates that may be provided in an update
  keelLaidDate       DateTime?
  seaTrialsStartDate DateTime?
  deliveryDate       DateTime?
  commissioningDate  DateTime?

  // AI narrative summary
  narrativeSummary String?
  tags             String[] @default([])

  // Reverse relation to milestone (if this update triggered one)
  milestones CompanyMilestone[]

  @@index([platformUnitId])
  @@index([statementId])
  @@index([statusUpdate])
}

// ============================================
// COMPANY PRODUCT CAPACITY MODEL
// ============================================
model CompanyProductCapacity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String // "Newport News Shipbuilding"
  location       String? // "Newport News, VA"
  contractorType String? // "shipyard", "module supplier", etc.
  capabilities   String[] @default([]) // e.g. ["pressure hull modules", "final assembly"]
  constraints    String[] @default([]) // bottlenecks, known issues
  productionRate String? // free-text for now
  notes          String?

  @@index([name])
  @@index([contractorType])
}

// ============================================
// COMPANY PRODUCT INNOVATION MODEL
// ============================================
model CompanyProductInnovation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  description   String?
  impactArea    String? // "operations", "training", "maintenance", etc.
  maturityLevel String? // TRL or internal readiness scale
  demoStatus    String?
  partners      String[] @default([])
  benefits      String[] @default([])

  @@index([name])
  @@index([impactArea])
  @@index([maturityLevel])
}

// ============================================
// COMPANY PLATFORM UNIT NAMESAKE MODEL (Historical/Symbolic Significance)
// ============================================
// Represents the historical figure or entity for whom a platform unit is named.
// This preserves the narrative context that should never be flattened downstream.
// Super niche - tied directly to a specific platform unit.
model CompanyPlatformUnitNamesake {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platformUnitId String              @unique
  platformUnit   CompanyPlatformUnit @relation(fields: [platformUnitId], references: [id], onDelete: Cascade)

  fullName String // e.g. "Eugene Bennett Fluckey"
  knownAs  String? // e.g. "Lucky"
  role     String? // e.g. "WWII Submarine Commander"
  whyKnown String? // factual significance

  legacySummary String? // short, factual (no prose)

  era    String?
  honors String[] @default([])

  notes String?

  @@index([platformUnitId])
  @@index([fullName])
}

// ============================================
// COMPANY PLATFORM UNIT LIVING HOMAGE MODEL (Meaning Carriers)
// ============================================
// Represents living stakeholders who carry forward the legacy of a namesake for a specific platform unit.
// These are not employees, not org chart positions—they are meaning carriers.
// Examples: ship sponsors, memorial honorees, dedication representatives.
// Super niche - tied directly to a specific platform unit.
// This tab will be shared by: ship sponsors, memorial honorees, dedication representatives, external legacy holders.
model CompanyPlatformUnitLivingHomage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platformUnitId String              @unique
  platformUnit   CompanyPlatformUnit @relation(fields: [platformUnitId], references: [id], onDelete: Cascade)

  fullName String // e.g. "Pamela Bove"
  role     String? // e.g. "Ship Sponsor"
  relation String? // e.g. "Granddaughter-in-law of namesake"

  notes String?

  @@index([platformUnitId])
  @@index([fullName])
}

// ============================================
// COMPANY MILESTONE MODEL
// ============================================
// Generic company-level milestones (platform events, business milestones, strategic milestones)
// 
// OWNERSHIP: CompanyMilestone is owned by Company (companyId REQUIRED)
// 
// CONTEXT: platformUnitId is OPTIONAL - provides context when milestone relates to a platform unit
// PROVENANCE: updateId is OPTIONAL - links back to the update that triggered this milestone
// 
// Milestones may exist:
// - without updates (manual creation)
// - without platform units (business/strategic milestones)
// 
// INFERENCE RULE (future enforcement):
// If milestoneType === KEEL_LAYING, the platform unit should have a CompanyPlatformUnitLivingHomage.
// This ensures narrative signal is preserved and never reduced to "keel laid".
// The system should never again flatten these moments—they carry human meaning.
// 
// This model drives downstream:
// - digital signage language (foregrounding people, not steel)
// - recognition-first layouts
// - AI-generated comms that preserve narrative context
// 
// Note: Namesake and LivingHomage are now properties of the platform unit itself,
// accessed via platformUnit.namesake and platformUnit.livingHomage
model CompanyMilestone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership - Company owns the milestone
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // General milestone information
  title         String // e.g., "USS Barb (SSN-804) Keel Laying"
  category      String? // e.g., "Platform", "Business", "Strategy"
  milestoneType String? // free-text or derived label (e.g., "KEEL_LAYING", "Product Launch", "Merger")
  date          DateTime?
  description   String?
  sourceUrl     String?

  // Optional contextual linkage (not ownership)
  platformUnitId String?
  platformUnit   CompanyPlatformUnit? @relation(fields: [platformUnitId], references: [id], onDelete: SetNull)

  // Optional provenance linkage (which update triggered this milestone)
  updateId String?                    @unique
  update   CompanyPlatformUnitUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([platformUnitId])
  @@index([category])
  @@index([milestoneType])
  @@index([date])
}

// ============================================
// WORKENGAGE MODELS
// ============================================

model EngageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())

  messages EngageMessage[]

  @@index([name])
}

model EngageMessage {
  id          String   @id @default(cuid())
  ownerId     String   @db.Uuid
  templateId  String?
  highlightId String?
  message     String
  createdAt   DateTime @default(now())

  owner     WorkMe                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template  EngageTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  highlight CompanyEmployeeHighlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([templateId])
  @@index([highlightId])
  @@index([createdAt])
}

// ============================================
// COMPANY NEWS ARTIFACT MODEL (Universal Article/Press Release Storage)
// ============================================
// Universal staging area for news articles and press releases
// Can be used by platform statements, unit statements, updates, etc.
// Similar to SignalArtifact but for news/press content

model CompanyNewsArtifact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Article metadata
  sourceName String? // "USNI News", "HII Release", "DoD Release"
  sourceUrl  String? // URL of the article/press release
  headline   String? // Article headline or title

  // Content
  rawText   String // Full article/press release text
  aiSummary String? // AI-generated one paragraph summary

  // Article Intelligence
  artifactType    String? // "unit_update", "milestone", "workforce", "leadership", etc.
  sentiment       String? // "positive", "negative", "neutral"
  humanElements   Json? // e.g., {"sponsor": "Pamela Bove", "leaders": ["SECNAV"], "attendees": [...]}
  noteworthyItems Json? // e.g., {"key_facts": [...], "dates": [...], "milestones": [...]}
  leaderStatement Json? // e.g., {"statement": "...", "leader": "SECNAV Del Toro", "role": "Secretary of the Navy"}

  // Optional: Link to who created/ingested it
  createdByWorkMeId String? @db.Uuid
  createdBy         WorkMe? @relation("CompanyNewsArtifactCreator", fields: [createdByWorkMeId], references: [id], onDelete: SetNull)

  // Relations - can be used by multiple entities
  platformStatements     CompanyPlatformStatement[]
  platformUnitStatements CompanyPlatformUnitStatement[]

  @@index([companyId])
  @@index([sourceName])
  @@index([sourceUrl])
  @@index([artifactType])
  @@index([sentiment])
  @@index([createdByWorkMeId])
  @@index([createdAt])
}

// ============================================
// SIGNAL ARTIFACT MODELS (Scratchpad + Lens)
// ============================================
// SignalArtifact = raw memory, immutable, no intelligence
// SeniorLeaderTopic = lightweight interpretation, not truth
// This is a thin, non-authoritative layer - scaffolding only

model SignalArtifact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title             String?
  content           String // full pasted text, untouched
  saidBy            String? // free text for now ("Chris Miller")
  role              String? // optional
  source            String? // "senior_leader_email", "speech", etc.
  createdByWorkMeId String? @db.Uuid // if user pasted it

  // Relations
  topics SeniorLeaderTopic[]

  @@index([createdByWorkMeId])
  @@index([source])
  @@index([createdAt])
}

model SeniorLeaderTopic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Can belong to either SignalArtifact (raw signal) or ProductSeniorLeaderEmail (product)
  signalArtifactId String?
  signalArtifact   SignalArtifact? @relation(fields: [signalArtifactId], references: [id], onDelete: Cascade)

  seniorLeaderEmailProductId String?
  seniorLeaderEmailProduct   ProductSeniorLeaderEmail? @relation(fields: [seniorLeaderEmailProductId], references: [id], onDelete: Cascade)

  topic       String // e.g. "Product Change", "Leadership Transition"
  description String? // short human-readable explanation

  @@index([signalArtifactId])
  @@index([seniorLeaderEmailProductId])
  @@index([createdAt])
}

// ============================================
// SENIOR LEADER EMAIL PRODUCT MODEL (MyWork)
// ============================================
// Product artifact for senior leader emails - "what did the boss say"
// This is a PRODUCT, not a signal
// Always includes topic parsing (SeniorLeaderTopics)
//
// ARCHITECTURAL NOTE:
// ProductSeniorLeaderEmailContent references CompanyEmployee via companyEmployeeId.
// CompanyEmployee is the single source of truth for all company people.
// Role enum (SeniorLeaderRole) is context only, not identity.
model ProductSeniorLeaderEmail {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When archived, null if active

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("ProductSeniorLeaderEmailCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // Typed variant (1:1 relationship)
  content ProductSeniorLeaderEmailContent?

  // Parsed topics (always present for products)
  topics SeniorLeaderTopic[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([archivedAt])
}

model ProductSeniorLeaderEmailContent {
  id                         String @id @default(cuid())
  seniorLeaderEmailProductId String @unique

  title             String?
  actualSubjectLine String? // actual email subject line
  content           String // full pasted text, untouched (BodyofEmail)

  // Role enum - user selects this first, then looks up people
  role SeniorLeaderRole

  // Reference to CompanyEmployee (the actual person selected after role lookup)
  companyEmployeeId String?
  companyEmployee   CompanyEmployee? @relation(fields: [companyEmployeeId], references: [id], onDelete: SetNull)

  product ProductSeniorLeaderEmail @relation(fields: [seniorLeaderEmailProductId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([companyEmployeeId])
}

// ============================================
// PRODUCT FAMILY MODEL
// ============================================
// ProductFamily represents a high-level product concept or program
// (e.g., "Golden Fleet", "Virginia-class", "Columbia Program")
// Can optionally belong to a Company, but exists independently
model ProductFamily {
  id          String              @id @default(cuid())
  companyId   String?
  name        String
  description String?
  status      ProductFamilyStatus @default(CONCEPT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  evidence ExternalEvidence[]

  @@index([companyId])
  @@index([name])
  @@index([status])
}

enum ProductFamilyStatus {
  CONCEPT
  ADVOCATED
  PROGRAM
}

// ============================================
// EXTERNAL EVIDENCE MODEL
// ============================================
// External evidence from publicly verifiable sources (OSINT)
// Always belongs to a ProductFamily (required anchor point)
// Can optionally link to a CompanyPlatformProduct for additional context
model ExternalEvidence {
  id                String    @id @default(cuid())
  productFamilyId   String // REQUIRED - evidence must belong to a ProductFamily
  productPlatformId String? // OPTIONAL - can link to CompanyPlatformProduct for context
  title             String
  url               String
  publisher         String?
  publishedAt       DateTime?
  snippet           String?
  capturedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  productFamily   ProductFamily           @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  productPlatform CompanyPlatformProduct? @relation(fields: [productPlatformId], references: [id], onDelete: SetNull)

  classifications EvidenceClassification[]

  @@index([productFamilyId])
  @@index([productPlatformId])
  @@index([url])
  @@index([capturedAt])
}

// ============================================
// EVIDENCE CLASSIFICATION MODEL
// ============================================
// Optional inferred classifications for evidence
// Only stored after user confirmation (confirmedByUser = true)
model EvidenceClassification {
  id                 String                     @id @default(cuid())
  evidenceId         String
  classificationType EvidenceClassificationType
  confirmedByUser    Boolean                    @default(false)
  createdAt          DateTime                   @default(now())

  evidence ExternalEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, classificationType])
  @@index([evidenceId])
  @@index([classificationType])
  @@index([confirmedByUser])
}

enum EvidenceClassificationType {
  COMPANY_PRODUCTS
  COMPANY_PUBLIC_PERCEPTION
  EXTERNAL_COMPANY_PRESSURE
}

// ============================================
// PLANNER MODELS (Conceptual Planning Staging Area)
// ============================================
// Planner is a staging area for future ideas - NOT a calendar, NOT a task manager, NOT a source of truth
// PlannedItem OWNS time. PlannerContainer range is DERIVED later (do not store start/end).

model PlannerContainer {
  id             String   @id @default(cuid())
  name           String
  description    String?
  timeframeLabel String? // e.g. "2026", "Q2 2026", "Rolling"
  companyId      String
  divisionUnitId String?
  ownerUserId    String
  createdAt      DateTime @default(now())

  items PlannedItem[]

  @@index([companyId])
  @@index([ownerUserId])
  @@index([createdAt])
}

model PlannedItem {
  id                 String           @id @default(cuid())
  plannerContainerId String
  plannerContainer   PlannerContainer @relation(fields: [plannerContainerId], references: [id], onDelete: Cascade)

  companyId      String
  divisionUnitId String?

  // Optional source links (nullable FK placeholders)
  sourceEventId    String?
  sourceCampaignId String?
  sourceProgramId  String?

  itemKind    String // e.g. "event", "series", "campaign", free text
  title       String
  description String?

  plannedTimeLabel  String // REQUIRED human-readable time, e.g. "Q2 2026", "Spring"
  plannedTimeAnchor DateTime? // nullable, for sorting only

  notes String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([plannerContainerId])
  @@index([companyId])
  @@index([createdByUserId])
  @@index([plannedTimeAnchor])
  @@index([createdAt])
}

// ============================================
// SENIOR LEADER DIGEST MODELS
// ============================================

enum DigestStatus {
  DRAFT
  GENERATED
  SENT
}

enum DigestEntryType {
  DELIVERY
  WIN
  WORKFORCE
  REMINDER
}

enum DigestSourceType {
  COMPANY_UNIT
  PLATFORM_UNIT
  EVENT
  MILESTONE
  WORKFORCE
  MANUAL
}

model SeniorLeaderDigest {
  id             String       @id @default(cuid())
  leaderName     String
  leaderRole     String
  organizationId String
  weekOf         DateTime
  subjectLine    String?
  openingNote    String? // AI-generated, editable
  status         DigestStatus @default(DRAFT)

  entries SeniorLeaderDigestEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([weekOf])
  @@index([status])
  @@index([createdAt])
}

model SeniorLeaderDigestEntry {
  id          String            @id @default(cuid())
  digestId    String
  type        DigestEntryType
  title       String
  description String?
  sourceType  DigestSourceType?
  sourceId    String?

  orderIndex Int

  digest SeniorLeaderDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@index([digestId])
  @@index([type])
  @@index([orderIndex])
}

// ============================================
// MEMO & LINKEDIN POST MODELS
// ============================================
// Memo = Human source of truth for work moments
// LinkedInPost = Distribution artifact (user-approved posts)

enum MemoContextType {
  EVENT
  MEETING
  DELIVERY
  RECOGNITION
  OTHER
}

enum LinkedInPostStatus {
  DRAFT
  POSTED
  FAILED
}

model Memo {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When did this actually happen (can differ from createdAt)
  happenedAt DateTime @default(now())

  // Structured Reflection (the narrative)
  whatHappened String // Factual description
  whySpecial   String? // Why this moment mattered
  myRole       String? // How the user contributed
  impact       String? // Outcome or effect
  thoughts     String? // Optional reflection / emotion

  // Context
  contextType MemoContextType @default(OTHER)

  // Relations
  workMe        WorkMe         @relation("WorkMeMemos", fields: [workMeId], references: [id], onDelete: Cascade)
  linkedInPosts LinkedInPost[]

  @@index([workMeId])
  @@index([happenedAt])
  @@index([contextType])
  @@index([createdAt])
}

model LinkedInPost {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation (nullable - can create post without memo)
  memoId String?
  memo   Memo?   @relation(fields: [memoId], references: [id], onDelete: SetNull)

  // Content
  title   String? // Internal label (optional)
  content String // Final, edited, user-approved text

  // State
  status          LinkedInPostStatus @default(DRAFT)
  postedAt        DateTime?
  linkedinPostUrn String? // LinkedIn's unique identifier
  errorMessage    String? // If posting failed

  // Relations
  workMe WorkMe @relation("WorkMeLinkedInPosts", fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([memoId])
  @@index([status])
  @@index([postedAt])
  @@index([createdAt])
}

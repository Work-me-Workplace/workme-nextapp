generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================
// CORE USER MODEL (Pure Identity + Simple Public Profile)
// ============================================
// WorkMe = Core Identity (Personhood)
// Contains ONLY stable identity fields + simple public-facing profile fields
model WorkMe {
  id         String   @id @default(uuid()) @db.Uuid
  firebaseId String?  @unique
  email      String   @unique
  createdAt  DateTime @default(now())

  // Simple public-facing profile fields (NOT work fields)
  headline    String?
  handle      String? @unique
  title       String?
  linkedinUrl String?

  // LinkedIn OAuth (minimal required fields)
  linkedinUserId         String? // LinkedIn user ID from /v2/userinfo
  linkedinAccessToken    String? // Access token (no refresh token support)
  linkedinTokenExpiresAt DateTime? // When token expires (5184000 seconds = 60 days)

  // WorkMeCompany - silent background tag for tenant partitioning
  workMeCompanyId String?
  workMeCompany   WorkMeCompany? @relation(fields: [workMeCompanyId], references: [id])

  // Organizational context (MVP1 - string labels only)
  companyId   String? // Authoritative organizational FK
  companyUnit String? // Optional string label ("SEA 05", "NAVSEA HQ")
  division    String? // Optional string label

  // Bolt-on modules (all via foreign keys)
  workProfile        WorkProfile?
  workSkills         WorkSkills?
  workEntries        WorkEntry[]
  workGoals          WorkGoal[]
  ecosystemCompanies WorkMeEcosystemCompany[]
  ecosystemContacts  MyEcosystemContact[]

  // WorkWorld Architecture Relations
  workplaces Workplace[]

  // Minimal reverse relations (required by Prisma, but NOT to be queried)
  // WorkMe is pure identity - work outputs reference WorkMe via createdByWorkMeId
  // These relations exist only for Prisma schema validation
  originatedCommsOutputs     CommsOutput[]                      @relation("CommsOutputOriginator")
  originatedObjectives       Objective[]                        @relation("ObjectiveOriginator")
  originatedAchievements     Achievement[]                      @relation("AchievementOriginator")
  createdEmailDigestProducts WorkForceEnduringProdEmailDigest[] @relation("EmailDigestProductCreator")
  companyCampaigns           CompanyCampaign[]                  @relation("CompanyCampaignWorkMe")
  companyImpactEvents        CompanyImpactEvent[]               @relation("CompanyImpactEventWorkMe")
  companyTrainings           CompanyTraining[]                  @relation("CompanyTrainingWorkMe")
  companyEvents              CompanyEvent[]                     @relation("CompanyEventWorkMe")
  companyLeaderEngagements   CompanyLeaderEngagement[]          @relation("CompanyLeaderEngagementWorkMe")
  companyCommunities         CompanyCommunity[]                 @relation("CompanyCommunityWorkMe")
  companyCareers             CompanyCareer[]                    @relation("CompanyCareerWorkMe")
  companyBenefits            CompanyBenefits[]                  @relation("CompanyBenefitsWorkMe")
  companyEmployeeCauses      CompanyEmployeeCause[]             @relation("CompanyEmployeeCauseWorkMe")
  createdPlatformProducts    CompanyPlatformProduct[]           @relation("CompanyPlatformProductWorkMe")
  createdDigitalSignProducts ProductDigitalSign[]               @relation("ProductDigitalSignCreator")
  createdEmployeeHighlights  CompanyEmployeeHighlight[]         @relation("CompanyEmployeeHighlightCreator")
  createdUnitHighlights      CompanyUnitHighlight[]             @relation("CompanyUnitHighlightCreator")
  createdCompanyEmployees    CompanyEmployee[]                  @relation("CompanyEmployeeCreator")
  engageMessages             EngageMessage[]

  // Design Work Package Relations
  createdDesignWorkPackages  DesignWorkPackage[] @relation("DesignWorkPackageCreator")
  assignedDesignWorkPackages DesignWorkPackage[] @relation("DesignWorkPackageAssigned")

  // WorkOps Relations
  workOpsOutlook WorkOpsOutlook?

  // MyTeam Relations (Personal Intelligence)
  myTeamContainer MyTeamContainer?

  // Company Products Relations
  externalCompanyPressures ExternalCompanyPressure[]
  companyExternalEnv       CompanyExternalEnv[]      @relation("CompanyExternalEnvWorkMe")
  Company                  Company?                  @relation(fields: [companyId], references: [id])

  // Product Relations
  createdSeniorLeaderEmailProducts ProductSeniorLeaderEmail[] @relation("ProductSeniorLeaderEmailCreator")
  createdCommsPlanProducts         ProductCommsPlan[]         @relation("ProductCommsPlanCreator")

  // News Artifact Relations
  createdCompanyNewsArtifacts CompanyNewsArtifact[] @relation("CompanyNewsArtifactCreator")

  // Memo & LinkedIn Relations
  memos         Memo[]         @relation("WorkMeMemos")
  linkedInPosts LinkedInPost[] @relation("WorkMeLinkedInPosts")

  // Work Value Model Relations
  skillTopics           SkillTopic[]
  myContributions       MyContribution[]
  contributionSummaries ContributionSummary[]
  brandNarratives       BrandNarrative[]
  brandPositionings     BrandPositioning[]

  // Concept Draft Relations
  conceptDrafts ConceptDraft[] @relation("WorkMeConceptDrafts")

  @@index([handle])
  @@index([companyId])
  @@index([companyUnit])
}

// ============================================
// WORK PROFILE MODEL (Professional Identity - "What I Do")
// ============================================
model WorkProfile {
  id       String @id @default(uuid())
  workMeId String @unique @db.Uuid

  jobRole               String?
  industry              String?
  salaryRange           String?
  responsibilitySummary String?
  seniority             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// ENUMS
// ============================================
enum EventAudience {
  ALL_WORKFORCE
  LEADERS
  WORKFORCE_AND_FAMILIES
  COMMUNITY
}

enum EventCategory {
  CELEBRATION
  HERITAGE
  COMMUNITY
  RECOGNITION
  APPRECIATION
  FAMILY
}

enum DigitalSignType {
  WORKFORCE
  COMPANY_NEWS
  WORKFORCE_ACHIEVEMENT
  COMPANY_EVENT
}

enum DesignWorkPackageStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  REVISION_REQUESTED
  COMPLETE
}

enum WorkforceStuffStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  EXPIRED
}

enum PressureSource {
  CONGRESS
  EXECUTIVE_BRANCH
  OSD
  NAVSEA_LEADERSHIP
  PEO
  POLICY
  BUDGET
  GAO
  INDUSTRY
  OPERATIONS
  TECHNOLOGY
  CYBER
}

// Workforce Concern Type: Perceptual lenses for why pressures bother people
// JOB_SECURITY: "Will I still have a job?"
// ROLE_CLARITY: "What is my role / does it still matter?"
// FAIRNESS: "Is the burden shared equitably?"
// ADMIN_FRICTION: "Why is it harder to do my job?"
// TRUST_CREDIBILITY: "Do leadership actions match reality?"
enum WorkforceConcernType {
  JOB_SECURITY
  ROLE_CLARITY
  FAIRNESS
  ADMIN_FRICTION
  TRUST_CREDIBILITY
}

enum CommsPlanType {
  WORKFORCE_CONCERN // Address workforce concerns/pressures
  EVENT // Address company events
  GENERAL // General purpose comms plan
}

enum PlatformMilestoneType {
  CONTRACT_AWARDED
  KEEL_LAYING
  HULL_COMPLETION
  LAUNCH
  SEA_TRIALS
  DELIVERY
  COMMISSIONING
}

enum SeniorLeaderRole {
  SES
  DIRECTOR
  DEPUTY_DIRECTOR
  EXECUTIVE_DIRECTOR
  CHIEF
  DEPUTY_CHIEF
  COMMANDER
  DEPUTY_COMMANDER
  OTHER
}

// ============================================
// WORKME COMPANY MODEL (Silent Background Tag)
// ============================================
// WorkMeCompany exists ONLY as a silent tag for tenant partitioning.
// It does NOT affect routing, hydration, API shape, permissions, or component logic.
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees WorkMe[]

  @@map("workme_company")
}

// ============================================
// COMPANY MODEL (Independent Entity)
// ============================================
model Company {
  id           String        @id @default(uuid())
  name         String        @unique
  industry     String?
  website      String?
  city         String?
  state        String?
  description  String?
  headcount    Int?
  companyType  CompanyType?
  revenueRange RevenueRange?
  createdAt    DateTime      @default(now())

  // Identity (Apollo Enrichment)
  missionStatement    String?
  vision              String?
  values              String?
  brandTagline        String?
  brandLogoUrl        String?
  brandColorPrimary   String?
  brandColorSecondary String?

  // Leadership (Apollo Enrichment)
  ceoName      String?
  ceoTitle     String?
  deputyName   String?
  deputyTitle  String?
  chiefOfStaff String?

  // Organization (Apollo Enrichment)
  directorates String[] @default([])

  // Social / Public (Apollo Enrichment)
  linkedinUrl String?
  twitterUrl  String?
  facebookUrl String?
  phone       String?

  // Address (Apollo Enrichment)
  country String?

  // Relations
  members           WorkMe[]
  workplaces        Workplace[]
  employees         CompanyEmployee[]
  highlights        CompanyEmployeeHighlight[]
  unitHighlights    CompanyUnitHighlight[]
  milestones        CompanyMilestone[]
  campaigns         CompanyCampaign[]          @relation("CompanyCampaignCompany")
  impactEvents      CompanyImpactEvent[]       @relation("CompanyImpactEventCompany")
  trainings         CompanyTraining[]          @relation("CompanyTrainingCompany")
  events            CompanyEvent[]             @relation("CompanyEventCompany")
  leaderEngagements CompanyLeaderEngagement[]  @relation("CompanyLeaderEngagementCompany")
  communities       CompanyCommunity[]         @relation("CompanyCommunityCompany")
  benefits          CompanyBenefits[]          @relation("CompanyBenefitsCompany")
  careers           CompanyCareer[]            @relation("CompanyCareerCompany")
  employeeCauses    CompanyEmployeeCause[]     @relation("CompanyEmployeeCauseCompany")
  productFamilies   ProductFamily[]
  platformProducts  CompanyPlatformProduct[]
  newsArtifacts     CompanyNewsArtifact[]
  articleCategories ArticleCategory[]
  externalEnv       CompanyExternalEnv[]
  companyWork       CompanyWork[]
  conceptDrafts     ConceptDraft[]

  @@index([name])
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// WORK ENTRY MODEL (Work History)
// ============================================
model WorkEntry {
  id          String    @id @default(uuid())
  workMeId    String    @db.Uuid
  companyName String?
  title       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([startDate])
  @@index([endDate])
}

// ============================================
// WORK SKILLS MODEL
// ============================================
model WorkSkills {
  id             String  @id @default(uuid())
  workMeId       String  @unique @db.Uuid
  skillsRaw      String?
  strengthsRaw   String?
  specialties    String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// WORKPLACE MODEL
// ============================================
model Workplace {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe  WorkMe  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workMeId, companyId])
  @@index([workMeId])
  @@index([companyId])
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("CommsOutputOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Objective {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("ObjectiveOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title       String
  description String?
  howMeasured String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Achievement {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String  @db.Uuid
  originator   WorkMe  @relation("AchievementOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title    String
  category AchievementCategory

  audienceName String?
  audienceSize Int?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  commsOutputId String?
  commsOutput   CommsOutput? @relation(fields: [commsOutputId], references: [id], onDelete: SetNull)

  whatYouDid String
  frequency  String?
  volume     Int?

  processSteps Json?
  impact       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyUnit])
  @@index([originatorId])
  @@index([category])
}

// ============================================
// COMPANY MODELS (CompanyX)
// ============================================

model CompanyCampaign {
  id          String               @id @default(cuid())
  createdAt   DateTime             @default(now())
  status      WorkforceStuffStatus @default(ACTIVE)
  title       String
  description String?

  // Standardized CompanyX Fields
  windowStart DateTime? // Date field (standardized - window start)
  windowEnd   DateTime? // Date field (standardized - window end)
  location    String? // Location field (standardized) - ADDED

  ctaLink      String?
  sponsor      String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  ingestRawText String?
  summary       String?

  // Standardized Relations
  companyId String?
  company   Company? @relation("CompanyCampaignCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid
  workMe    WorkMe   @relation("CompanyCampaignWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  emailDigestItems EmailDigestItem[]                  @relation("EmailDigestItemCampaign")
  productSeniorLeaderEmails ProductSeniorLeaderEmail[] @relation("ProductSeniorLeaderEmailCampaign")
  companyWork      CompanyWork[]                      @relation
  myContributions  MyContribution[]
  digitalSigns     ProductDigitalSignWorkforceStuff[] @relation

  @@index([companyId])
  @@index([workMeId])
  @@index([status])
}

model CompanyImpactEvent {
  id          String               @id @default(cuid())
  createdAt   DateTime             @default(now())
  status      WorkforceStuffStatus @default(ACTIVE)
  title       String
  description String?

  // Standardized CompanyX Fields
  effectiveDate DateTime? // Date field (standardized)
  location      String? // Location field (standardized) - ADDED

  impactedPopulation String?
  urgency            String?
  pocFirstName       String?
  pocLastName        String?
  pocEmail           String?
  pocPhone           String?

  ingestRawText String?
  summary       String?

  // Standardized Relations
  companyId String?
  company   Company? @relation("CompanyImpactEventCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid
  workMe    WorkMe   @relation("CompanyImpactEventWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  emailDigestItems                 EmailDigestItem[]                  @relation("EmailDigestItemImpactEvent")
  productSeniorLeaderEmails        ProductSeniorLeaderEmail[]        @relation("ProductSeniorLeaderEmailImpactEvent")
  companyWork                      CompanyWork[]                      @relation
  myContributions                  MyContribution[]
  ProductDigitalSignWorkforceStuff ProductDigitalSignWorkforceStuff[]

  @@index([companyId])
  @@index([workMeId])
  @@index([status])
}

model CompanyTraining {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  status    WorkforceStuffStatus @default(ACTIVE)

  title            String?
  topic            String?
  description      String?
  mandatory        Boolean @default(false)
  sponsoringOffice String?

  trainingDate         DateTime? // For scheduled training events (primary date when timeSlots omit date)
  startTime            String? // Legacy single slot; use timeSlots for multiple
  endTime              String?
  timeSlots            Json? // Array of { date?: string, startTime: string, endTime: string, label?: string } — "add more times"
  completionDeadline   DateTime? // For self-paced training: deadline to complete by
  isSelfPaced          Boolean   @default(false) // True if training is self-paced (no fixed schedule)
  registrationDeadline DateTime? // Deadline to register (e.g. "Registration deadline is Feb. 9")

  location          String?
  format            String?
  link              String? // Primary/legacy registration or livestream link
  registrationLinks Json? // Array of { label?: string, url: string } for multiple registration links (e.g. civilians/military vs contractors)

  pocFirstName   String?
  pocLastName    String?
  pocEmail       String?
  pocPhone       String?
  pocRankOrTitle String?

  ingestRawText   String?
  ingestType      String?
  ingestStatus    String?   @default("pending")
  ingestCreatedAt DateTime? @default(now())

  summary String?

  companyId String?
  company   Company? @relation("CompanyTrainingCompany", fields: [companyId], references: [id], onDelete: SetNull)
  workMeId  String   @db.Uuid
  workMe    WorkMe   @relation("CompanyTrainingWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  emailDigestItems                 EmailDigestItem[]                  @relation("EmailDigestItemTraining")
  productSeniorLeaderEmails        ProductSeniorLeaderEmail[]        @relation("ProductSeniorLeaderEmailTraining")
  companyWork                      CompanyWork[]                      @relation
  myContributions                  MyContribution[]
  ProductDigitalSignWorkforceStuff ProductDigitalSignWorkforceStuff[]

  @@index([companyId])
  @@index([workMeId])
  @@index([status])
}


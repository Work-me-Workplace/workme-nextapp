  @@index([fullName])
}

// ============================================
// COMPANY MILESTONE MODEL
// ============================================
// BIG PICTURE company-wide milestones ONLY
// 
// CRITICAL: This model is for COMPANY-WIDE milestones (entire company does something)
// NOT for platform-specific events (ship commissioning, keel laying, etc.)
// Platform-specific events should use CompanyPlatformUnitUpdate instead
//
// Examples of BIG PICTURE milestones:
// - Company-wide reorganizations or restructuring
// - Major company-wide contract awards (affecting entire company)
// - Company-wide strategic initiatives or launches
// - Company mergers or acquisitions
// - Company-wide achievements (e.g., "Company reaches 10,000 employees")
// - Company-wide policy changes
//
// OWNERSHIP: CompanyMilestone is owned by Company (companyId REQUIRED)
// 
// CONTEXT: platformUnitId is OPTIONAL - only for HUGE company-wide events that happen to involve a specific unit
// Examples: "Carrier flew its first mission", "First submarine completed circumnavigation"
// CRITICAL: Do NOT auto-create company milestones from unit updates - only manual creation
// PROVENANCE: updateId is OPTIONAL - links back to the update that triggered this milestone
// 
// Milestones may exist:
// - without updates (manual creation)
// - with or without platformUnitId (company-wide milestones can reference a unit if it's a huge event)
// 
// INFERENCE RULE (future enforcement):
// If milestoneType === KEEL_LAYING, the platform unit should have a CompanyPlatformUnitLivingHomage.
// This ensures narrative signal is preserved and never reduced to "keel laid".
// The system should never again flatten these moments—they carry human meaning.
// 
// This model drives downstream:
// - digital signage language (foregrounding people, not steel)
// - recognition-first layouts
// - AI-generated comms that preserve narrative context
// 
// Note: Namesake and LivingHomage are now properties of the platform unit itself,
// accessed via platformUnit.namesake and platformUnit.livingHomage
model CompanyMilestone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership - Company owns the milestone
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // General milestone information
  title         String // e.g., "USS Barb (SSN-804) Keel Laying"
  category      String? // e.g., "Platform", "Business", "Strategy"
  milestoneType String? // free-text or derived label (e.g., "KEEL_LAYING", "Product Launch", "Merger")
  date          DateTime?
  description   String?
  sourceUrl     String?

  // Optional contextual linkage (for HUGE company-wide events that happen to involve a specific unit)
  // e.g., "Carrier flew its first mission" - this is a company milestone, but involves a specific unit
  // CRITICAL: Do NOT auto-create company milestones from unit updates - only manual creation
  platformUnitId String?
  platformUnit   CompanyPlatformUnit? @relation(fields: [platformUnitId], references: [id], onDelete: SetNull)

  // Optional provenance linkage (which update triggered this milestone)
  updateId String?                    @unique
  update   CompanyPlatformUnitUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)

  // Optional news artifact linkage (press releases, articles, etc.)
  newsArtifactId String?
  newsArtifact   CompanyNewsArtifact? @relation(fields: [newsArtifactId], references: [id], onDelete: SetNull)

  // Reverse relation from CompanyExternalEnv
  externalEnv CompanyExternalEnv[] @relation("CompanyExternalEnvMilestone")

  @@index([companyId])
  @@index([platformUnitId])
  @@index([category])
  @@index([milestoneType])
  @@index([date])
  @@index([newsArtifactId])
}


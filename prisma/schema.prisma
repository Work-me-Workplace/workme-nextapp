  createdAt        DateTime  @default(now())
  title            String
  description      String?
  trainingDate     DateTime?
  deadline         DateTime?
  link             String?
  mandatory        Boolean   @default(false)
  sponsoringOffice String?
  pocFirstName     String?
  pocLastName      String?
  pocEmail         String?
  pocPhone         String?

  companyId    String?
  company      Company? @relation("WorkContextTrainingCompany", fields: [companyId], references: [id], onDelete: Cascade)
  originatorId    String?
  originator   WorkMe?  @relation("WorkContextTrainingOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([originatorId])
}

model WorkContextEvent {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  eventCategory String?
  pocFirstName  String?
  pocLastName   String?
  pocEmail      String?
  pocPhone      String?

  companyId    String?
  company      Company? @relation("WorkContextEventCompany", fields: [companyId], references: [id], onDelete: Cascade)
  originatorId    String?
  originator   WorkMe?  @relation("WorkContextEventOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([originatorId])
}

model WorkContextCommunity {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  partnerOrg   String?
  date         DateTime?
  location     String?
  signUpLink   String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  companyId    String?
  company      Company? @relation("WorkContextCommunityCompany", fields: [companyId], references: [id], onDelete: Cascade)
  originatorId    String?
  originator   WorkMe?  @relation("WorkContextCommunityOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([originatorId])

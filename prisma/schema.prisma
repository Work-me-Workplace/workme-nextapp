// ============================================
// ARTICLE CATEGORY MODEL (Organization for Articles)
// ============================================
// Categories to organize articles (e.g., "Shipbuilding", "Portfolio Acquisition Executive")
// ONE category per article - forces thoughtful organization, prevents chaos/overlap
// This is NOT tags - it's a single organizational bucket that makes users think

model ArticleCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String // "Shipbuilding", "Portfolio Acquisition Executive", etc.
  description String? // Optional description of what this category is for
  color       String? // Optional color code for UI (e.g., "#3B82F6" for blue)

  // Relations - one-to-many (one category has many articles)
  articles CompanyNewsArtifact[]

  @@index([companyId])
  @@index([name])
}

// ============================================
// COMPANY NEWS ARTIFACT MODEL (Universal Article/Press Release Storage)
// ============================================
// Universal staging area for news articles and press releases
// Can be used by platform statements, unit statements, updates, etc.
// Similar to SignalArtifact but for news/press content

model CompanyNewsArtifact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Article metadata
  sourceName String? // "USNI News", "HII Release", "DoD Release"
  sourceUrl  String? // URL of the article/press release
  headline   String? // Article headline or title

  // Content
  rawText   String // Full article/press release text
  aiSummary String? // AI-generated one paragraph summary

  // Article Intelligence
  artifactType    String? // "unit_update", "milestone", "workforce", "leadership", etc.
  sentiment       String? // "positive", "negative", "neutral"
  humanElements   Json? // e.g., {"sponsor": "Pamela Bove", "leaders": ["SECNAV"], "attendees": [...]}
  noteworthyItems Json? // e.g., {"key_facts": [...], "dates": [...], "milestones": [...]}
  leaderStatement Json? // e.g., {"statement": "...", "leader": "SECNAV Del Toro", "role": "Secretary of the Navy"}

  // Organization - ONE category per article (forces thoughtful organization)
  categoryId String? // Optional category - but if set, only ONE category
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Optional: Link to who created/ingested it
  createdByWorkMeId String? @db.Uuid
  createdBy         WorkMe? @relation("CompanyNewsArtifactCreator", fields: [createdByWorkMeId], references: [id], onDelete: SetNull)

  // Relations - can be used by multiple entities
  platformStatements     CompanyPlatformStatement[]
  platformUnitStatements CompanyPlatformUnitStatement[]
  milestones             CompanyMilestone[]
  externalEnv            CompanyExternalEnv[]           @relation("CompanyExternalEnvNewsArtifact")

  @@index([companyId])
  @@index([sourceName])
  @@index([sourceUrl])
  @@index([artifactType])
  @@index([sentiment])
  @@index([createdByWorkMeId])
  @@index([createdAt])
}

// ============================================
// COMPANY EXTERNAL ENVIRONMENT MODEL
// ============================================
// Tracks external signals, factors, and developments affecting the company
// Can be opportunities, threats, trends, regulatory changes, etc.
// Company-wide (not user-specific like ExternalCompanyPressure)
model CompanyExternalEnv {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workMeId  String  @db.Uuid
  workMe    WorkMe  @relation("CompanyExternalEnvWorkMe", fields: [workMeId], references: [id], onDelete: Cascade)

  // Signal basics
  source   String // e.g., "GAO", "Congress", "Industry", "DoD", "Navy"
  category String? // e.g., "Budget", "Legislation", "Testing", "Ops", "Regulatory"
  summary  String // Description of the external signal/development
  impact   String? // Why this matters, what it means, significance

  // 🔍 Change Intelligence
  deltaSummary           String? // What materially changed vs prior state
  implementationTimeline String? // When this starts to matter (plain language)
  leadAuthority          String? // Who owns/drives this change

  // Metadata
  confidenceLevel String? // "low" | "medium" | "high" (optional, future-safe)
  timeHorizon     String? // "immediate" | "near-term" | "long-term" (optional)

  // Optional contextual linkage (not ownership)
  platformUnitId String?
  platformUnit   CompanyPlatformUnit? @relation("CompanyExternalEnvPlatformUnit", fields: [platformUnitId], references: [id], onDelete: SetNull)

  platformProductId String?
  platformProduct   CompanyPlatformProduct? @relation("CompanyExternalEnvPlatformProduct", fields: [platformProductId], references: [id], onDelete: SetNull)

  // Optional provenance linkage (which news artifact triggered this)
  newsArtifactId String?
  newsArtifact   CompanyNewsArtifact? @relation("CompanyExternalEnvNewsArtifact", fields: [newsArtifactId], references: [id], onDelete: SetNull)

  // Optional milestone linkage (if this relates to a milestone)
  milestoneId String?
  milestone   CompanyMilestone? @relation("CompanyExternalEnvMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([workMeId])
  @@index([source])
  @@index([category])
  @@index([platformUnitId])
  @@index([platformProductId])
  @@index([newsArtifactId])
  @@index([milestoneId])
  @@index([createdAt])
}

// ============================================
// SIGNAL ARTIFACT MODELS (Scratchpad + Lens)
// ============================================
// SignalArtifact = raw memory, immutable, no intelligence
// SeniorLeaderTopic = lightweight interpretation, not truth
// This is a thin, non-authoritative layer - scaffolding only

model SignalArtifact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title             String?
  content           String // full pasted text, untouched
  saidBy            String? // free text for now ("Chris Miller")
  role              String? // optional
  source            String? // "senior_leader_email", "speech", etc.
  createdByWorkMeId String? @db.Uuid // if user pasted it

  // Relations
  topics SeniorLeaderTopic[]

  @@index([createdByWorkMeId])
  @@index([source])
  @@index([createdAt])
}

model SeniorLeaderTopic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Can belong to either SignalArtifact (raw signal) or ProductSeniorLeaderEmail (product)
  signalArtifactId String?
  signalArtifact   SignalArtifact? @relation(fields: [signalArtifactId], references: [id], onDelete: Cascade)

  seniorLeaderEmailProductId String?
  seniorLeaderEmailProduct   ProductSeniorLeaderEmail? @relation(fields: [seniorLeaderEmailProductId], references: [id], onDelete: Cascade)

  topic       String // e.g. "Product Change", "Leadership Transition"
  description String? // short human-readable explanation

  @@index([signalArtifactId])
  @@index([seniorLeaderEmailProductId])
  @@index([createdAt])
}

// ============================================
// SENIOR LEADER EMAIL PRODUCT MODEL (MyWork)
// ============================================
// Product artifact for senior leader emails - "what did the boss say"
// This is a PRODUCT, not a signal
// Always includes topic parsing (SeniorLeaderTopics)
//
// ARCHITECTURAL NOTE:
// ProductSeniorLeaderEmailContent references CompanyEmployee via companyEmployeeId.
// CompanyEmployee is the single source of truth for all company people.
// Role enum (SeniorLeaderRole) is context only, not identity.
model ProductSeniorLeaderEmail {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When archived, null if active

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("ProductSeniorLeaderEmailCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // Link to workforcestuff (one of these will be set, or null if not derived from workforcestuff)
  companyEventId            String?
  companyCampaignId         String?
  companyTrainingId         String?
  companyBenefitsId         String?
  companyImpactEventId      String?
  companyCommunityId        String?
  companyCareerId           String?
  companyEmployeeCauseId    String?
  companyLeaderEngagementId String?

  // Relations to workforcestuff (nullable)
  companyEvent            CompanyEvent?            @relation("ProductSeniorLeaderEmailEvent", fields: [companyEventId], references: [id], onDelete: SetNull)
  companyCampaign         CompanyCampaign?         @relation("ProductSeniorLeaderEmailCampaign", fields: [companyCampaignId], references: [id], onDelete: SetNull)
  companyTraining         CompanyTraining?         @relation("ProductSeniorLeaderEmailTraining", fields: [companyTrainingId], references: [id], onDelete: SetNull)
  companyBenefits         CompanyBenefits?         @relation("ProductSeniorLeaderEmailBenefits", fields: [companyBenefitsId], references: [id], onDelete: SetNull)
  companyImpactEvent      CompanyImpactEvent?      @relation("ProductSeniorLeaderEmailImpactEvent", fields: [companyImpactEventId], references: [id], onDelete: SetNull)
  companyCommunity        CompanyCommunity?        @relation("ProductSeniorLeaderEmailCommunity", fields: [companyCommunityId], references: [id], onDelete: SetNull)
  companyCareer           CompanyCareer?           @relation("ProductSeniorLeaderEmailCareer", fields: [companyCareerId], references: [id], onDelete: SetNull)
  companyEmployeeCause    CompanyEmployeeCause?    @relation("ProductSeniorLeaderEmailEmployeeCause", fields: [companyEmployeeCauseId], references: [id], onDelete: SetNull)
  companyLeaderEngagement CompanyLeaderEngagement? @relation("ProductSeniorLeaderEmailLeaderEngagement", fields: [companyLeaderEngagementId], references: [id], onDelete: SetNull)

  // Typed variant (1:1 relationship)
  content ProductSeniorLeaderEmailContent?

  // Parsed topics (always present for products)
  topics SeniorLeaderTopic[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([archivedAt])
  @@index([companyEventId])
  @@index([companyCampaignId])
  @@index([companyTrainingId])
  @@index([companyBenefitsId])
  @@index([companyImpactEventId])
  @@index([companyCommunityId])
  @@index([companyCareerId])
  @@index([companyEmployeeCauseId])
  @@index([companyLeaderEngagementId])
}

model ProductSeniorLeaderEmailContent {
  id                         String @id @default(cuid())
  seniorLeaderEmailProductId String @unique

  title             String?
  actualSubjectLine String? // actual email subject line
  content           String // full pasted text, untouched (BodyofEmail)

  // Role enum - user selects this first, then looks up people
  role SeniorLeaderRole

  // Reference to CompanyEmployee (the actual person selected after role lookup)
  companyEmployeeId String?
  companyEmployee   CompanyEmployee? @relation(fields: [companyEmployeeId], references: [id], onDelete: SetNull)

  product ProductSeniorLeaderEmail @relation(fields: [seniorLeaderEmailProductId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([companyEmployeeId])
}

// ============================================
// COMMS PLAN PRODUCT MODEL
// ============================================
model ProductCommsPlan {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When archived, null if active

  companyUnit       String?
  createdByWorkMeId String  @db.Uuid
  createdBy         WorkMe  @relation("ProductCommsPlanCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // Comms plan type (what it addresses)
  type CommsPlanType @default(GENERAL)

  // Link to ExternalCompanyPressure (for WORKFORCE_CONCERN type)
  externalCompanyPressureId String?
  externalCompanyPressure   ExternalCompanyPressure? @relation(fields: [externalCompanyPressureId], references: [id], onDelete: SetNull)

  // Background/context section - historical context from linked pressures or manual input
  background String? // Full historical context/background for the comms plan

  // Raw text input (user pastes raw text)
  rawText String?

  // Structured parsed fields (from AI parsing)
  parsedTitle      String?
  parsedObjectives Json? // Array of objectives
  parsedMessages   Json? // Array of messages
  parsedTactics    Json? // Array of tactics
  parsedTimeline   Json? // Timeline/product matrix structure

  // Full generated comms plan (JSON/text for Word doc export)
  fullText String? // Generated full comms plan text/JSON

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([archivedAt])
  @@index([type])
  @@index([externalCompanyPressureId])
}

// ============================================
// PRODUCT FAMILY MODEL
// ============================================
// ProductFamily represents a high-level product concept or program
// (e.g., "Golden Fleet", "Virginia-class", "Columbia Program")
// Can optionally belong to a Company, but exists independently
model ProductFamily {
  id          String              @id @default(cuid())
  companyId   String?
  name        String
  description String?
  status      ProductFamilyStatus @default(CONCEPT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  evidence ExternalEvidence[]

  @@index([companyId])
  @@index([name])
  @@index([status])
}

enum ProductFamilyStatus {
  CONCEPT
  ADVOCATED
  PROGRAM
}

// ============================================
// EXTERNAL EVIDENCE MODEL
// ============================================
// External evidence from publicly verifiable sources (OSINT)
// Always belongs to a ProductFamily (required anchor point)
// Can optionally link to a CompanyPlatformProduct for additional context
model ExternalEvidence {
  id                String    @id @default(cuid())
  productFamilyId   String // REQUIRED - evidence must belong to a ProductFamily
  productPlatformId String? // OPTIONAL - can link to CompanyPlatformProduct for context
  title             String
  url               String
  publisher         String?
  publishedAt       DateTime?
  snippet           String?
  capturedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  productFamily   ProductFamily           @relation(fields: [productFamilyId], references: [id], onDelete: Cascade)
  productPlatform CompanyPlatformProduct? @relation(fields: [productPlatformId], references: [id], onDelete: SetNull)

  classifications EvidenceClassification[]

  @@index([productFamilyId])
  @@index([productPlatformId])
  @@index([url])
  @@index([capturedAt])
}

// ============================================
// EVIDENCE CLASSIFICATION MODEL
// ============================================
// Optional inferred classifications for evidence
// Only stored after user confirmation (confirmedByUser = true)
model EvidenceClassification {
  id                 String                     @id @default(cuid())
  evidenceId         String
  classificationType EvidenceClassificationType
  confirmedByUser    Boolean                    @default(false)
  createdAt          DateTime                   @default(now())

  evidence ExternalEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, classificationType])
  @@index([evidenceId])
  @@index([classificationType])
  @@index([confirmedByUser])
}

enum EvidenceClassificationType {
  COMPANY_PRODUCTS
  COMPANY_PUBLIC_PERCEPTION
  EXTERNAL_COMPANY_PRESSURE
}

// ============================================
// PLANNER MODELS (Conceptual Planning Staging Area)
// ============================================
// Planner is a staging area for future ideas - NOT a calendar, NOT a task manager, NOT a source of truth
// PlannedItem OWNS time. PlannerContainer range is DERIVED later (do not store start/end).

model PlannerContainer {
  id             String   @id @default(cuid())
  name           String
  description    String?
  timeframeLabel String? // e.g. "2026", "Q2 2026", "Rolling"
  companyId      String
  divisionUnitId String?
  ownerUserId    String
  createdAt      DateTime @default(now())

  items PlannedItem[]

  @@index([companyId])
  @@index([ownerUserId])
  @@index([createdAt])
}

model PlannedItem {
  id                 String           @id @default(cuid())
  plannerContainerId String
  plannerContainer   PlannerContainer @relation(fields: [plannerContainerId], references: [id], onDelete: Cascade)

  companyId      String
  divisionUnitId String?

  // Optional source links (nullable FK placeholders)
  sourceEventId    String?
  sourceCampaignId String?
  sourceProgramId  String?

  itemKind    String // e.g. "event", "series", "campaign", free text
  title       String
  description String?

  plannedTimeLabel  String // REQUIRED human-readable time, e.g. "Q2 2026", "Spring"
  plannedTimeAnchor DateTime? // nullable, for sorting only

  notes String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([plannerContainerId])
  @@index([companyId])
  @@index([createdByUserId])
  @@index([plannedTimeAnchor])
  @@index([createdAt])
}

// ============================================
// SENIOR LEADER DIGEST MODELS
// ============================================

enum DigestStatus {
  DRAFT
  GENERATED
  SENT
}

enum DigestEntryType {
  DELIVERY
  WIN
  WORKFORCE
  REMINDER
}

enum DigestSourceType {
  COMPANY_UNIT
  PLATFORM_UNIT
  EVENT
  MILESTONE
  WORKFORCE
  MANUAL
}

model SeniorLeaderDigest {
  id             String       @id @default(cuid())
  leaderName     String
  leaderRole     String
  organizationId String
  weekOf         DateTime
  subjectLine    String?
  openingNote    String? // AI-generated, editable
  status         DigestStatus @default(DRAFT)

  entries SeniorLeaderDigestEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([weekOf])
  @@index([status])
  @@index([createdAt])
}

model SeniorLeaderDigestEntry {
  id          String            @id @default(cuid())
  digestId    String
  type        DigestEntryType
  title       String
  description String?
  sourceType  DigestSourceType?
  sourceId    String?

  orderIndex Int

  digest SeniorLeaderDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@index([digestId])
  @@index([type])
  @@index([orderIndex])
}

// ============================================
// MEMO & LINKEDIN POST MODELS
// ============================================
// Memo = Human source of truth for work moments
// LinkedInPost = Distribution artifact (user-approved posts)

enum MemoContextType {
  EVENT
  MEETING
  DELIVERY
  RECOGNITION
  OTHER
}

enum LinkedInPostStatus {
  DRAFT
  POSTED
  FAILED
}

model Memo {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When did this actually happen (can differ from createdAt)
  happenedAt DateTime @default(now())

  // Structured Reflection (the narrative)
  whatHappened String // Factual description
  whySpecial   String? // Why this moment mattered
  myRole       String? // How the user contributed
  impact       String? // Outcome or effect
  thoughts     String? // Optional reflection / emotion

  // Context
  contextType MemoContextType @default(OTHER)

  // Relations
  workMe        WorkMe         @relation("WorkMeMemos", fields: [workMeId], references: [id], onDelete: Cascade)
  linkedInPosts LinkedInPost[]
  skillItems    SkillItem[]

  @@index([workMeId])
  @@index([happenedAt])
  @@index([contextType])
  @@index([createdAt])
}

model LinkedInPost {
  id        String   @id @default(cuid())
  workMeId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation (nullable - can create post without memo)
  memoId String?
  memo   Memo?   @relation(fields: [memoId], references: [id], onDelete: SetNull)

  // Content
  title   String? // Internal label (optional)
  content String // Final, edited, user-approved text

  // State
  status          LinkedInPostStatus @default(DRAFT)
  postedAt        DateTime?
  linkedinPostUrn String? // LinkedIn's unique identifier
  errorMessage    String? // If posting failed

  // Relations
  workMe WorkMe @relation("WorkMeLinkedInPosts", fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([memoId])
  @@index([status])
  @@index([postedAt])
  @@index([createdAt])
}

// ============================================
// WORK VALUE MODEL SYSTEM (SkillTopics as North Star)
// ============================================
// This system models durable professional value in a way that supports:
// - growth tracking
// - portability outside the organization
// - annual assessments
// - personal branding
// - AI-generated reflections and blogs
//
// CORE PRINCIPLE: SkillTopics are the North Star. Everything else is a consumer.

// ============================================
// 1. CORE DOMAIN MODELS (FOUNDATION)
// ============================================

// SkillTopic = PRIMARY semantic unit (10,000 ft altitude)
// Represents a durable capability (e.g. Narrative Development, Trust Preservation)
// Stable across roles, orgs, and time. Used for growth reflection and portability assessment.
model SkillTopic {
  id          String  @id @default(uuid()) @db.Uuid
  workMeId    String  @db.Uuid
  title       String // e.g. "Narrative Development", "Trust Preservation"
  description String? // Human-readable explanation of what this capability means
  category    String? // Optional categorization (e.g. "Communication", "Leadership", "Technical")

  // Growth tracking
  firstDemonstratedAt DateTime? // When was the first SkillItem attached?
  lastDemonstratedAt  DateTime? // When was the most recent SkillItem attached?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workMe          WorkMe                  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  skillItems      SkillItem[] // Evidence-level executions
  marketValues    SkillTopicMarketValue[] // Market relevance
  pivotFrom       SkillTopicPivot[]       @relation("SkillTopicPivotFrom")
  pivotTo         SkillTopicPivot[]       @relation("SkillTopicPivotTo")
  // Note: ContributionSummary uses skillTopicIds array, not a direct relation
  brandNarratives BrandNarrative[]

  @@index([workMeId])
  @@index([title])
  @@index([category])
  @@index([firstDemonstratedAt])
  @@index([lastDemonstratedAt])
}

// SkillItem = Evidence-level (1,000 ft altitude)
// Concrete executions (emails, events, artifacts)
// Always attached to exactly one SkillTopic
// No naked skills without evidence
model SkillItem {
  id           String @id @default(uuid())
  skillTopicId String @db.Uuid

  // Evidence description
  title        String // Brief description of the evidence
  description  String? // Detailed description of what was done
  evidenceType String? // "email", "event", "artifact", "meeting", "delivery", etc.

  // When this evidence occurred
  occurredAt DateTime @default(now())

  // Optional reference to company work (doesn't claim ownership, just references)
  companyWorkId String?
  companyWork   CompanyWork? @relation(fields: [companyWorkId], references: [id], onDelete: SetNull)

  // Optional reference to personal work
  memoId String?
  memo   Memo?   @relation(fields: [memoId], references: [id], onDelete: SetNull)

  // Relations
  skillTopic SkillTopic @relation(fields: [skillTopicId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillTopicId])
  @@index([occurredAt])
  @@index([companyWorkId])
  @@index([evidenceType])
  @@index([memoId])
}

// ============================================
// 2. MARKET VALUE INTELLIGENCE LAYER (BELAYER)
// ============================================
// Market value is contextual and volatile. It must not redefine the user's identity.
// It should answer: "Where does this SkillTopic currently matter?"

// MarketNeed = Market contexts where skills matter
// e.g. "Change Enablement", "Tech Adoption", "Crisis Communication"
model MarketNeed {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "Change Enablement"
  description String? // What this market need represents
  category    String? // Optional categorization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skillTopicValues SkillTopicMarketValue[]

  @@index([name])
  @@index([category])
}

// SkillTopicMarketValue = Join model connecting SkillTopics to MarketNeeds
// Qualitative relevance, not scored rankings
model SkillTopicMarketValue {
  id           String @id @default(uuid())
  skillTopicId String @db.Uuid
  marketNeedId String

  // Qualitative relevance (NOT a score)
  relevanceLevel String? // "high", "medium", "emerging", "declining" - qualitative only
  useCases       String[] @default([]) // Array of specific use cases where this skill matters
  rationale      String? // WHY the skill matters in this market context

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skillTopic SkillTopic @relation(fields: [skillTopicId], references: [id], onDelete: Cascade)
  marketNeed MarketNeed @relation(fields: [marketNeedId], references: [id], onDelete: Cascade)

  @@unique([skillTopicId, marketNeedId])
  @@index([skillTopicId])
  @@index([marketNeedId])
  @@index([relevanceLevel])
}

// ============================================
// 3. ADJACENT PIVOTS (MOBILITY WITHOUT REINVENTION)
// ============================================
// Pivots explain mobility, not reinvention.
// They should be suggestible by AI and confirmed by the user.

model SkillTopicPivot {
  id          String @id @default(uuid())
  fromTopicId String @db.Uuid
  toTopicId   String @db.Uuid

  // Pivot metadata
  pivotType  String? // "adjacent", "cross-domain", "up-level"
  rationale  String? // Why this pivot makes sense (e.g. "Both require narrative skills")
  confidence String? // "high", "medium", "low" - user or AI assessment

  // User confirmation
  confirmedByUser Boolean @default(false)
  suggestedByAI   Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fromTopic SkillTopic @relation("SkillTopicPivotFrom", fields: [fromTopicId], references: [id], onDelete: Cascade)
  toTopic   SkillTopic @relation("SkillTopicPivotTo", fields: [toTopicId], references: [id], onDelete: Cascade)

  @@unique([fromTopicId, toTopicId])
  @@index([fromTopicId])
  @@index([toTopicId])
  @@index([pivotType])
  @@index([confirmedByUser])
}

// ============================================
// 4. COMPANY WORK ↔ PERSONAL WORK BRIDGE
// ============================================
// CompanyWork artifacts exist independently.
// Individuals contribute to CompanyWork.
// SkillItems can reference CompanyWork as evidence.

// CompanyWork = Generic container for company-owned work
// This is a polymorphic reference point that can link to specific CompanyX models
model CompanyWork {
  id        String @id @default(uuid())
  companyId String

  // Polymorphic reference (one of these will be set)
  companyEventId            String?
  companyCampaignId         String?
  companyTrainingId         String?
  companyImpactEventId      String?
  companyCommunityId        String?
  companyEmployeeCauseId    String?
  companyBenefitsId         String?
  companyCareerId           String?
  companyLeaderEngagementId String?

  // Generic metadata
  title       String
  description String?
  workType    String? // "event", "campaign", "training", "leaderEngagement", etc.

  // Relations to specific company work types
  companyEvent            CompanyEvent?            @relation(fields: [companyEventId], references: [id], onDelete: SetNull)
  companyCampaign         CompanyCampaign?         @relation(fields: [companyCampaignId], references: [id], onDelete: SetNull)
  companyTraining         CompanyTraining?         @relation(fields: [companyTrainingId], references: [id], onDelete: SetNull)
  companyImpactEvent      CompanyImpactEvent?      @relation(fields: [companyImpactEventId], references: [id], onDelete: SetNull)
  companyCommunity        CompanyCommunity?        @relation(fields: [companyCommunityId], references: [id], onDelete: SetNull)
  companyEmployeeCause    CompanyEmployeeCause?    @relation(fields: [companyEmployeeCauseId], references: [id], onDelete: SetNull)
  companyBenefits         CompanyBenefits?         @relation(fields: [companyBenefitsId], references: [id], onDelete: SetNull)
  companyCareer           CompanyCareer?           @relation(fields: [companyCareerId], references: [id], onDelete: SetNull)
  companyLeaderEngagement CompanyLeaderEngagement? @relation(fields: [companyLeaderEngagementId], references: [id], onDelete: SetNull)
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // SkillItems that reference this work
  skillItems SkillItem[]

  // ContributionSummaries that reference this work
  contributionSummaries ContributionSummary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([workType])
  @@index([companyEventId])
  @@index([companyCampaignId])
}

// MyContribution = User-specific view of their contribution to CompanyX work
// Extracts personal value without claiming ownership
// FK directly to CompanyX models for easier hydration
model MyContribution {
  id       String @id @default(uuid())
  workMeId String @db.Uuid

  // Polymorphic FK to CompanyX models (one of these will be set)
  // CompanyX models ARE the work stuff - no need for CompanyWork abstraction
  companyEventId            String?
  companyCampaignId         String?
  companyTrainingId         String?
  companyImpactEventId      String?
  companyCommunityId        String?
  companyEmployeeCauseId    String?
  companyBenefitsId         String?
  companyCareerId           String?
  companyLeaderEngagementId String?

  // Contribution fields
  title       String? // Contribution title
  description String? // What the user specifically contributed
  whatDid     String? // What did you do?
  results     String? // What were the results/impact?

  // Skills demonstrated (FK to SkillTopic)
  // Link this contribution to skills you demonstrated
  skillTopicIds String[] @default([]) // Array of SkillTopic IDs - what skills did you show?

  // Time bounds
  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  // CompanyX relations
  companyEvent            CompanyEvent?            @relation(fields: [companyEventId], references: [id], onDelete: Cascade)
  companyCampaign         CompanyCampaign?         @relation(fields: [companyCampaignId], references: [id], onDelete: Cascade)
  companyTraining         CompanyTraining?         @relation(fields: [companyTrainingId], references: [id], onDelete: Cascade)
  companyImpactEvent      CompanyImpactEvent?      @relation(fields: [companyImpactEventId], references: [id], onDelete: Cascade)
  companyCommunity        CompanyCommunity?        @relation(fields: [companyCommunityId], references: [id], onDelete: Cascade)
  companyEmployeeCause    CompanyEmployeeCause?    @relation(fields: [companyEmployeeCauseId], references: [id], onDelete: Cascade)
  companyBenefits         CompanyBenefits?         @relation(fields: [companyBenefitsId], references: [id], onDelete: Cascade)
  companyCareer           CompanyCareer?           @relation(fields: [companyCareerId], references: [id], onDelete: Cascade)
  companyLeaderEngagement CompanyLeaderEngagement? @relation(fields: [companyLeaderEngagementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workMeId, companyEventId])
  @@unique([workMeId, companyCampaignId])
  @@unique([workMeId, companyTrainingId])
  @@unique([workMeId, companyImpactEventId])
  @@unique([workMeId, companyCommunityId])
  @@unique([workMeId, companyEmployeeCauseId])
  @@unique([workMeId, companyBenefitsId])
  @@unique([workMeId, companyCareerId])
  @@unique([workMeId, companyLeaderEngagementId])
  @@index([workMeId])
  @@index([companyEventId])
  @@index([companyCampaignId])
  @@index([companyTrainingId])
}

// ============================================
// 5. NATURAL ASSESSMENTS (POST-WORK, NOT PRE-WORK)
// ============================================
// Lightweight assessment model that emerges AFTER work is done.
// No pre-scoring, no performance ratings, no manager-required inputs.

model ContributionSummary {
  id       String @id @default(uuid())
  workMeId String @db.Uuid

  // Time bounds for this summary
  periodStart DateTime
  periodEnd   DateTime
  periodType  String? // "annual", "project", "quarterly", etc.

  // Summary content
  title   String? // e.g. "2025 Annual Contribution Summary"
  summary String? // AI-generated or user-written summary of contributions

  // Attached SkillTopics (what capabilities were demonstrated)
  skillTopicIds String[] @default([]) // Array of SkillTopic IDs

  // Optional project/work context
  companyWorkId String?
  companyWork   CompanyWork? @relation(fields: [companyWorkId], references: [id], onDelete: SetNull)

  // Relations
  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workMeId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([periodType])
  @@index([companyWorkId])
}

// ============================================
// 6. PERSONAL BRANDING MODULE (READ-ONLY CONSUMER)
// ============================================
// Branding does not invent new skills.
// It only translates existing SkillTopics.
// Supports different surfaces (LinkedIn, bio, about section).

model BrandNarrative {
  id           String @id @default(uuid())
  workMeId     String @db.Uuid
  skillTopicId String @db.Uuid

  // Narrative content
  narrative String // How this SkillTopic translates to a brand narrative
  surface   String? // "linkedin", "bio", "about", "portfolio", etc.

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workMe     WorkMe     @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  skillTopic SkillTopic @relation(fields: [skillTopicId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([skillTopicId])
  @@index([surface])
}

model BrandPositioning {
  id       String @id @default(uuid())
  workMeId String @db.Uuid

  // Positioning statement
  positioning String // Overall brand positioning statement
  surface     String? // "linkedin", "bio", "about", etc.

  // Derived from SkillTopics (read-only consumer)
  primarySkillTopicIds String[] @default([]) // Array of SkillTopic IDs that inform this positioning

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([surface])
}

// ============================================
// CONCEPT DRAFT MODEL
// ============================================
// ConceptDraft captures early-stage ideas before they become formal plans
// Minimal, intentional shape - designed to pass the "can I agree with this before any plan exists?" test

enum ConceptDraftStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

model ConceptDraft {
  id        String  @id @default(uuid())
  workMeId  String  @db.Uuid
  companyId String? // Optional - can be personal or company-scoped

  // Core fields (minimal, intentional)
  title       String
  summary     String? // Text field
  howItWorks  String? // Text field
  whoImpacted String[] @default([]) // Array of strings or enum values
  example     String? // Text field

  // Timing fields (soft, flexible - not hard dates)
  timeframe      String? // e.g. "FY25", "CY26", "Next 6–12 months"
  potentialStart String? // e.g. "Post-town hall", "Q2", "After reorg"

  // Status
  status ConceptDraftStatus @default(DRAFT)

  // Relations
  workMe  WorkMe   @relation("WorkMeConceptDrafts", fields: [workMeId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workMeId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

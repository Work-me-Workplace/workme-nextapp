generator client {
  provider = "prisma-client-js"
}

// Switch to PostgreSQL for production/RDS. Set `DATABASE_URL` in environment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER MODEL
// ============================================
model WorkMe {
  id              String         @id @default(uuid())
  firebaseId      String?        @unique
  email           String         @unique
  firstName       String?
  lastName        String?
  photoUrl        String?
  companyUnit     String? // required for WorkContext, but collected AFTER signup
  companyDivision String? // optional grouping layer
  workMeCompanyId String?
  workMeCompany   WorkMeCompany? @relation(fields: [workMeCompanyId], references: [id])

  jobTitle    String?
  specialty   String?
  industry    String?
  jobRole     JobRole?
  salaryRange SalaryRange?
  createdAt   DateTime     @default(now())

  superAdmin SuperAdmin? // Optional link to SuperAdmin (may migrate away)

  // WorkWorld Architecture Relations
  workplaces             Workplace[]
  companyUnitMemberships CompanyUnitMembers[]

  // Minimal reverse relations (required by Prisma, but NOT to be queried)
  // WorkMe is pure identity - work outputs reference WorkMe via createdByWorkMeId
  // These relations exist only for Prisma schema validation
  originatedCommsOutputs        CommsOutput[]           @relation("CommsOutputOriginator")
  originatedObjectives          Objective[]             @relation("ObjectiveOriginator")
  originatedAchievements        Achievement[]           @relation("AchievementOriginator")
  createdWorkOutputStandalones  WorkOutputStandalone[]  @relation("WorkOutputStandaloneCreator")
  createdNTKs                   NTK[]                   @relation("NTKCreator")
  createdWorkCommsProducts      WorkCommsProduct[]      @relation("WorkCommsProductCreator")
  createdWorkforceComms         WorkforceComms[]        @relation("WorkforceCommsCreator")
  createdWorkforceCommsDrafts   WorkforceCommsDraft[]   @relation("WorkforceCommsDraftCreator")
  createdWorkforceCommsEditions WorkforceCommsEdition[] @relation("WorkforceCommsEditionCreator")
  createdNTKEditions            NTKEdition[]            @relation("NTKEditionCreator")
  createdCompanyCampaigns       CompanyCampaign[]       @relation("CompanyCampaignCreator")
  createdCompanyImpactEvents    CompanyImpactEvent[]    @relation("CompanyImpactEventCreator")
  createdCompanyTrainings       CompanyTraining[]       @relation("CompanyTrainingCreator")
  createdCompanyEvents          CompanyEvent[]          @relation("CompanyEventCreator")
  createdCompanyCommunities     CompanyCommunity[]      @relation("CompanyCommunityCreator")
  createdCompanyCareers         CompanyCareer[]         @relation("CompanyCareerCreator")

  // connections Connection[]  // Commented out - not using
  // events      Event[]       // Commented out - not using
  // milestones  Milestone[]   // Commented out - not using
}

enum JobRole {
  INDIVIDUAL_CONTRIBUTOR
  MANAGER
  DIRECTOR_LEVEL
  PROJECT_LEAD
}

enum SalaryRange {
  BELOW_50K
  K50_100K
  K100_150K
  K150_200K
  ABOVE_200K
}

enum EventAudience {
  ALL_WORKFORCE
  LEADERS
  WORKFORCE_AND_FAMILIES
  COMMUNITY
}

enum EventCategory {
  CELEBRATION
  HERITAGE
  COMMUNITY
  RECOGNITION
  APPRECIATION
  FAMILY
}

enum CompanyUnitRole {
  MEMBER
  MANAGER
  ADMIN
}

// ============================================
// WORKME COMPANY MODEL (Container/Tenant)
// ============================================
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String // WorkMe platform name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees WorkMe[]
  // NO companies relation - Company is independent

  @@map("workme_company")
}

// ============================================
// SUPER ADMIN MODEL (Standalone Identity)
// ============================================
model SuperAdmin {
  id         String   @id @default(uuid())
  firebaseId String?  @unique // Firebase Auth UID (optional)
  email      String   @unique // Super admin email
  firstName  String?
  lastName   String?
  photoUrl   String?
  workMeId   String?  @unique // Optional link to WorkMe (may migrate away)
  workMe     WorkMe?  @relation(fields: [workMeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("super_admin")
}

// ============================================
// COMPANY MODEL (Independent Entity)
// ============================================
model Company {
  id           String        @id @default(uuid())
  name         String        @unique // Company name (unique globally)
  industry     String?
  website      String?
  city         String?
  state        String?
  description  String?
  headcount    Int?
  companyType  CompanyType?
  revenueRange RevenueRange?
  createdAt    DateTime      @default(now())

  // Identity (Apollo Enrichment)
  missionStatement    String?
  vision              String?
  values              String? // CSV string
  brandTagline        String?
  brandLogoUrl        String?
  brandColorPrimary   String?
  brandColorSecondary String?

  // Leadership (Apollo Enrichment)
  ceoName      String?
  ceoTitle     String?
  deputyName   String?
  deputyTitle  String?
  chiefOfStaff String?

  // Organization (Apollo Enrichment)
  directorates String[] @default([]) // e.g. ["SEA 02", "SEA 05", "SEA 10"]

  // Social / Public (Apollo Enrichment)
  linkedinUrl String?
  twitterUrl  String?
  facebookUrl String?
  phone       String?

  // Address (Apollo Enrichment)
  country String?

  // Note: Work models now use companyUnit/companyDivision instead of Company relations
  // Company model remains as an independent entity for enterprise-level metadata
  // No direct relation to WorkMe - users are scoped by companyUnit/companyDivision strings

  @@index([name]) // Index for directory lookups
}

// ============================================
// WORKWORLD ARCHITECTURE MODELS
// ============================================

// CompanyRegistry: Global company-level anchor for WorkConnect
model CompanyRegistry {
  id        String   @id @default(cuid())
  name      String
  domain    String? // Optional for domain matching
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units      CompanyUnit[]
  workplaces Workplace[]

  @@index([name])
  @@index([domain])
}

// CompanyUnit: Subdivision (HQ, directorates, departments) with hierarchical structure
model CompanyUnit {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  unit         String   @unique // Unique identifier for membership references
  parentUnitId String? // Allows parent → child nesting
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    CompanyRegistry      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentUnit CompanyUnit?         @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  subUnits   CompanyUnit[]        @relation("UnitHierarchy")
  members    CompanyUnitMembers[]

  @@index([companyId])
  @@index([parentUnitId])
  @@index([unit])
}

// CompanyUnitMembers: Junction table linking WorkMe to CompanyUnit with role
model CompanyUnitMembers {
  id          String          @id @default(uuid())
  workMeId    String
  companyUnit String // References CompanyUnit.unit
  role        CompanyUnitRole @default(MEMBER)
  createdAt   DateTime        @default(now())

  workMe WorkMe      @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  unit   CompanyUnit @relation(fields: [companyUnit], references: [unit], onDelete: Cascade)

  @@unique([workMeId, companyUnit])
  @@index([workMeId])
  @@index([companyUnit])
  @@index([role])
}

// Workplace: Link between a user (WORKMEID) and a specific company
model Workplace {
  id        String   @id @default(cuid())
  workMeId  String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe  WorkMe          @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company CompanyRegistry @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Note: roles relation removed - CompanyRole model deleted

  @@unique([workMeId, companyId]) // One workplace per user-company pair
  @@index([workMeId])
  @@index([companyId])
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id String @id @default(cuid())

  companyUnit     String?
  companyDivision String?
  originatorId    String
  originator      WorkMe  @relation("CommsOutputOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  type        String // "email", "flyer", "digest", etc.
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Objective {
  id String @id @default(cuid())

  companyUnit     String?
  companyDivision String?
  originatorId    String
  originator      WorkMe  @relation("ObjectiveOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title       String
  description String?
  howMeasured String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Achievement {
  id String @id @default(cuid())

  companyUnit     String?
  companyDivision String?
  originatorId    String
  originator      WorkMe  @relation("AchievementOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title    String
  category AchievementCategory

  audienceName String?
  audienceSize Int?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  commsOutputId String?
  commsOutput   CommsOutput? @relation(fields: [commsOutputId], references: [id], onDelete: SetNull)

  whatYouDid String
  frequency  String? // weekly, recurring, one-time
  volume     Int?

  processSteps Json? // array of steps
  impact       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyUnit])
  @@index([originatorId])
  @@index([category])
}

// ============================================
// WORK ARCHITECTURE MODELS
// ============================================

// ============================================
// COMPANY MODELS (Renamed from WorkContext*)
// ============================================
// NOTE: ContextType is now a TypeScript type in lib/types/context-type.ts
// It's no longer a Prisma enum since WorkEventRouter was removed

model CompanyCampaign {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  windowStart  DateTime?
  windowEnd    DateTime?
  ctaLink      String?
  sponsor      String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyCampaignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  links CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyImpactEvent {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  title              String
  description        String?
  effectiveDate      DateTime?
  impactedPopulation String?
  urgency            String?
  pocFirstName       String?
  pocLastName        String?
  pocEmail           String?
  pocPhone           String?

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyImpactEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  links CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyTraining {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Core
  title            String?
  topic            String?
  description      String?
  mandatory        Boolean @default(false)
  sponsoringOffice String?

  // Date / Time
  trainingDate DateTime?
  startTime    String?
  endTime      String?

  // Format / Location
  location String?
  format   String?
  link     String?

  // POC
  pocFirstName   String?
  pocLastName    String?
  pocEmail       String?
  pocPhone       String?
  pocRankOrTitle String?

  // Stage 1 Ingest Snapshot
  ingestRawText   String?
  ingestType      String?
  ingestStatus    String?   @default("pending")
  ingestCreatedAt DateTime? @default(now())

  // Relations
  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyTrainingCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  links CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core identity
  title       String
  theme       String? // NEW (tagline / theme)
  description String?

  // Timing
  eventDate DateTime?
  startTime String?
  endTime   String?

  // Category (enum)
  eventCategory EventCategory?

  // Registration
  registrationRequired String?
  registrationLink     String?

  // Highlights extracted from GPT
  audience      EventAudience?
  vibe          String?
  perks         String[]       @default([])
  participation String[]       @default([])

  // Food
  foodProvided String?
  foodTypes    String?

  // Speaker + POC
  speakers String[] @default([])
  pocEmail String?
  pocPhone String?

  summary String? // Stage 3 synthesized paragraph

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // Relations
  eventItems EventItem[]
  links      CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model EventItem {
  id      String       @id @default(cuid())
  eventId String
  event   CompanyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model CompanyCommunity {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  partnerOrg   String?
  date         DateTime?
  location     String?
  signUpLink   String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyCommunityCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  links CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyBenefits {
  // -----------------------
  // IDENTITY
  // -----------------------
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -----------------------
  // CORE CONTENT
  // -----------------------
  title                  String
  description            String? // 1–2 sentence plain explainer
  employeeBenefitSummary String? // why employees should care

  // -----------------------
  // UNIVERSAL BENEFIT STRUCTURE
  // -----------------------
  windowStart DateTime? // enrollment or action window start
  windowEnd   DateTime? // enrollment or action window end

  deadlines Json? // { enrollBy, mailInDeadline, systemClose, etc. }

  actionLink String? // GRB / TSP.gov / OPM / portal / signup
  resources  Json? // { brochures: [...], guides: [...], instructions: [...] }

  pocList           Json? // [{ name, email, phone }]
  extraInstructions Json? // ["Review FEHB options", "Log into GRB", ...]

  // -----------------------
  // AI SYNTHESIS (Stage 3)
  // -----------------------
  summary String? // NTK synthesized paragraph

  // -----------------------
  // RAW INGESTION (Stage 1)
  // -----------------------
  ingestRawText String?

  // -----------------------
  // RELATIONS
  // -----------------------
  companyUnit String?
  links       CompanyWorkLink[]

  @@index([companyUnit])
}

enum CareerLevel {
  NAVSEA
  NAVY
  DOD
}

enum CareerType {
  Leadership
  Fellowship
  Other
}

model CompanyCareer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title       String
  description String?

  // Classification enums
  level CareerLevel? // NAVSEA | NAVY | DOD
  type  CareerType? // Leadership | Fellowship | Other

  // Eligibility JSON
  eligibility Json? // {
  //   paygradeRange: { min: string | null, max: string | null },
  //   timeInServiceMonths?: number | null,
  //   timeInPositionMonths?: number | null,
  //   who?: string | null
  // }

  // Application JSON
  application Json? // { instructions: string | null, link?: string | null }

  // Optional extras
  extras Json? // { cost?: string | null, notes?: string[] | null }

  // Raw ingest text (no workflow status)
  ingestRawText String?

  // Relations
  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe            @relation("CompanyCareerCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  links             CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyEmployeeCause {
  // -----------------------
  // IDENTITY
  // -----------------------
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -----------------------
  // CORE CONTENT
  // -----------------------
  title         String
  description   String? // 1–2 sentence "what is this thing?"
  impactSummary String? // 1 sentence "why this matters / who it helps"

  // -----------------------
  // STRUCTURED FIELDS
  // -----------------------
  partnerOrg           String?
  sponsoringDepartment String?

  windowStart DateTime?
  windowEnd   DateTime?
  deadlines   Json? // { mailed, dropoff, delivery }

  locations String[] @default([]) // drop-off or event locations
  link      String?

  pocList           Json? // [{ name, email, phone }]
  extraInstructions Json? // ["avoid toy weapons", ...]

  // -----------------------
  // AI SYNTHESIS (Stage 3)
  // -----------------------
  summary String?

  // -----------------------
  // RAW INGESTION (Stage 1)
  // -----------------------
  ingestRawText String?

  // -----------------------
  // RELATIONS
  // -----------------------
  companyUnit String?
  links       CompanyWorkLink[]

  @@index([companyUnit])
}

// ============================================
// COMPANY WORK LINK (Junction Table)
// ============================================
model CompanyWorkLink {
  id String @id @default(uuid())

  companyEventId String?
  companyEvent   CompanyEvent? @relation(fields: [companyEventId], references: [id], onDelete: Cascade)

  companyTrainingId String?
  companyTraining   CompanyTraining? @relation(fields: [companyTrainingId], references: [id], onDelete: Cascade)

  companyBenefitsId String?
  companyBenefits   CompanyBenefits? @relation(fields: [companyBenefitsId], references: [id], onDelete: Cascade)

  companyCampaignId String?
  companyCampaign   CompanyCampaign? @relation(fields: [companyCampaignId], references: [id], onDelete: Cascade)

  companyImpactEventId String?
  companyImpactEvent   CompanyImpactEvent? @relation(fields: [companyImpactEventId], references: [id], onDelete: Cascade)

  companyCommunityId String?
  companyCommunity   CompanyCommunity? @relation(fields: [companyCommunityId], references: [id], onDelete: Cascade)

  companyCareerId String?
  companyCareer   CompanyCareer? @relation(fields: [companyCareerId], references: [id], onDelete: Cascade)

  companyEmployeeCauseId String?
  companyEmployeeCause   CompanyEmployeeCause? @relation(fields: [companyEmployeeCauseId], references: [id], onDelete: Cascade)

  workCommsProductId String
  workCommsProduct   WorkCommsProduct @relation(fields: [workCommsProductId], references: [id], onDelete: Cascade)

  companyUnit     String?
  companyDivision String?

  createdAt DateTime @default(now())

  @@index([companyEventId])
  @@index([companyTrainingId])
  @@index([companyBenefitsId])
  @@index([companyCampaignId])
  @@index([companyImpactEventId])
  @@index([companyCommunityId])
  @@index([companyCareerId])
  @@index([companyEmployeeCauseId])
  @@index([workCommsProductId])
  @@index([companyUnit])
}

// ============================================
// WORKOUTPUT STANDALONE MODEL (Standalone Deliverables)
// ============================================
enum OutputCategory {
  workforce_comms_email
  messaging_talking_points
  digital_product
  print_product
  sharepoint_update
  photo_video_support
  ntk
}

// ============================================
// WORK OUTPUT STANDALONE (Legacy - preserved for backward compatibility)
// ============================================
model WorkOutputStandalone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Output Category (Email, Talking Points, Digital, etc.)
  outputType OutputCategory

  title        String
  description  String?
  draftContent Json? // email body, notes, fields, etc.
  metadata     Json? // any structured data needed later

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("WorkOutputStandaloneCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([outputType])
  @@index([updatedAt])
}

// ============================================
// STANDALONE NTK MODEL (Legacy - preserved for backward compatibility)
// ============================================
model NTK {
  ntkId     String   @id @default(cuid()) @map("id") // Primary key as ntkId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NAVSEA NTK Structure
  header     String // [TITLE IN ALL CAPS] – [MONTH] [DAY]
  poc        String // *POC: [name & email]*
  summary    String // 2-4 sentence summary in NAVSEA tone
  sourceText String? // Original source text (manual entry, CSV, etc.)

  // Optional structured data
  draftContent Json? // Full NTK structure for future use
  metadata     Json? // Additional metadata (isCSV, generatedAt, etc.)

  // Multi-tenant scoping
  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("NTKCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([createdAt])
  @@map("ntk")
}

// ============================================
// NTK EDITION & ITEM MODELS (New Pipeline)
// ============================================
enum NTKStatus {
  PENDING
  VALIDATED
  GENERATED
  REVIEWED
  FINAL
}

model NTKEdition {
  id                String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  date              DateTime?
  title             String?
  createdByWorkMeId String
  createdBy         WorkMe    @relation("NTKEditionCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  companyUnit     String?
  companyDivision String?

  items NTKItem[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([createdAt])
  @@map("ntk_editions")
}

model NTKItem {
  id        String     @id @default(uuid())
  editionId String
  edition   NTKEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  inputId   String // Stable per-row identifier
  rawFields Json // Store uploaded CSV row as JSON
  validated Boolean @default(false)

  plainLanguage String? // GPT output (plain text)
  feedback      String? // For regenerating with user feedback
  status        NTKStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([editionId])
  @@index([inputId])
  @@index([status])
  @@map("ntk_items")
}

// ============================================
// WORK COMMS PRODUCT (Normalized Work Layer)
// ============================================
enum WorkCommsProductType {
  email
  poster
  ntk
  digital_sign
  exec_email
  flyer
  sharepoint
  photo_video
  talking_points
}

model WorkCommsProduct {
  id        String               @id @default(uuid())
  type      WorkCommsProductType
  data      Json?
  metadata  Json?
  createdAt DateTime             @default(now())

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("WorkCommsProductCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  links CompanyWorkLink[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([type])
}

// ============================================
// WORKFORCE COMMUNICATIONS SYSTEM (3-Layer)
// ============================================

// 1. Product Layer (True North) - Stable, reusable product definitions
// NOTE: This is kept for backward compatibility with existing WorkforceComms system
// New products should use WorkCommsProduct instead
model WorkforceComms {
  workforceCommsId String   @id @default(uuid())
  type             String // "email" for now, future-proof for other types
  name             String // "Need to Know", "Urgent Update", "Awareness Email"
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("WorkforceCommsCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  editions WorkforceCommsEdition[] @relation("WorkforceCommsEditions")
  drafts   WorkforceCommsDraft[]   @relation("WorkforceCommsDrafts")

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([type])
  @@index([name])
}

// 2. Draft Layer (Staging Container) - Where context and notes live before GPT generation
// NOTE: eventRouterIds field is deprecated - use CompanyWorkLink instead
model WorkforceCommsDraft {
  draftId          String   @id @default(uuid())
  workforceCommsId String // FK → WorkforceComms
  eventRouterIds   Json? // DEPRECATED: Array of WorkEventRouter references (use CompanyWorkLink instead)
  lastEditionId    String? // FK → WorkforceCommsEdition (optional reference to previous edition)
  authorNotes      String? // Freeform "what to tell GPT"
  whatChanged      String? // Crisp delta from last send
  priorityNotes    String? // "still a priority", "emphasize X"
  status           String   @default("drafting") // "drafting" | "readyForGeneration" | "needsReview" | "generating"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product     WorkforceComms         @relation("WorkforceCommsDrafts", fields: [workforceCommsId], references: [workforceCommsId], onDelete: Cascade)
  lastEdition WorkforceCommsEdition? @relation(fields: [lastEditionId], references: [editionId], onDelete: SetNull)

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("WorkforceCommsDraftCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([status])
  @@index([createdAt])
}

// 3. Edition Layer (Final Output) - Immutable generated emails
model WorkforceCommsEdition {
  editionId        String    @id @default(uuid())
  workforceCommsId String // FK → WorkforceComms
  subject          String
  body             String
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product      WorkforceComms        @relation("WorkforceCommsEditions", fields: [workforceCommsId], references: [workforceCommsId], onDelete: Cascade)
  referencedBy WorkforceCommsDraft[] // Drafts that reference this edition as lastEdition

  companyUnit       String?
  companyDivision   String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("WorkforceCommsEditionCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([sentAt])
  @@index([createdAt])
}


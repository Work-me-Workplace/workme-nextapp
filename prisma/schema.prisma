// ============================================
// MYTEAM MODELS (Personal Workplace Relationship Graph)
// ============================================
// Personal intelligence captured by the user - NOT company data
// Every WorkMe identity gets exactly ONE MyTeamContainer
//
// ARCHITECTURAL NOTE:
// CompanyEmployee is the single identity model for all company people.
// All role and workplace intelligence models reference it by FK.
// Roles describe capacity; intelligence describes personal perception.
// MyTeam models may optionally link to CompanyEmployee via employeeId FK
// to enrich personal intelligence with company truth, but can also exist
// independently for external people, former employees, or fuzzy relationships.

model MyTeamContainer {
  id       String @id @default(cuid())
  workMeId String @unique @db.Uuid
  workMe   WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  directors    MyTeamDirectorProfile[]
  deputies     MyTeamDeputyProfile[]
  peers        MyTeamPeerProfile[]
  subordinates MyTeamSubordinateProfile[]

  createdAt DateTime @default(now())

  @@index([workMeId])
}

model MyTeamDirectorProfile {
  id          String          @id @default(cuid())
  containerId String
  container   MyTeamContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)

  // Optional link to CompanyEmployee (company truth)
  // Allows enriching personal intelligence with company data
  employeeId String?
  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // Identity (kept for external/former employees or when no CompanyEmployee match)
  firstName   String
  lastName    String
  ageEstimate Int?
  gender      String?

  // Personal Context
  attractiveness Int? // 1–10
  partnerStatus  String? // None | Partner | Married | Unknown
  numberOfKids   Int?

  // Work Context
  yearsInRole         Int?
  internalRank        String?
  teamSizeManaged     Int?
  spanOfControl       String? // Small | Medium | Large | Unknown
  friendlinessScale   Int? // 1–10
  strictnessScale     Int? // 1–10
  responsivenessScale Int? // 1–10
  decisivenessScale   Int? // 1–10

  // Relationship With User
  isSupervisor        String? // Yes | No | Unknown - is this person actually your supervisor?
  hiredMe             String? // Yes | No | Unknown
  favoritismPerceived Int? // 1–10
  frictionPerceived   Int? // 1–10
  trustLevel          Int? // 1–10

  // Notes bucket – general raw text only
  miscNotes String?

  @@index([containerId])
  @@index([employeeId])
}

model MyTeamDeputyProfile {
  id          String          @id @default(cuid())
  containerId String
  container   MyTeamContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)

  // Optional link to CompanyEmployee (company truth)
  employeeId String?
  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  ageEstimate Int?
  gender      String?

  attractiveness Int?
  partnerStatus  String?
  numberOfKids   Int?

  yearsInRole  Int?
  internalRank String?

  // Deputy-specific context
  supportsBossScale      Int? // 1–10 how strongly they align with the supervisor
  decisionAuthorityScale Int? // 1–10 real influence in calls
  managesOthersScale     Int? // 1–10 actual people management weight
  advocacyScale          Int? // 1–10 how much they advocate for YOU
  communicationToneScale Int? // 1–10 warmth / openness
  executionReliability   Int? // 1–10 follow-through strength

  miscNotes String?

  @@index([containerId])
  @@index([employeeId])
}

model MyTeamPeerProfile {
  id          String          @id @default(cuid())
  containerId String
  container   MyTeamContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)

  // Optional link to CompanyEmployee (company truth)
  employeeId String?
  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  ageEstimate Int?
  gender      String?

  attractiveness Int?
  partnerStatus  String?
  numberOfKids   Int?

  // Peer dynamics
  collaborationScale     Int? // 1–10
  competitivenessScale   Int? // 1–10
  triesToTakeCreditScale Int? // 1–10
  triesToTakeYourJob     Int? // 1–10 gut check
  eagernessScale         Int? // 1–10
  yesPersonScale         Int? // 1–10

  frictionScale Int? // 1–10
  trustLevel    Int? // 1–10

  miscNotes String?

  @@index([containerId])
  @@index([employeeId])
}

model MyTeamSubordinateProfile {
  id          String          @id @default(cuid())
  containerId String
  container   MyTeamContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)

  // Optional link to CompanyEmployee (company truth)
  employeeId String?
  employee   CompanyEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  ageEstimate Int?
  gender      String?

  attractiveness Int?
  partnerStatus  String?
  numberOfKids   Int?

  // Subordinate dynamics
  autonomyScale          Int? // 1–10
  eagernessScale         Int? // 1–10
  learningPaceScale      Int? // 1–10
  reliabilityScale       Int? // 1–10
  communicationScale     Int? // 1–10
  ambitionScale          Int? // 1–10
  stressSensitivityScale Int? // 1–10

  miscNotes String?

  @@index([containerId])
  @@index([employeeId])
}


}

model WorkContextCareer {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  title          String
  description    String?
  deadlines      Json? // Array of {label: string, date: DateTime}
  supervisorName String?
  resourceLink   String?
  pocFirstName   String?
  pocLastName    String?
  pocEmail       String?
  pocPhone       String?
  pocDepartment  String?

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdByWorkMeId])
}

model WorkContextEmployeeCause {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  title                String
  description          String?
  partnerOrg           String?
  windowStart          DateTime?
  windowEnd            DateTime?
  location             String?
  neededItems          String[]
  collectionPoints     String[]
  signUpLink           String?
  pocFirstName         String?
  pocLastName          String?
  pocEmail             String?
  pocPhone             String?
  sponsoringDepartment String?

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdByWorkMeId])
}

// ============================================
// WORKSUPPORT MODEL (Support Container)
// ============================================
model WorkSupport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contextId String
  context   WorkContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  supportType String? // optional, e.g. "event_support", "training_support"

  selectedOutputs String[] // list of WorkOutput types chosen by user
  evolvingInfo    Json? // RSVP list, notes, last-minute requests, etc.
  assets          Json? // WorkOutput IDs created through this support
  status          String   @default("draft") // "draft" | "in_progress" | "complete"

  outputs WorkOutput[]

  @@unique([contextId]) // One WorkSupport per WorkContext (unless multiple needed later)
  @@index([contextId])
  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([status])
}

// ============================================
// WORKOUTPUT MODEL (Output Builder)
// ============================================
model WorkOutput {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contextId String?
  context   WorkContext? @relation(fields: [contextId], references: [id], onDelete: Cascade)

  supportId String?
  support   WorkSupport? @relation(fields: [supportId], references: [id], onDelete: Cascade)

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  outputType String // "ntk_snippet" | "talking_points" | "digital_signage" | "print_product" | "sharepoint_block" | "quick_blurb" | "event_kit" | "photo_video"
  dataJson   Json? // saved content from builders

  status String @default("draft") // "draft" | "final"

  @@index([contextId])
  @@index([supportId])
  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([outputType])
  @@index([status])
  @@index([updatedAt])
}

// ============================================
// WORKOUTPUT STANDALONE MODEL (Standalone Deliverables)
// ============================================
enum OutputCategory {
  workforce_comms_email
  messaging_talking_points
  digital_product
  print_product
  sharepoint_update
  photo_video_support
  ntk
}

/// FUTURE:
/// workSupportId will be connected to WorkSupport model
/// once WorkSupport is implemented.
/// For now this field remains optional and unused.
model WorkOutputStandalone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Output Category (Email, Talking Points, Digital, etc.)
  outputType OutputCategory

  title        String
  description  String?
  draftContent Json? // email body, notes, fields, etc.
  metadata     Json? // any structured data needed later

  // OPTIONAL: future relational hook (not used today)
  workSupportId String?
  // DO NOT enforce relation today
  // Add relation later when WorkSupport is built

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([outputType])
  @@index([updatedAt])
  @@index([workSupportId])
}

// ============================================
// STANDALONE NTK MODEL
// ============================================
model NTK {
  ntkId        String   @id @default(cuid()) @map("id") // Primary key as ntkId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // NAVSEA NTK Structure
  header       String   // [TITLE IN ALL CAPS] – [MONTH] [DAY]
  poc          String   // *POC: [name & email]*
  summary      String   // 2-4 sentence summary in NAVSEA tone
  sourceText   String?  // Original source text (manual entry, CSV, etc.)

  // Optional structured data
  draftContent Json?    // Full NTK structure for future use
  metadata     Json?    // Additional metadata (isCSV, generatedAt, etc.)

  // Multi-tenant scoping
  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([createdAt])
  @@map("ntk")
}

// ============================================
// WORKFORCE COMMUNICATIONS SYSTEM (3-Layer)
// ============================================

// 1. Product Layer (True North) - Stable, reusable product definitions
model WorkforceComms {
  workforceCommsId String   @id @default(uuid())
  type             String // "email" for now, future-proof for other types
  name             String // "Need to Know", "Urgent Update", "Awareness Email"
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  editions WorkforceCommsEdition[]
  drafts   WorkforceCommsDraft[]

  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([type])
  @@index([name])
}

// 2. Draft Layer (Staging Container) - Where context and notes live before GPT generation
model WorkforceCommsDraft {
  draftId          String   @id @default(uuid())
  workforceCommsId String // FK → WorkforceComms
  contextIds       Json? // Array of WorkContext references
  lastEditionId    String? // FK → WorkforceCommsEdition (optional reference to previous edition)
  authorNotes      String? // Freeform "what to tell GPT"
  whatChanged      String? // Crisp delta from last send
  priorityNotes    String? // "still a priority", "emphasize X"
  status           String   @default("drafting") // "drafting" | "readyForGeneration" | "needsReview" | "generating"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product     WorkforceComms         @relation(fields: [workforceCommsId], references: [workforceCommsId], onDelete: Cascade)
  lastEdition WorkforceCommsEdition? @relation(fields: [lastEditionId], references: [editionId], onDelete: SetNull)

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([workforceCommsId])
  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([status])
  @@index([createdAt])
}

// 3. Edition Layer (Final Output) - Immutable generated emails
model WorkforceCommsEdition {
  editionId        String    @id @default(uuid())
  workforceCommsId String // FK → WorkforceComms
  subject          String
  body             String
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product      WorkforceComms        @relation(fields: [workforceCommsId], references: [workforceCommsId], onDelete: Cascade)
  referencedBy WorkforceCommsDraft[] // Drafts that reference this edition as lastEdition

  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByWorkMeId String
  createdBy         WorkMe  @relation(fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([workforceCommsId])
  @@index([companyId])
  @@index([createdByWorkMeId])
  @@index([sentAt])
  @@index([createdAt])
}


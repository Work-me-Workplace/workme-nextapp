generator client {
  provider = "prisma-client-js"
}

// Switch to PostgreSQL for production/RDS. Set `DATABASE_URL` in environment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER MODEL
// ============================================
model WorkMe {
  id          String   @id @default(uuid())
  firebaseId  String?  @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  photoUrl    String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  workMeCompanyId String?
  workMeCompany WorkMeCompany? @relation(fields: [workMeCompanyId], references: [id])

  jobTitle    String?
  specialty   String?
  industry    String?
  jobRole     JobRole?
  salaryRange SalaryRange?
  createdAt   DateTime @default(now())
  
  superAdmin  SuperAdmin? // Optional link to SuperAdmin (may migrate away)
  // connections Connection[]  // Commented out - not using
  // events      Event[]       // Commented out - not using
  // milestones  Milestone[]   // Commented out - not using
}

enum JobRole {
  INDIVIDUAL_CONTRIBUTOR
  MANAGER
  DIRECTOR_LEVEL
  PROJECT_LEAD
}

enum SalaryRange {
  BELOW_50K
  K50_100K
  K100_150K
  K150_200K
  ABOVE_200K
}

// ============================================
// WORKME COMPANY MODEL (Container/Tenant)
// ============================================
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String   // WorkMe platform name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   WorkMe[]
  companies   Company[] // Companies in this container

  @@map("workme_company")
}

// ============================================
// SUPER ADMIN MODEL (Standalone Identity)
// ============================================
model SuperAdmin {
  id          String   @id @default(uuid())
  firebaseId  String?  @unique // Firebase Auth UID (optional)
  email       String   @unique // Super admin email
  firstName   String?
  lastName    String?
  photoUrl    String?
  workMeId    String?  @unique // Optional link to WorkMe (may migrate away)
  workMe      WorkMe?  @relation(fields: [workMeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("super_admin")
}

// ============================================
// COMPANY MODEL (Directory - Container-Scoped)
// ============================================
model Company {
  id              String   @id @default(uuid())
  workMeCompanyId String   // WorkMe container ID (single tenant)
  workMeCompany   WorkMeCompany @relation(fields: [workMeCompanyId], references: [id])
  name            String   // Company name (unique per container)
  industry        String?
  website         String?
  city            String?
  state           String?
  description     String?
  headcount       Int?
  companyType     CompanyType?
  revenueRange    RevenueRange?
  createdAt       DateTime @default(now())

  employees       WorkMe[]

  @@unique([workMeCompanyId, name]) // Unique name per container
  @@index([workMeCompanyId]) // Index for directory lookups
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id          String   @id @default(cuid())
  workMeId    String   // References WorkMe.id
  type        String   // "email", "flyer", "digest", etc.
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
}

model Objective {
  id          String   @id @default(cuid())
  workMeId    String   // References WorkMe.id

  title       String
  description String?
  howMeasured String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
}

model CompanyCampaign {
  id          String   @id @default(cuid())
  workMeId    String   // References WorkMe.id

  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
}

model Achievement {
  id                   String   @id @default(cuid())
  workMeId             String   // References WorkMe.id

  title                String
  category             AchievementCategory

  audienceName         String?
  audienceSize         Int?

  objectiveId          String?
  objective            Objective? @relation(fields: [objectiveId], references: [id])

  commsOutputId        String?
  commsOutput          CommsOutput? @relation(fields: [commsOutputId], references: [id])

  companyCampaignId    String?
  companyCampaign      CompanyCampaign? @relation(fields: [companyCampaignId], references: [id])

  whatYouDid           String
  frequency            String?   // weekly, recurring, one-time
  volume               Int?

  processSteps         Json?     // array of steps
  impact               String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============================================
// WORK ARCHITECTURE MODELS
// ============================================
// Router model - references typed context models
model WorkContext {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  type            String      // "campaign" | "impact_event" | "training" | "event" | "community"
  typeRefId       String      // references the typed context model
  createdByWorkMeId String    // References WorkMe.id

  outputs         WorkOutput[]

  @@index([createdByWorkMeId])
  @@index([createdAt])
  @@index([type, typeRefId])
}

// Typed Context Models
model CompanyCampaign {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  title         String
  description   String?
  windowStart   DateTime?
  windowEnd     DateTime?
  ctaLink       String?
  sponsor       String?
  pocLastName   String?
  createdByWorkMeId String

  @@index([createdByWorkMeId])
}

model CompanyWorkforceImpactEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  title         String
  description   String?
  effectiveDate DateTime?
  impactedPopulation String?
  urgency       String?
  pocLastName   String?
  createdByWorkMeId String

  @@index([createdByWorkMeId])
}

model CompanyTraining {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  title         String
  description   String?
  trainingDate  DateTime?
  deadline      DateTime?
  link          String?
  mandatory     Boolean  @default(false)
  sponsoringOffice String?
  pocLastName   String?
  createdByWorkMeId String

  @@index([createdByWorkMeId])
}

model CompanyEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  pocLastName   String?
  eventCategory String?
  createdByWorkMeId String

  @@index([createdByWorkMeId])
}

model CompanyCommunityOpportunity {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  title         String
  description   String?
  partnerOrg    String?
  date          DateTime?
  location      String?
  signUpLink    String?
  pocLastName   String?
  createdByWorkMeId String

  @@index([createdByWorkMeId])
}

model WorkOutput {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  contextId       String
  context         WorkContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  outputType      String      // "email" | "poster" | "talking_points" | "sharepoint" | "event_kit"
  dataJson        Json?

  createdByWorkMeId String    // References WorkMe.id

  @@index([contextId])
  @@index([createdByWorkMeId])
  @@index([updatedAt])
}


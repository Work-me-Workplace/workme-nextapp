// ============================================
// HOLIDAY BUILDER SYSTEM MODELS
// ============================================
model Holiday {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assets Asset[]

  @@index([slug])
}

model Asset {
  id          String   @id @default(cuid())
  url         String
  fileName    String
  category    String // "holiday", "workforce", "shipyard", "general"
  holidaySlug String?
  createdAt   DateTime @default(now())

  holiday Holiday? @relation(fields: [holidaySlug], references: [slug], onDelete: SetNull)

  @@index([category])
  @@index([holidaySlug])
}

// ============================================
// INTERNAL PRODUCTIVITY MODELS (MVP)
// ============================================

model MyWorkOutlook {
  id        String   @id @default(cuid())
  workMeId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe       @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  items  MyWorkItem[]

  @@index([workMeId])
}

model MyWorkItem {
  id        String   @id @default(cuid())
  outlookId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title   String
  notes   String?
  status  String    @default("open") // "open" | "done" | "blocked" | "watch"
  dueDate DateTime?
  tag     String? // optional: "comms" | "admin" | "personal" | etc.

  outlook MyWorkOutlook @relation(fields: [outlookId], references: [id], onDelete: Cascade)

  @@index([outlookId])
  @@index([status])
}

model AdminWorkItem {
  id        String   @id @default(cuid())
  workMeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title  String
  notes  String?
  status String  @default("open")

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([status])
}

// ============================================
// WORK OUTLOOK MODEL (Daily Work Lens - Productivity Layer)
// ============================================
// "Today / Up Next / Planning" module
model WorkOutlookItem {
  id       String   @id @default(uuid())
  workMeId String
  date     DateTime
  item     String
  status   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([date])
  @@index([status])
}

// ============================================
// WORK GOAL MODEL (Goals Module)
// ============================================
model WorkGoal {
  id         String    @id @default(uuid())
  workMeId   String
  goal       String
  targetDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([targetDate])
}

generator client {
  provider = "prisma-client-js"
}

// Switch to PostgreSQL for production/RDS. Set `DATABASE_URL` in environment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER MODEL (Pure Identity + Simple Public Profile)
// ============================================
// WorkMe = Core Identity (Personhood)
// Contains ONLY stable identity fields + simple public-facing profile fields
model WorkMe {
  id         String   @id @default(uuid())
  firebaseId String?  @unique
  email      String   @unique
  createdAt  DateTime @default(now())

  // Simple public-facing profile fields (NOT work fields)
  headline    String?
  handle      String? @unique
  title       String?
  linkedinUrl String?

  workMeCompanyId String?
  workMeCompany   WorkMeCompany? @relation(fields: [workMeCompanyId], references: [id])

  // Bolt-on modules (all via foreign keys)
  workProfile        WorkProfile?
  workSkills         WorkSkills?
  workEntries        WorkEntry[]
  workGoals          WorkGoal[]
  ecosystemCompanies WorkMeEcosystemCompany[]
  ecosystemContacts  MyEcosystemContact[]

  // Company membership (canonical - via junction table with roles)
  // Company and division are inferred via CompanyUnitMembers → CompanyUnit → Company
  companyUnitMemberships CompanyUnitMembers[]

  // WorkWorld Architecture Relations
  workplaces Workplace[]

  // Minimal reverse relations (required by Prisma, but NOT to be queried)
  // WorkMe is pure identity - work outputs reference WorkMe via createdByWorkMeId
  // These relations exist only for Prisma schema validation
  originatedCommsOutputs     CommsOutput[]                      @relation("CommsOutputOriginator")
  originatedObjectives       Objective[]                        @relation("ObjectiveOriginator")
  originatedAchievements     Achievement[]                      @relation("AchievementOriginator")
  createdEmailDigestProducts WorkForceEnduringProdEmailDigest[] @relation("EmailDigestProductCreator")
  createdCompanyCampaigns    CompanyCampaign[]                  @relation("CompanyCampaignCreator")
  createdCompanyImpactEvents CompanyImpactEvent[]               @relation("CompanyImpactEventCreator")
  createdCompanyTrainings    CompanyTraining[]                  @relation("CompanyTrainingCreator")
  createdCompanyEvents       CompanyEvent[]                     @relation("CompanyEventCreator")
  createdCompanyCommunities  CompanyCommunity[]                 @relation("CompanyCommunityCreator")
  createdCompanyCareers      CompanyCareer[]                    @relation("CompanyCareerCreator")
  createdDigitalSignProducts ProductDigitalSign[]               @relation("ProductDigitalSignCreator")
  createdEmployeeHighlights  CompanyEmployeeHighlight[]         @relation("CompanyEmployeeHighlightCreator")
  engageMessages             EngageMessage[]

  // WorkOps Relations
  workOpsOutlook WorkOpsOutlook?

  // Company Products Relations
  companyProducts          CompanyProduct[]
  externalCompanyPressures ExternalCompanyPressure[]
  Company                  Company?                  @relation(fields: [companyId], references: [id])
  companyId                String?
  companyUnitId            String?
  divisionId               String?
  companyUnit              CompanyUnit?              @relation("WorkMeCompanyUnit", fields: [companyUnitId], references: [id], onDelete: SetNull)
  division                 DivisionUnit?              @relation("WorkMeDivision", fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([handle])
  @@index([companyId])
  @@index([companyUnitId])
  @@index([divisionId])
}

// ============================================
// WORK PROFILE MODEL (Professional Identity - "What I Do")
// ============================================
// Professional metadata - describes WHAT the user does professionally
// NOT personal identity, NOT skills, NOT company, NOT work history
model WorkProfile {
  id       String @id @default(uuid())
  workMeId String @unique

  jobRole               String?
  industry              String?
  salaryRange           String?
  responsibilitySummary String?
  seniority             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}


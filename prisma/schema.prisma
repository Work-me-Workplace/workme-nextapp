// ============================================
// WORKME COMPANY MODEL (Container/Tenant)
// ============================================
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String // WorkMe platform name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees WorkMe[]
  // NO companies relation - Company is independent

  @@map("workme_company")
}

// ============================================
// SUPER ADMIN MODEL (Standalone Identity)
// ============================================
model SuperAdmin {
  id         String   @id @default(uuid())
  firebaseId String?  @unique // Firebase Auth UID (optional)
  email      String   @unique // Super admin email
  firstName  String?
  lastName   String?
  photoUrl   String?
  workMeId   String?  @unique // Optional link to WorkMe (may migrate away)
  workMe     WorkMe?  @relation(fields: [workMeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("super_admin")
}

// ============================================
// COMPANY MODEL (Independent Entity)
// ============================================
model Company {
  id           String        @id @default(uuid())
  name         String        @unique // Company name (unique globally)
  industry     String?
  website      String?
  city         String?
  state        String?
  description  String?
  headcount    Int?
  companyType  CompanyType?
  revenueRange RevenueRange?
  createdAt    DateTime      @default(now())

  // Identity (Apollo Enrichment)
  missionStatement    String?
  vision              String?
  values              String? // CSV string
  brandTagline        String?
  brandLogoUrl        String?
  brandColorPrimary   String?
  brandColorSecondary String?

  // Leadership (Apollo Enrichment)
  ceoName      String?
  ceoTitle     String?
  deputyName   String?
  deputyTitle  String?
  chiefOfStaff String?

  // Organization (Apollo Enrichment)
  directorates String[] @default([]) // e.g. ["SEA 02", "SEA 05", "SEA 10"]

  // Social / Public (Apollo Enrichment)
  linkedinUrl String?
  twitterUrl  String?
  facebookUrl String?
  phone       String?

  // Address (Apollo Enrichment)
  country String?

  // Note: Work models now use companyUnit instead of Company relations
  // Company model remains as an independent entity for enterprise-level metadata
  // No direct relation to WorkMe - users are scoped by companyUnit strings

  @@index([name]) // Index for directory lookups
}

// ============================================
// COMPANY UNIT REGISTRY (Searchable Registry Pattern)
// ============================================
// Registry pattern like RaceRegistry - search or create
// Simple, searchable company unit registry
model CompanyUnit {
  id        String   @id @default(uuid())
  name      String   @unique // Company name (unique globally)
  companyId String? // Foreign key to CompanyRegistry (Company HQ) - optional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   CompanyRegistry? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  divisions DivisionUnit[]
  members   WorkMe[] // Direct relation to WorkMe

  @@index([name])
  @@index([companyId])
}

// ============================================
// DIVISION UNIT REGISTRY (Final Form)
// ============================================
// Parent → CompanyUnit, reusable, unique on (name + companyUnitId)
model DivisionUnit {
  id            String   @id @default(uuid())
  name          String
  companyUnitId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company CompanyUnit @relation(fields: [companyUnitId], references: [id], onDelete: Cascade)
  members WorkMe[] // Direct relation to WorkMe

  @@unique([name, companyUnitId])
  @@index([companyUnitId])
}

// ============================================
// WORK ENTRY MODEL (Work History - LinkedIn-style Experience Items)
// ============================================
// Work history - each WorkMe can have multiple WorkEntries (current + past jobs)
model WorkEntry {
  id          String    @id @default(uuid())
  workMeId    String
  companyName String?
  title       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([startDate])
  @@index([endDate])
}

// ============================================
// WORK SKILLS MODEL (Human Capital Layer)
// ============================================
// Standalone intelligence module attached directly to WorkMe
model WorkSkills {
  id             String  @id @default(uuid())
  workMeId       String  @unique
  skillsRaw      String?
  strengthsRaw   String?
  specialties    String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// COMPANY UNIT REGISTRY (Legacy - Deprecated)
// ============================================
// DEPRECATED: Use CompanyUnit model above instead
// Keeping for backward compatibility during migration
model CompanyUnitRegistry {
  id         String   @id @default(cuid())
  name       String   @unique // Unique workspace name (user-defined or generated)
  visibility String   @default("public") // "public" or "private"
  createdAt  DateTime @default(now())

  @@index([name])
  @@index([visibility])
}

// ============================================
// WORKWORLD ARCHITECTURE MODELS
// ============================================

// CompanyRegistry: Global company-level anchor for WorkConnect (Company HQ)
model CompanyRegistry {
  id        String   @id @default(cuid())
  name      String
  domain    String? // Optional for domain matching
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units        CompanyUnitHierarchy[]
  workplaces   Workplace[]
  members      WorkMe[] // Direct relation to WorkMe (Company HQ affiliation)
  companyUnits CompanyUnit[] // CompanyUnits that belong to this HQ

  @@index([name])
  @@index([domain])
}

// CompanyUnitHierarchy: Subdivision (HQ, directorates, departments) with hierarchical structure
// NOTE: This is for WorkWorld/WorkConnect hierarchical org structure
// For simple work history, use CompanyUnit registry + WorkEntry
model CompanyUnitHierarchy {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  unit         String   @unique // Unique identifier for membership references
  parentUnitId String? // Allows parent → child nesting
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    CompanyRegistry        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentUnit CompanyUnitHierarchy?  @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  subUnits   CompanyUnitHierarchy[] @relation("UnitHierarchy")
  members    CompanyUnitMembers[]

  @@index([companyId])
  @@index([parentUnitId])
  @@index([unit])
}

// CompanyUnitMembers: Junction table linking WorkMe to CompanyUnitHierarchy with role
// NOTE: This is for WorkWorld/WorkConnect hierarchical org membership
// For simple work history, use WorkEntry model instead
model CompanyUnitMembers {
  id          String          @id @default(uuid())
  workMeId    String
  companyUnit String // References CompanyUnitHierarchy.unit
  role        CompanyUnitRole @default(MEMBER)
  createdAt   DateTime        @default(now())

  workMe WorkMe               @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  unit   CompanyUnitHierarchy @relation(fields: [companyUnit], references: [unit], onDelete: Cascade)

  @@unique([workMeId, companyUnit])
  @@index([workMeId])
  @@index([companyUnit])
  @@index([role])
}

// Workplace: Link between a user (WORKMEID) and a specific company
model Workplace {
  id        String   @id @default(cuid())
  workMeId  String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe  WorkMe          @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company CompanyRegistry @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Note: roles relation removed - CompanyRole model deleted

  @@unique([workMeId, companyId]) // One workplace per user-company pair
  @@index([workMeId])
  @@index([companyId])
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String
  originator   WorkMe  @relation("CommsOutputOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  type        String // "email", "flyer", "digest", etc.
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Objective {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String
  originator   WorkMe  @relation("ObjectiveOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title       String
  description String?
  howMeasured String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Achievement {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String
  originator   WorkMe  @relation("AchievementOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title    String
  category AchievementCategory

  audienceName String?
  audienceSize Int?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  commsOutputId String?
  commsOutput   CommsOutput? @relation(fields: [commsOutputId], references: [id], onDelete: SetNull)

  whatYouDid String
  frequency  String? // weekly, recurring, one-time
  volume     Int?

  processSteps Json? // array of steps
  impact       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyUnit])
  @@index([originatorId])
  @@index([category])
}


// ============================================
// COMPANY PLATFORM PRODUCT MODELS
// ============================================
model CompanyPlatformProduct {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name             String // "Virginia-class"
  alternativeNames String[] @default([]) // "SSN", "Attack Submarine", "VCS"
  category         String? // "Submarine", "Surface Combatant"
  description      String?

  platformSeries String? // SSN, SSBN, CVN, DDG
  whySpecial     String? // High-level: stealth, payload, mission role
  payloadNotes   String? // e.g., VPM adds 28 missiles

  intendedTotalUnits Int? // e.g., 12 Columbia-class subs
  productionNotes    String? // yard performance, challenges, etc.

  // Optional "other ships in this class" strings (not unit models)
  knownShipsInClass String[] @default([])

  // AI or reporting derived signals
  currentProgressEstimate Int? // 0–100 for overall program maturity
  programStatus           String? // "On Track", "Delayed", "Rebaseline Expected"

  // Legacy fields (keeping for backward compatibility)
  nextDeliveryExpected DateTime?
  lastDeliveryDate     DateTime?

  // Expanded physical and program attributes
  totalLength                String? // e.g., "377 ft (115 m)"
  totalBeam                  String? // optional beam
  totalDisplacementSubmerged String? // e.g., "8,700 tons"
  totalManpowerNeeds         String? // e.g., "132 crew"
  totalTimeToBuild           String? // e.g., "66–84 months"
  totalEstimatedCostPerUnit  String? // e.g., "$3.2–3.8 billion"

  // Sensors and technology arrays
  sensors String[] @default([])

  // Industrial base / builders
  defenseBuilders String[] @default([])

  // All units (names only — not the CompanyPlatformUnit models)
  unitsInSeries String[] @default([])

  // When the platform class began (lead ship laid down)
  classStartDate DateTime?

  units      CompanyPlatformUnit[]
  statements CompanyPlatformStatement[]
  updates    CompanyPlatformUpdate[]

  @@index([name])
  @@index([platformSeries])
  @@index([category])
}

model CompanyPlatformUnit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformProductId String
  platformProduct   CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  // Identity & Ordinal Context
  hullNumber    String // "SSN 804"
  name          String? // "Barb"
  numberInClass Int? // ordinal position in class (replaces "block")
  platformClass String? // optional denormalized label (e.g., "Virginia-class")

  // Industrial / Build Context
  defenseContractor String? // e.g., "General Dynamics Electric Boat"
  shipyard          String? // HII Newport News, Electric Boat
  whereBuilt        String? // e.g., "Newport News, VA"
  unitCost          String? // free-text cost range for now

  // Lifecycle Dates (authoritative state, not events)
  constructionStartDate    DateTime?
  constructionCompleteDate DateTime?
  deliveryToFleetDate      DateTime?
  deliveryExpected         DateTime? // legacy field - kept for backward compatibility
  commissioningDate        DateTime?

  // Operational Context
  homeport        String?
  currentStatus   String? // keep loose (enum later)
  status          String? // legacy field - "Under Construction", "Keel Laid", "Sea Trials", etc.
  percentComplete Int?

  // System / Creation Metadata
  createdVia String? // "MANUAL" | "AI_INGEST"

  description String?

  // Raw signals & updates
  statements CompanyPlatformUnitStatement[]
  updates    CompanyPlatformUnitUpdate[]
  milestones CompanyMilestone[]

  // Stakeholders with meaning (not employees, not org chart)
  namesake     CompanyPlatformUnitNamesake?
  livingHomage CompanyPlatformUnitLivingHomage?

  @@index([platformProductId])
  @@index([hullNumber])
  @@index([name])
  @@index([numberInClass])
  @@index([platformClass])
  @@index([currentStatus])
}

// ============================================
// COMPANY PLATFORM STATEMENT MODEL
// ============================================
model CompanyPlatformStatement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platformProductId String
  platformProduct   CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  sourceName String? // "USNI News", "DoD Release", "GD CEO Earnings Call"
  sourceUrl  String?
  headline   String?
  rawText    String // Full pasted article/content

  aiSummary String? // GPT-generated summary
  aiTags    String[] @default([]) // e.g. ["schedule", "industrial base", "cost"]

  // Linking to updates we derive from this statement
  updates CompanyPlatformUpdate[]

  @@index([platformProductId])
  @@index([sourceName])
}

// ============================================
// COMPANY PLATFORM UPDATE MODEL
// ============================================
model CompanyPlatformUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformProductId String
  platformProduct   CompanyPlatformProduct @relation(fields: [platformProductId], references: [id], onDelete: Cascade)

  statementId String?
  statement   CompanyPlatformStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  // What changed or was reported
  scheduleStatus          String? // "Behind", "Ahead", "Critical Path Issue"
  costStatus              String? // "Cost Growth", "Stable", "Rebaseline"
  industrialBaseNote      String? // "Labor shortage", "supplier delays"
  leadershipQuote         String? // Parsed relevant quote
  percentCompleteEstimate Int? // If article says "60% complete" (program level)

  // Overwriteable fields for the platform record
  override_intendedTotalUnits      Int?
  override_programStatus           String?
  override_currentProgressEstimate Int?

  narrativeSummary String? // AI structured meaning
  tags             String[] @default([])

  @@index([platformProductId])
  @@index([statementId])
  @@index([scheduleStatus])
}

// ============================================
// COMPANY PLATFORM UNIT STATEMENT MODEL
// ============================================
model CompanyPlatformUnitStatement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platformUnitId String
  platformUnit   CompanyPlatformUnit @relation(fields: [platformUnitId], references: [id], onDelete: Cascade)

  sourceName String? // "USNI News", "HII Release"
  sourceUrl  String?
  headline   String?
  rawText    String // full text of the release or article

  aiSummary String?
  aiTags    String[] @default([])

  updates CompanyPlatformUnitUpdate[]

  @@index([platformUnitId])
}

// ============================================
// COMPANY PLATFORM UNIT UPDATE MODEL
// ============================================
model CompanyPlatformUnitUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformUnitId String
  platformUnit   CompanyPlatformUnit @relation(fields: [platformUnitId], references: [id], onDelete: Cascade)

  statementId String?
  statement   CompanyPlatformUnitStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  // Extracted signals
  percentComplete    Int?
  statusUpdate       String? // "Keel Laid", "Construction 60% complete"
  scheduleNote       String?
  industrialBaseNote String?
  leadershipQuote    String?

  // Dates that may be provided in an update
  keelLaidDate       DateTime?
  seaTrialsStartDate DateTime?
  deliveryDate       DateTime?
  commissioningDate  DateTime?

  // AI narrative summary
  narrativeSummary String?
  tags             String[] @default([])

  // Reverse relation to milestone (if this update triggered one)
  milestones CompanyMilestone[]

  @@index([platformUnitId])
  @@index([statementId])
  @@index([statusUpdate])
}


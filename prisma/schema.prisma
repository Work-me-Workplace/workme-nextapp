// ============================================
// HOLIDAY BUILDER SYSTEM MODELS
// ============================================
model Holiday {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assets Asset[]

  @@index([slug])
}

model Asset {
  id          String   @id @default(cuid())
  url         String
  fileName    String
  category    String // "holiday", "workforce", "shipyard", "general"
  holidaySlug String?
  createdAt   DateTime @default(now())

  holiday Holiday? @relation(fields: [holidaySlug], references: [slug], onDelete: SetNull)

  @@index([category])
  @@index([holidaySlug])
}

// ============================================
// WORKOPS MODELS (New Architecture)
// ============================================

enum WorkOpsItemType {
  task
  capture
  meeting
  signal
  fire
  boss_request
  tech_work
  admin
  workforce_comms
  external_pressure
  personal
}

enum WorkOpsUrgency {
  low
  medium
  high
  critical
}

enum WorkOpsStatus {
  open
  in_progress
  blocked
  done
}

enum WorkOpsSource {
  manual
  ai
  boss
  system
}

model WorkOpsOutlook {
  id        String   @id @default(cuid())
  workMeId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe           WorkMe                   @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  items            WorkOpsItem[]
  dailyAssignments WorkOpsDailyAssignment[]

  @@index([workMeId])
}

model WorkOpsItem {
  id        String   @id @default(cuid())
  outlookId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title String
  body  String?

  itemType WorkOpsItemType
  urgency  WorkOpsUrgency?
  status   WorkOpsStatus   @default(open)
  source   WorkOpsSource?

  priority   Int?
  dueDate    DateTime?
  assignedBy String?

  outlook          WorkOpsOutlook           @relation(fields: [outlookId], references: [id], onDelete: Cascade)
  dailyAssignments WorkOpsDailyAssignment[]

  @@index([outlookId])
  @@index([status])
  @@index([itemType])
}

model WorkOpsDailyAssignment {
  id        String   @id @default(cuid())
  outlookId String
  itemId    String
  day       DateTime // midnight key for the planned day
  dayIndex  Int? // user-controlled ordering for the day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlook WorkOpsOutlook @relation(fields: [outlookId], references: [id], onDelete: Cascade)
  item    WorkOpsItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, day]) // prevents duplicate assignment to same day
  @@index([outlookId])
  @@index([itemId])
  @@index([day])
}

// ============================================
// WORK GOAL MODEL (Goals Module)
// ============================================
model WorkGoal {
  id         String    @id @default(uuid())
  workMeId   String
  goal       String
  targetDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([targetDate])
}

// ============================================
// DEFENSE ECOSYSTEM INTELLIGENCE MODELS
// ============================================

// Platform: Core object for defense platforms (air, surface, subsurface, land, space systems)
model Platform {
  id           String   @id @default(cuid())
  name         String
  platformType String // air | surface | subsurface | land | space
  category     String // platform | weapon | sensor | comms | munition | c2
  isNextGen    Boolean  @default(false)
  status       String? // concept | development | testing | fielding | deployed | retired
  description  String?
  latestSignal String? // rolling summary (AI synthesized)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  capabilities       PlatformCapability[]
  communications     PlatformCommNode[]
  contractors        PlatformContract[]
  signals            PlatformSignal[]
  ecosystemCompanies EcosystemDefenseCompany[] @relation("EcosystemCompanyPlatforms")

  @@index([platformType])
  @@index([category])
}

// PlatformCapability: What platforms can do
model PlatformCapability {
  id         String   @id @default(cuid())
  platformId String
  capability String // e.g., stealth, long-range, A2AD-penetration, hypersonic-defense
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([capability])
}

// PlatformCommNode: Datalinks, SATCOM, sensors, C2 nodes, JADC2 integrations
model PlatformCommNode {
  id         String   @id @default(cuid())
  platformId String
  nodeType   String // datalink | satcom | radar | ew | c2 | sensor_fusion
  nodeName   String? // e.g., Link-16, TTNT, MADL, JADC2 node
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([nodeType])
}

// EcosystemDefenseCompany: Defense-industrial-base entities (Boeing, Lockheed, RTX, HII, L3Harris)
// This is NOT a BD CRM company
model EcosystemDefenseCompany {
  id          String  @id @default(cuid())
  name        String
  description String?
  website     String?
  hqCity      String?
  hqState     String?
  hqCountry   String?

  // Industry role (prime, sub, integrator, supplier)
  role String?

  // AI-enriched attributes (nullable)
  specialties    String[] @default([]) // e.g., stealth, propulsion, sensors
  marketTier     String? // major_prime | mid_tier | boutique
  influenceScore Int? // optional scoring placeholder

  // Relations
  platforms       Platform[]               @relation("EcosystemCompanyPlatforms")
  contracts       PlatformContract[]
  workMeFollowers WorkMeEcosystemCompany[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([role])
}

// PlatformContract: Links a platform to a defense company and indicates contract status
model PlatformContract {
  id            String   @id @default(cuid())
  platformId    String
  companyId     String
  prime         Boolean  @default(false)
  onContract    Boolean  @default(false)
  contractNotes String?
  createdAt     DateTime @default(now())

  platform Platform                @relation(fields: [platformId], references: [id], onDelete: Cascade)
  company  EcosystemDefenseCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([companyId])
}

// PlatformSignal: The beating heart of the system - every ingestion creates one of these
model PlatformSignal {
  id         String   @id @default(cuid())
  platformId String
  sourceUrl  String?
  sourceType String? // tweet | article | report | press_release | document
  signalType String // procurement | contract | capability | threat | testing | failure | policy_hint
  headline   String?
  rawSnippet String?
  aiSummary  String?
  confidence Float? // optional scoring
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([signalType])
  @@index([createdAt])
}

// WorkMeEcosystemCompany: Junction table for tracking who YOU care about
// Allows WorkMe users to "follow" or "track" ecosystem companies
model WorkMeEcosystemCompany {
  id        String   @id @default(cuid())
  workMeId  String
  companyId String
  createdAt DateTime @default(now())

  workMe  WorkMe                  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company EcosystemDefenseCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workMeId, companyId])
  @@index([workMeId])
  @@index([companyId])
}

// EcosystemPerson: Your "ecosystemdude" — the actual human
// Minimal, inference-friendly, no overbuilding
model EcosystemPerson {
  id        String  @id @default(cuid())
  fullName  String
  xHandle   String? @unique
  xUserId   String? @unique // Twitter/X user ID
  title     String?
  seniority String?
  domain    String? // what space they play in (naval aviation, acquisition, AI, etc.)
  beat      String? // optional: reporters / analysts

  companyName String? // inference only — NOT RELATION
  companyId   String? // FK to EcosystemCompany for org linking
  yearsAt     Int? // inference
  influence   Int? // inference

  // X/Twitter profile data
  profileImage String?
  bio          String?
  followers    Int?

  // Intelligence fields (GPT-inferred)
  topics              String[] @default([]) // e.g., ["FA-XX", "procurement", "carriers"]
  affinityIndustry    String? // e.g., "Defense"
  affinityToMyOrg     String? // e.g., "High", "Medium", "Low"
  latestSignalSummary String? // AI-created summary of latest signals

  updatedSummary String? // dynamic AI-created summary of who they are to you
  lastHydratedAt DateTime? // when we last fetched fresh data from X

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  workMeContacts MyEcosystemContact[]
  company        EcosystemCompany?    @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([xHandle])
  @@index([xUserId])
  @@index([domain])
  @@index([companyId])
}

// EcosystemCompany: Simple org model used ONLY for inference + enrichment
// This is NOT a CRM, minimal identity
model EcosystemCompany {
  id      String  @id @default(cuid())
  name    String
  domain  String? @unique
  type    String? // media | contractor | gov | OEM | think-tank
  summary String? // AI curated description

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  people EcosystemPerson[] // people linked to this company

  @@index([name])
  @@index([type])
}

// MyEcosystemContact: Your CRM container — the only junction table you need
model MyEcosystemContact {
  id       String @id @default(cuid())
  workMeId String
  personId String

  notes String?
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe          @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  person EcosystemPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([workMeId, personId])
  @@index([workMeId])
  @@index([personId])
}

// ============================================
// COMPANY PRODUCTS MODELS
// ============================================

model CompanyProduct {
  id        String   @id @default(cuid())
  workMeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core Identity
  name        String
  category    String? // e.g., "Surface Ship", "Digital Service"
  description String?

  // Public Specs (comms-visible)
  missionRole      String?
  keyCapabilities  String[] @default([])
  limitations      String[] @default([])
  publicSources    Json? // GAO/CRS/public summaries
  productionStatus String?

  // Narrative + Messaging
  leadershipFraming String?
  talkingPoints     Json? // structured messaging blocks

  // Relations
  highlights ProductHighlight[]
  pressures  ProductPressure[]
  updates    ProductUpdate[]

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([category])
}

model ProductPressure {
  id        String   @id @default(cuid())
  productId String
  source    String // "GAO", "CRS", "Congress", etc.
  summary   String
  riskLevel String? // low | medium | high
  createdAt DateTime @default(now())

  product CompanyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductHighlight {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String?
  createdAt   DateTime @default(now())

  product CompanyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductUpdate {
  id         String   @id @default(cuid())
  productId  String
  updateText String
  createdAt  DateTime @default(now())

  product CompanyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================
// EXTERNAL COMPANY PRESSURE MODEL
// ============================================

model ExternalCompanyPressure {
  id        String   @id @default(cuid())
  workMeId  String
  source    String // "GAO", "Congress", "Industry", etc.
  category  String? // "Budget", "Legislation", "Testing", "Ops", etc.
  summary   String
  impact    String? // optional "why this matters"
  createdAt DateTime @default(now())

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([category])
}

// ============================================
// WORKENGAGE MODELS (Engagement Messaging)
// ============================================

model EngageTemplate {
  id        String   @id @default(cuid())
  name      String // "Promotion Congrats", "Team Win", etc.
  body      String // template text
  createdAt DateTime @default(now())

  messages EngageMessage[]

  @@index([name])
}

model EngageMessage {
  id          String   @id @default(cuid())
  ownerId     String
  templateId  String?
  highlightId String? // link to CompanyEmployeeHighlight
  message     String
  createdAt   DateTime @default(now())

  owner     WorkMe                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template  EngageTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  highlight CompanyEmployeeHighlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([templateId])
  @@index([highlightId])
  @@index([createdAt])
}

generator client {
  provider = "prisma-client-js"
}

// Switch to PostgreSQL for production/RDS. Set `DATABASE_URL` in environment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkMe {
  id          String   @id @default(uuid())
  firebaseId  String?  @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  photoUrl    String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  workLocation String?
  city        String?
  state       String?

  jobTitle    String?
  specialty   String?
  industry    String?
  jobRole     JobRole?
  annualSalary String?
  salaryRange SalaryRange?
  createdAt   DateTime @default(now())
  connections Connection[]
  events      Event[]
  milestones  Milestone[]
}

enum JobRole {
  INDIVIDUAL_CONTRIBUTOR
  MANAGER
  DIRECTOR_LEVEL
  PROJECT_LEAD
}

enum SalaryRange {
  BELOW_50K
  K50_100K
  K100_150K
  K150_200K
  ABOVE_200K
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  industry  String?
  website   String?
  city      String?
  state     String?
  description String?
  headcount  Int?
  companyType CompanyType?
  revenueRange RevenueRange?
  createdAt DateTime @default(now())

  employees WorkMe[]
}

enum CompanyType {
  NON_PROFIT
  FOR_PROFIT
  PUBLICLY_TRADED
  GOVERNMENT
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

model Connection {
  id          String   @id @default(uuid())
  name        String
  email       String?
  company     String?
  jobTitle    String?
  linkedinUrl String?
  notes       String?
  tags        String[] // e.g., ["mentor", "industry", "alumni"]
  workMeId    String
  workMe      WorkMe   @relation(fields: [workMeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   EventType
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isVirtual   Boolean  @default(false)
  url         String?  // For virtual events
  workMeId    String
  workMe      WorkMe   @relation(fields: [workMeId], references: [id])
  createdAt   DateTime @default(now())
}

enum EventType {
  NETWORKING
  CONFERENCE
  WORKSHOP
  MEETUP
  WEBINAR
  INTERVIEW
  COFFEE_CHAT
  OTHER
}

model Milestone {
  id          String   @id @default(uuid())
  title       String
  description String?
  milestoneType MilestoneType
  date        DateTime @default(now())
  workMeId    String
  workMe      WorkMe   @relation(fields: [workMeId], references: [id])
  createdAt   DateTime @default(now())
}

enum MilestoneType {
  PROMOTION
  NEW_ROLE
  CERTIFICATION
  SKILL_ACQUIRED
  PROJECT_COMPLETED
  AWARD
  PUBLICATION
  SPEAKING_ENGAGEMENT
  OTHER
}

enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "email", "flyer", "digest", etc.
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
}

model Objective {
  id          String   @id @default(cuid())
  userId      String

  title       String
  description String?
  howMeasured String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
}

model CompanyCampaign {
  id          String   @id @default(cuid())
  userId      String

  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  achievements Achievement[]
}

model Achievement {
  id                   String   @id @default(cuid())
  userId               String

  title                String
  category             AchievementCategory

  audienceName         String?
  audienceSize         Int?

  objectiveId          String?
  objective            Objective? @relation(fields: [objectiveId], references: [id])

  commsOutputId        String?
  commsOutput          CommsOutput? @relation(fields: [commsOutputId], references: [id])

  companyCampaignId    String?
  companyCampaign      CompanyCampaign? @relation(fields: [companyCampaignId], references: [id])

  whatYouDid           String
  frequency            String?   // weekly, recurring, one-time
  volume               Int?

  processSteps         Json?     // array of steps
  impact               String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============================================
// WORKME COMPANY MODEL (Container/Tenant)
// ============================================
model WorkMeCompany {
  id          String   @id @default(uuid())
  name        String // WorkMe platform name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees WorkMe[]
  // NO companies relation - Company is independent

  @@map("workme_company")
}

// ============================================
// COMPANY MODEL (Independent Entity)
// ============================================
model Company {
  id           String        @id @default(uuid())
  name         String        @unique // Company name (unique globally)
  industry     String?
  website      String?
  city         String?
  state        String?
  description  String?
  headcount    Int?
  companyType  CompanyType?
  revenueRange RevenueRange?
  createdAt    DateTime      @default(now())

  // Identity (Apollo Enrichment)
  missionStatement    String?
  vision              String?
  values              String? // CSV string
  brandTagline        String?
  brandLogoUrl        String?
  brandColorPrimary   String?
  brandColorSecondary String?

  // Leadership (Apollo Enrichment)
  ceoName      String?
  ceoTitle     String?
  deputyName   String?
  deputyTitle  String?
  chiefOfStaff String?

  // Organization (Apollo Enrichment)
  directorates String[] @default([]) // e.g. ["SEA 02", "SEA 05", "SEA 10"]

  // Social / Public (Apollo Enrichment)
  linkedinUrl String?
  twitterUrl  String?
  facebookUrl String?
  phone       String?

  // Address (Apollo Enrichment)
  country String?

  // Relations
  members      WorkMe[] // Direct relation to WorkMe (Company HQ affiliation)
  companyUnits CompanyUnit[] // CompanyUnits that belong to this HQ
  workplaces   Workplace[] // Workplace relations
  employees    CompanyEmployee[] // Organizational employees

  @@index([name]) // Index for directory lookups
}

// ============================================
// COMPANY UNIT REGISTRY (Searchable Registry Pattern)
// ============================================
// Registry pattern like RaceRegistry - search or create
// Simple, searchable company unit registry
model CompanyUnit {
  id        String   @id @default(uuid())
  name      String   @unique // Company name (unique globally)
  companyId String? // Foreign key to Company (Company HQ) - optional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  divisions   DivisionUnit[]
  unitMembers CompanyUnitMembers[] // Members with roles (canonical membership)
  employees   CompanyEmployee[] // Organizational employees
  workMeMembers WorkMe[] @relation("WorkMeCompanyUnit") // WorkMe users with this company unit

  @@index([name])
  @@index([companyId])
}

// ============================================
// DIVISION UNIT REGISTRY (Final Form)
// ============================================
// Parent → CompanyUnit, reusable, unique on (name + companyUnitId)
model DivisionUnit {
  id            String   @id @default(uuid())
  name          String
  companyUnitId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   CompanyUnit       @relation(fields: [companyUnitId], references: [id], onDelete: Cascade)
  employees CompanyEmployee[] // Organizational employees
  workMeMembers WorkMe[] @relation("WorkMeDivision") // WorkMe users with this division

  @@unique([name, companyUnitId])
  @@index([companyUnitId])
}

// ============================================
// COMPANY UNIT MEMBERS (Junction table with roles)
// ============================================
// Links WorkMe to CompanyUnit with role (MEMBER, MANAGER, ADMIN)
model CompanyUnitMembers {
  id            String          @id @default(uuid())
  workMeId      String
  companyUnitId String // References CompanyUnit.id
  role          CompanyUnitRole @default(MEMBER)
  createdAt     DateTime        @default(now())

  workMe WorkMe      @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  unit   CompanyUnit @relation(fields: [companyUnitId], references: [id], onDelete: Cascade)

  @@unique([workMeId, companyUnitId])
  @@index([workMeId])
  @@index([companyUnitId])
  @@index([role])
}

// ============================================
// WORK ENTRY MODEL (Work History - LinkedIn-style Experience Items)
// ============================================
// Work history - each WorkMe can have multiple WorkEntries (current + past jobs)
model WorkEntry {
  id          String    @id @default(uuid())
  workMeId    String
  companyName String?
  title       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
  @@index([startDate])
  @@index([endDate])
}

// ============================================
// WORK SKILLS MODEL (Human Capital Layer)
// ============================================
// Standalone intelligence module attached directly to WorkMe
model WorkSkills {
  id             String  @id @default(uuid())
  workMeId       String  @unique
  skillsRaw      String?
  strengthsRaw   String?
  specialties    String?
  certifications String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe WorkMe @relation(fields: [workMeId], references: [id], onDelete: Cascade)

  @@index([workMeId])
}

// ============================================
// COMPANY UNIT REGISTRY (Legacy - Deprecated)
// ============================================
// DEPRECATED: Use CompanyUnit model above instead
// Keeping for backward compatibility during migration
model CompanyUnitRegistry {
  id         String   @id @default(cuid())
  name       String   @unique // Unique workspace name (user-defined or generated)
  visibility String   @default("public") // "public" or "private"
  createdAt  DateTime @default(now())

  @@index([name])
  @@index([visibility])
}

// Workplace: Link between a user (WORKMEID) and a specific company
model Workplace {
  id        String   @id @default(cuid())
  workMeId  String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workMe  WorkMe  @relation(fields: [workMeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Note: roles relation removed - CompanyRole model deleted

  @@unique([workMeId, companyId]) // One workplace per user-company pair
  @@index([workMeId])
  @@index([companyId])
}

enum CompanyType {
  NON_PROFIT
  GOVERNMENT
  PRIVATELY_HELD_FIRM
  SMALL_BUSINESS
  STARTUP
  PUBLICLY_TRADED
}

enum RevenueRange {
  UNDER_10M
  M10_50
  M50_200
  M200_1000
  ABOVE_1000M
}

// ============================================
// ACHIEVEMENTS MODULE MODELS
// ============================================
enum AchievementCategory {
  INTERNAL_COMMS
  WORKFORCE_COMMS
  EVENT_SUPPORT
  EXECUTIVE_LEADERSHIP
  OPERATIONS_SUPPORT
  READINESS
  ADMIN
  COMMUNITY_ENGAGEMENT
}

model CommsOutput {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String
  originator   WorkMe  @relation("CommsOutputOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  type        String // "email", "flyer", "digest", etc.
  title       String
  description String?
  wordCount   Int?
  dateSent    DateTime?
  topics      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Objective {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String
  originator   WorkMe  @relation("ObjectiveOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title       String
  description String?
  howMeasured String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements Achievement[]

  @@index([companyUnit])
  @@index([originatorId])
}

model Achievement {
  id String @id @default(cuid())

  companyUnit  String?
  originatorId String
  originator   WorkMe  @relation("AchievementOriginator", fields: [originatorId], references: [id], onDelete: Cascade)

  title    String
  category AchievementCategory

  audienceName String?
  audienceSize Int?

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  commsOutputId String?
  commsOutput   CommsOutput? @relation(fields: [commsOutputId], references: [id], onDelete: SetNull)

  whatYouDid String
  frequency  String? // weekly, recurring, one-time
  volume     Int?

  processSteps Json? // array of steps
  impact       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyUnit])
  @@index([originatorId])
  @@index([category])
}

// ============================================
// WORK ARCHITECTURE MODELS
// ============================================

// ============================================
// COMPANY MODELS (Renamed from WorkContext*)
// ============================================
// NOTE: ContextType is now a TypeScript type in lib/types/context-type.ts
// It's no longer a Prisma enum since WorkEventRouter was removed

model CompanyCampaign {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  windowStart  DateTime?
  windowEnd    DateTime?
  ctaLink      String?
  sponsor      String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyCampaignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyImpactEvent {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  title              String
  description        String?
  effectiveDate      DateTime?
  impactedPopulation String?
  urgency            String?
  pocFirstName       String?
  pocLastName        String?
  pocEmail           String?
  pocPhone           String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyImpactEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyTraining {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Core
  title            String?
  topic            String?
  description      String?
  mandatory        Boolean @default(false)
  sponsoringOffice String?

  // Date / Time
  trainingDate DateTime?
  startTime    String?
  endTime      String?

  // Format / Location
  location String?
  format   String?
  link     String?

  // POC
  pocFirstName   String?
  pocLastName    String?
  pocEmail       String?
  pocPhone       String?
  pocRankOrTitle String?

  // Stage 1 Ingest Snapshot
  ingestRawText   String?
  ingestType      String?
  ingestStatus    String?   @default("pending")
  ingestCreatedAt DateTime? @default(now())

  summary String?

  // Relations
  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyTrainingCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core identity
  title       String
  theme       String? // NEW (tagline / theme)
  description String?

  // Timing
  eventDate DateTime?
  startTime String?
  endTime   String?

  // Category (enum)
  eventCategory EventCategory?

  // Registration
  registrationRequired String?
  registrationLink     String?

  // Highlights extracted from GPT
  audience      EventAudience?
  vibe          String?
  perks         String[]       @default([])
  participation String[]       @default([])

  // Food
  foodProvided String?
  foodTypes    String?

  // Speaker + POC
  speakers String[] @default([])
  pocEmail String?
  pocPhone String?

  summary String? // Stage 3 synthesized paragraph

  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyEventCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // Relations
  eventItems EventItem[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model EventItem {
  id      String       @id @default(cuid())
  eventId String
  event   CompanyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model CompanyCommunity {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  title        String
  description  String?
  partnerOrg   String?
  date         DateTime?
  location     String?
  signUpLink   String?
  pocFirstName String?
  pocLastName  String?
  pocEmail     String?
  pocPhone     String?

  summary String?

  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyCommunityCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyBenefits {
  // -----------------------
  // IDENTITY
  // -----------------------
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -----------------------
  // CORE CONTENT
  // -----------------------
  title                  String
  description            String? // 1–2 sentence plain explainer
  employeeBenefitSummary String? // why employees should care

  // -----------------------
  // UNIVERSAL BENEFIT STRUCTURE
  // -----------------------
  windowStart DateTime? // enrollment or action window start
  windowEnd   DateTime? // enrollment or action window end

  deadlines Json? // { enrollBy, mailInDeadline, systemClose, etc. }

  actionLink String? // GRB / TSP.gov / OPM / portal / signup
  resources  Json? // { brochures: [...], guides: [...], instructions: [...] }

  pocList           Json? // [{ name, email, phone }]
  extraInstructions Json? // ["Review FEHB options", "Log into GRB", ...]

  // -----------------------
  // AI SYNTHESIS (Stage 3)
  // -----------------------
  summary String? // NTK synthesized paragraph

  // -----------------------
  // RAW INGESTION (Stage 1)
  // -----------------------
  ingestRawText String?

  // -----------------------
  // RELATIONS
  // -----------------------
  companyUnit String?

  @@index([companyUnit])
}

enum CareerLevel {
  NAVSEA
  NAVY
  DOD
}

enum CareerType {
  Leadership
  Fellowship
  Other
}

model CompanyCareer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  title       String
  description String?

  // Classification enums
  level CareerLevel? // NAVSEA | NAVY | DOD
  type  CareerType? // Leadership | Fellowship | Other

  // Eligibility JSON
  eligibility Json? // {
  //   paygradeRange: { min: string | null, max: string | null },
  //   timeInServiceMonths?: number | null,
  //   timeInPositionMonths?: number | null,
  //   who?: string | null
  // }

  // Application JSON
  application Json? // { instructions: string | null, link?: string | null }

  // Optional extras
  extras Json? // { cost?: string | null, notes?: string[] | null }

  // Raw ingest text (no workflow status)
  ingestRawText String?

  summary String?

  // Relations
  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("CompanyCareerCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([createdByWorkMeId])
}

model CompanyEmployeeCause {
  // -----------------------
  // IDENTITY
  // -----------------------
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -----------------------
  // CORE CONTENT
  // -----------------------
  title         String
  description   String? // 1–2 sentence "what is this thing?"
  impactSummary String? // 1 sentence "why this matters / who it helps"

  // -----------------------
  // STRUCTURED FIELDS
  // -----------------------
  partnerOrg           String?
  sponsoringDepartment String?

  windowStart DateTime?
  windowEnd   DateTime?
  deadlines   Json? // { mailed, dropoff, delivery }

  locations String[] @default([]) // drop-off or event locations
  link      String?

  pocList           Json? // [{ name, email, phone }]
  extraInstructions Json? // ["avoid toy weapons", ...]

  // -----------------------
  // AI SYNTHESIS (Stage 3)
  // -----------------------
  summary String?

  // -----------------------
  // RAW INGESTION (Stage 1)
  // -----------------------
  ingestRawText String?

  // -----------------------
  // RELATIONS
  // -----------------------
  companyUnit String?

  @@index([companyUnit])
}

// ====================================================
// COMPANY EMPLOYEE
// ====================================================
model CompanyEmployee {
  id       String  @id @default(cuid())
  fullName String
  title    String?
  email    String?
  phone    String?
  photoUrl String?

  companyId     String?
  companyUnitId String?
  divisionId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Junctions
  highlights CompanyEmployeeHighlightLink[]

  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyUnit CompanyUnit?  @relation(fields: [companyUnitId], references: [id], onDelete: SetNull)
  division    DivisionUnit? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([companyUnitId])
  @@index([divisionId])
  @@index([fullName])
  @@index([email])
}

// ====================================================
// HIGHLIGHT (Award, Citation, Spotlight)
// ====================================================
model CompanyEmployeeHighlight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core content
  citationText   String
  achievement    String?
  narrative      String?
  classification String?

  // Award metadata
  awardName      String?
  awardingAgency String?
  awardYear      Int?

  supervisorQuote String?
  photoUrl        String?

  // Who created the highlight
  createdByWorkMeId String
  createdBy         WorkMe @relation("CompanyEmployeeHighlightCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // Junctions
  employees      CompanyEmployeeHighlightLink[]
  units          CompanyEmployeeHighlightUnit[]
  engageMessages EngageMessage[]

  @@index([createdByWorkMeId])
}

// ====================================================
// JUNCTION: highlight ↔ person
// ====================================================
model CompanyEmployeeHighlightLink {
  id          String @id @default(cuid())
  employeeId  String
  highlightId String

  createdAt DateTime @default(now())

  employee  CompanyEmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  highlight CompanyEmployeeHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@unique([employeeId, highlightId])
  @@index([employeeId])
  @@index([highlightId])
}

// ====================================================
// JUNCTION: highlight ↔ company unit (tenantization)
// ====================================================
model CompanyEmployeeHighlightUnit {
  id          String @id @default(cuid())
  highlightId String
  companyUnit String // SEA05, SEA08, NAVSEA HQ, etc.

  createdAt DateTime @default(now())

  highlight CompanyEmployeeHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([companyUnit])
  @@index([highlightId])
}

// ============================================
// WORKFORCE ENDURING PRODUCTS (Clean Architecture)
// ============================================

// Email Digest Enduring Product
model WorkForceEnduringProdEmailDigest {
  id                String   @id @default(uuid())
  title             String
  description       String?
  companyUnit       String
  createdByWorkMeId String
  createdAt         DateTime @default(now())

  createdBy WorkMe               @relation("EmailDigestProductCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)
  editions  EmailDigestEdition[]

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([createdAt])
}

// Email Digest Edition
model EmailDigestEdition {
  id            String                           @id @default(uuid())
  emailDigestId String
  product       WorkForceEnduringProdEmailDigest @relation(fields: [emailDigestId], references: [id], onDelete: Cascade)

  contentJson  Json
  generatedAt  DateTime @default(now())
  originatorId String
  companyUnit  String

  @@index([emailDigestId])
  @@index([companyUnit])
  @@index([generatedAt])
}

// ============================================
// DIGITAL SIGNAGE PRODUCT MODELS
// ============================================

// Master container model
model ProductDigitalSign {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signType DigitalSignType

  companyUnit       String?
  createdByWorkMeId String
  createdBy         WorkMe  @relation("ProductDigitalSignCreator", fields: [createdByWorkMeId], references: [id], onDelete: Cascade)

  // 1:1 subtype relations
  workforce            ProductDigitalSignWorkforce?
  companyNews          ProductDigitalSignCompanyNews?
  workforceAchievement ProductDigitalSignWorkforceAchievement?
  companyEvent         ProductDigitalSignCompanyEvent?

  @@index([companyUnit])
  @@index([createdByWorkMeId])
  @@index([signType])
}

// A. Workforce signage
model ProductDigitalSignWorkforce {
  id        String @id @default(cuid())
  signageId String @unique

  title      String
  summary    String?
  bullets    String[] @default([])
  imageUrl   String?
  icon       String?
  background String?
  footerNote String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

// B. Company News signage
model ProductDigitalSignCompanyNews {
  id        String @id @default(cuid())
  signageId String @unique

  headline    String
  subheadline String?
  body        String?
  link        String?
  thumbnail   String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

// C. Workforce Achievement signage
model ProductDigitalSignWorkforceAchievement {
  id        String @id @default(cuid())
  signageId String @unique

  personName  String
  unit        String?
  achievement String
  details     String?
  photoUrl    String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}

// D. Company Event signage
model ProductDigitalSignCompanyEvent {
  id        String @id @default(cuid())
  signageId String @unique

  eventName        String
  eventDate        DateTime?
  startTime        String?
  endTime          String?
  location         String?
  description      String?
  perks            String[]  @default([])
  registrationLink String?

  signage ProductDigitalSign @relation(fields: [signageId], references: [id], onDelete: Cascade)
}


# ============================================
# Work.me Next.js Application
# Environment Variables Configuration
# ============================================
# This file is gitignored - never commit secrets
# Copy this template and fill in your values

# ============================================
# DATABASE (Required)
# ============================================
# Prisma PostgreSQL connection string

# ============================================
# FIREBASE (Required)
# ============================================
# Firebase Service Account Key (Server-side)
# Get from: Firebase Console -> Project Settings -> Service Accounts
# Format: JSON string (escape quotes or use single-line JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Client SDK (Client-side)
# Get from: Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# UPSTASH REDIS (Required for Workforce Stuff Ingestion)
# ============================================
# REST API URL and Token from Upstash Console
# Get from: https://console.upstash.com/redis -> Your Database -> REST API
UPSTASH_REDIS_REST_URL=https://easy-wolf-36582.upstash.io
UPSTASH_REDIS_REST_TOKEN=AY7mAAIncDJmYjg1MGM2ZmFiMGE0NGE4YWQxYzUxZGJjY2Q5NzA5ZnAyMzY1ODI

# ============================================
# OPENAI (Required for AI Features)
# ============================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# Node environment
NODE_ENV=development
